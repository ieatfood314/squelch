                         daemon=True).start()

    def _suggest_worker(self, term):
        try:
            self.suggested.emit(term, fetch_mishearings(term))
        except Exception as e:
            self.suggest_failed.emit(str(e)[:160])

    def _apply_suggestions(self, term, suggs):
        self.suggest_btn.setEnabled(True)
        added = []

        def change(entries):
            e = find_entry(entries, term)
            if e is None:
                return
            have = {h.lower() for h in e["also_match"]}
            for s in suggs:
                if s.lower() not in have and s.lower() != term.lower():
                    e["also_match"].append(s)
                    have.add(s.lower())
                    added.append(s)

        self.show_dict(update_dict(change), self.selected_term())
        self.or_status.setText(f"Added {len(added)}" if added
                               else "Nothing new")

