        row = self.learned_list.currentRow()
        if not 0 <= row < len(self.learned_pairs):
            return
        term, heard = self.learned_pairs[row]
        resolve_mishearing(term, heard, accept)
        self.show_dict(load_dict(), self.selected_term())
        self.or_status.setText(f"“{heard}” now becomes {term}" if accept
                               else f"Ignored “{heard}”")

    def load_dict(self):
        self.show_dict(load_dict(), self.selected_term())

    def dict_add(self):
        term = self.add_field.text().strip()
        if not term:
            return
        added = []

        def change(entries):
            if find_entry(entries, term) is None:
                entries.append({"term": term, "also_match": []})
                added.append(term)

        self.show_dict(update_dict(change), term)
        self.add_field.clear()
        self.add_field.setFocus()
        self.or_status.setText(f"Added “{term}”" if added
                               else "Already in dictionary")

    def dict_select(self, row):
        if 0 <= row < len(self.dict_entries):
            self.heard_field.setText(
                ", ".join(self.dict_entries[row]["also_match"]))
        else:
            self.heard_field.clear()

    def heard_save(self):
        term = self.selected_term()
        if term is None:
            return
        heard = [h.strip() for h in self.heard_field.text().split(",")
                 if h.strip()]

        def change(entries):
            e = find_entry(entries, term)
            if e is not None:
                e["also_match"] = heard

        self.show_dict(update_dict(change), term)

    def dict_remove(self):
        term = self.selected_term()
        if term is None:
            return

        def change(entries):
            e = find_entry(entries, term)
            if e is not None:
                entries.remove(e)

        self.show_dict(update_dict(change))
        self.or_status.setText(f"Removed “{term}”")

    def open_key_dialog(self):
        dlg = QDialog(self)
        dlg.setWindowTitle("OpenRouter key")
        dlg.setStyleSheet(f"QDialog {{ background: {POPOVER}; }}")
        lay = QVBoxLayout(dlg)
        lay.setContentsMargins(16, 16, 16, 16)
        lay.addWidget(label("Used by Suggest. Saved owner-only.", "dim"))
        field = QLineEdit()
        field.setEchoMode(QLineEdit.EchoMode.Password)
        field.setPlaceholderText("Key set" if openrouter_key()
                                 else "Paste key")
        lay.addWidget(field)
        st = label("", "dim")
        lay.addWidget(st)
        row = QHBoxLayout()
        row.addStretch(1)
        set_btn = QPushButton("Set")
        clear_btn = QPushButton("Clear")
        close_btn = QPushButton("Close")
        for b in (set_btn, clear_btn, close_btn):
            row.addWidget(b)
        lay.addLayout(row)

        def forget_model():
            try:
                os.unlink(OPENROUTER_MODEL_FILE)
            except OSError:
                pass

        def do_set():
            k = field.text().strip()
            if not k:
                return
            os.makedirs(CONFIG_DIR, exist_ok=True)
            fd = os.open(OPENROUTER_KEY_FILE,
                         os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as f:
                f.write(k + "\n")
            os.chmod(OPENROUTER_KEY_FILE, 0o600)
            forget_model()
            field.clear()
            field.setPlaceholderText("Key set")
            st.setText("Saved")

        def do_clear():
            try:
                os.unlink(OPENROUTER_KEY_FILE)
                st.setText("Removed")
            except OSError:
                st.setText("No key set")
            forget_model()
            field.setPlaceholderText("Paste key")

        set_btn.clicked.connect(do_set)
        clear_btn.clicked.connect(do_clear)
        close_btn.clicked.connect(dlg.accept)

        def click_off():
            dlg.reject()
            self.close()

        CloseOnClickOff(dlg, click_off)
        dlg.exec()
        self.refresh_or_status()

    def refresh_or_status(self):
        self.or_status.setText("" if openrouter_key()
                               else "No OpenRouter key: Suggest is off")

    def suggest(self):
        """Suggest mishearings for the selected word (one OpenRouter call)."""
        term = self.selected_term()
        if term is None:
            self.or_status.setText("Select a word first")
            return
        self.suggest_btn.setEnabled(False)
        self.or_status.setText(f"Asking what “{term}” sounds like…")
        threading.Thread(target=self._suggest_worker, args=(term,),
                         daemon=True).start()

    def _suggest_worker(self, term):
        try:
            self.suggested.emit(term, fetch_mishearings(term))
        except Exception as e:
            self.suggest_failed.emit(str(e)[:160])

    def _apply_suggestions(self, term, suggs):
        self.suggest_btn.setEnabled(True)
        added = []

        def change(entries):
            e = find_entry(entries, term)
            if e is None:
                return
            have = {h.lower() for h in e["also_match"]}
            for s in suggs:
                if s.lower() not in have and s.lower() != term.lower():
                    e["also_match"].append(s)
                    have.add(s.lower())
                    added.append(s)

        self.show_dict(update_dict(change), self.selected_term())
        self.or_status.setText(f"Added {len(added)}" if added
                               else "Nothing new")

    def _suggest_error(self, msg):
        self.suggest_btn.setEnabled(True)
        self.or_status.setText(f"OpenRouter error: {msg}")

    # ---- analytics tab ----
