# ---------------- config files ----------------

def atomic_write(path, text):
    """Write via a temp file + rename, so readers never see half a file."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.tmp-{os.getpid()}"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def read_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def read_engine():
    try:
        with open(ENGINE_FILE) as f:
            e = f.read().strip().lower()
        return "whisper" if e == "whisper" else "parakeet"
    except OSError:
        return "parakeet"


def write_engine(e):
    atomic_write(ENGINE_FILE, e + "\n")


def service_states(units):
    """{unit: (active, enabled)} from one systemctl call."""
    out = {u: (False, False) for u in units}
    try:
        r = subprocess.run(
            ["systemctl", "--user", "show", "-p", "Id", "-p", "ActiveState",
             "-p", "UnitFileState", *units],
            capture_output=True, text=True, timeout=10)
    except Exception:
        return out
    for block in r.stdout.strip().split("\n\n"):
        props = dict(line.split("=", 1) for line in block.splitlines()
                     if "=" in line)
        if props.get("Id") in out:
            out[props["Id"]] = (props.get("ActiveState") == "active",
                                props.get("UnitFileState") == "enabled")
    return out


def engine_status():
    """One short status line for the selected engine."""
    st = read_json(STATE_FILE, {})
    if not isinstance(st, dict):
        st = {}
    if st.get("gaming"):
        return "Paused for game"
    if st.get("model_ok") is False:
        return "Model missing"
    engine = read_engine()
    try:
        urllib.request.urlopen(
            f"http://127.0.0.1:{ENGINE_PORTS[engine]}/", timeout=1)
        return "Ready"
    except urllib.error.HTTPError:
        return "Ready"  # answering, just not on /
    except Exception:
        pass
    svc = ENGINE_SERVICES[engine]
    return "Loading" if service_states([svc])[svc][0] else "Stopped"


