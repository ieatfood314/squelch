            self.timer.start()

    def refresh(self):
        s = summarize_stats(load_stats())
        self.tiles["words"].setText(f"{s['words']:,}")
        self.tiles["wpm"].setText(f"{s['wpm']:.0f}")
        self.tiles["lat"].setText(f"{s['avg_lat']:.2f} s")
        self.tiles["utts"].setText(f"{s['utterances']:,}")
        utt_word = "utterance" if s['recent_n'] == 1 else "utterances"
        self.recent.setText(
            f"Last {s['recent_min']} min: {s['recent_wpm']:.0f} WPM across "
            f"{s['recent_words']:,} words ({s['recent_n']} {utt_word})"
            f"  ·  transcription avg (last 10): {s['recent_lat']:.2f} s")
        self.table.setRowCount(0)
        for d, w, u, a in s["days"]:
            r = self.table.rowCount()
            self.table.insertRow(r)
            self.table.setItem(r, 0, QTableWidgetItem(d))
            self.table.setItem(r, 1, QTableWidgetItem(f"{w:,}"))
            self.table.setItem(r, 2, QTableWidgetItem(f"{u:,}"))
            self.table.setItem(r, 3, QTableWidgetItem(f"{a:.1f}"))

    def keyPressEvent(self, event):
        if event.key() == Qt.Key.Key_Escape:
            self.close()
        else:
            super().keyPressEvent(event)


class MenuKeyWatcher:
    """Passive listener on kanata's output device: a Menu tap (F23) pops the
    STT menu at the cursor. No grabs — dictation daemon reads alongside."""

    def __init__(self, on_tap):
        self.on_tap = on_tap
        self.dev = None
        self.notifier = None
        self.timer = QTimer()
        self.timer.setInterval(2000)
        self.timer.timeout.connect(self.discover)
        self.discover()

    def find_device(self):
        import glob as _glob
        for path in sorted(_glob.glob("/dev/input/event*")):
            try:
                d = evdev.InputDevice(path)
            except OSError:
                continue
            if "kanata" not in d.name.lower():
                continue
            try:
                if F23 in d.capabilities().get(evdev.ecodes.EV_KEY, []):
                    return d
            except OSError:
                continue
        return None

    def discover(self):
        if self.dev is not None:
            return
        d = self.find_device()
        if d is None:
            if not self.timer.isActive():
                self.timer.start()
            return
        self.timer.stop()
        self.dev = d
        self.notifier = QSocketNotifier(
            d.fd, QSocketNotifier.Type.Read)
        self.notifier.activated.connect(self.on_activity)

    def on_activity(self):
        try:
            for ev in self.dev.read():
                if (ev.type == evdev.ecodes.EV_KEY and ev.code == F23
                        and ev.value == 1):
                    self.on_tap()
        except OSError:
            self.teardown()
            self.timer.start()

    def teardown(self):
        if self.notifier is not None:
            self.notifier.setEnabled(False)
            self.notifier = None
        self.dev = None


def fallback_icon():
    pm = QPixmap(64, 64)
    pm.fill(QColor(0, 0, 0, 0))
    p = QPainter(pm)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    p.setBrush(QColor(0x35, 0x84, 0xe4))
    p.setPen(QColor(0, 0, 0, 0))
    p.drawRoundedRect(20, 6, 24, 32, 12, 12)          # mic head
    p.drawRect(30, 38, 4, 12)                          # stem
    p.drawRect(20, 50, 24, 4)                          # base
    p.end()
    return QIcon(pm)


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Squelch")
    app.setDesktopFileName("squelch")
    app.setQuitOnLastWindowClosed(False)

    icon = QIcon.fromTheme("audio-input-microphone")
    if icon.isNull():
        icon = fallback_icon()
    tray = QSystemTrayIcon(icon)
    tray.setToolTip("Squelch")

    menu = QMenu()
    group = QActionGroup(menu)
    group.setExclusive(True)
    actions = {}
    for key, label in ENGINES:
        a = QAction(label, menu, checkable=True)
        a.setData(key)
        a.triggered.connect(lambda _=False, k=key: switch(k))
        group.addAction(a)
        menu.addAction(a)
        actions[key] = a
    menu.addSeparator()
    status_action = QAction("", menu)
    status_action.setEnabled(False)
    menu.addAction(status_action)
    menu.addSeparator()
    stats_action = QAction("Analytics…", menu)
    stats_action.triggered.connect(
        lambda: stats.open_fullscreen())
    menu.addAction(stats_action)
    menu.addSeparator()
    quit_action = QAction("Quit tray (dictation keeps working)", menu)
    quit_action.triggered.connect(app.quit)
    menu.addAction(quit_action)

    def switch(key):
        write_engine(key)
        refresh()

    def refresh():
        cur = read_engine()
        for key, a in actions.items():
            a.setChecked(key == cur)
        label = dict(ENGINES)[cur]
        tray.setToolTip(f"Squelch — {label}")

    def on_show():
        refresh()
        status_action.setText("services:  " + service_status())

    menu.aboutToShow.connect(on_show)
    tray.setContextMenu(menu)

    popup = EnginePopup(
        on_engine=lambda key: (switch(key), refresh()),
        on_filters=write_filters,
        on_dict=lambda: editor.open_fullscreen(),
        on_stats=lambda: stats.open_fullscreen())
    editor = DictionaryEditor(
        on_saved=lambda n: popup.refresh_dict_button())
    stats = StatsWindow()

    def on_menu_tap():
        if popup.isVisible():
            popup.hide()
        else:
            popup.show_at(read_engine(), service_status(), read_filters())

    watcher = MenuKeyWatcher(on_menu_tap)
    refresh()
    tray.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
