            self.hide()
        else:
            super().keyPressEvent(event)


class KeyCapture(QObject):
    """While active, swallows every key and reports the first one once
    it's released (so kanata never restarts under a held key). Codes are
    evdev ones: what squelch-ptt will see on the keyboard."""

    def __init__(self, on_key):
        super().__init__()
        self.on_key = on_key
        self.active = False
        self.code = None

    def start(self):
        self.active, self.code = True, None
        QApplication.instance().installEventFilter(self)

    def stop(self):
        if self.active:
            self.active = False
            QApplication.instance().removeEventFilter(self)

    def eventFilter(self, obj, event):
        t = event.type()
        if t == QEvent.Type.ShortcutOverride:
            event.accept()
            return True
        if t not in (QEvent.Type.KeyPress, QEvent.Type.KeyRelease):
            return False
        if event.isAutoRepeat():
            return True
        # XKB keycodes are evdev codes + 8, on Wayland and X11 alike
        code = event.nativeScanCode() - 8
        if t == QEvent.Type.KeyPress and self.code is None and code > 0:
            self.code = code
        elif t == QEvent.Type.KeyRelease and code == self.code:
            self.stop()
            # off the event filter before kanata --check blocks the loop
            QTimer.singleShot(0, lambda c=code: self.on_key(c))
        return True


