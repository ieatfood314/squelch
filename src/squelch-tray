class TriggerWatcher:
    """Passive listener on every keyboard that can send the trigger: a
    kanata tap (F23) or a quick press of the trigger key itself pops the
    tap card. No grabs — the dictation daemon reads alongside."""

    def __init__(self, on_tap):
        self.on_tap = on_tap
        self.devs = {}       # path -> (InputDevice, QSocketNotifier)
        self.skipped = set()
        self.code = read_hotkey()
        self.down = None     # (path, time) of a trigger press
        self.timer = QTimer()
        self.timer.setInterval(2000)
        self.timer.timeout.connect(self.discover)
        self.timer.start()
        self.discover()

    def rescan(self):
        """Trigger key changed: reopen everything for the new one."""
        for path in list(self.devs):
            self.drop(path)
        self.skipped.clear()
        self.code = read_hotkey()
        self.discover()

    def discover(self):
        paths = set(glob.glob("/dev/input/event*"))
        self.skipped &= paths
        for path in sorted(paths - set(self.devs) - self.skipped):
            try:
                d = evdev.InputDevice(path)
                keys = d.capabilities().get(evdev.ecodes.EV_KEY, [])
            except OSError:
                continue
            if "ydotoold" in d.name.lower() or (
                    self.code not in keys and F23 not in keys):
                d.close()
                self.skipped.add(path)
                continue
            n = QSocketNotifier(d.fd, QSocketNotifier.Type.Read)
            n.activated.connect(lambda _fd, p=path: self.on_activity(p))
            self.devs[path] = (d, n)

    def on_activity(self, path):
        d = self.devs[path][0]
        try:
            events = list(d.read())
        except OSError:
            self.drop(path)
            return
        for ev in events:
            if ev.type != evdev.ecodes.EV_KEY:
                continue
            if ev.code == F23 and ev.value == 1:
                self.on_tap()
            elif ev.code == self.code and ev.value == 1:
                self.down = (path, time.time())
            elif ev.code == self.code and ev.value == 0 and self.down:
                if (self.down[0] == path
                        and time.time() - self.down[1] < HOLD_DELAY_S):
                    self.on_tap()
                self.down = None

    def drop(self, path):
        d, n = self.devs.pop(path)
        n.setEnabled(False)
        try:
            d.close()
        except OSError:
            pass


def fallback_icon():
    pm = QPixmap(64, 64)
    pm.fill(QColor(0, 0, 0, 0))
    p = QPainter(pm)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    p.setBrush(QColor(STEEL_FOCUS))
    p.setPen(QColor(0, 0, 0, 0))
    p.drawRoundedRect(20, 6, 24, 32, 12, 12)          # mic head
    p.drawRect(30, 38, 4, 12)                          # stem
    p.drawRect(20, 50, 24, 4)                          # base
    p.end()
    return QIcon(pm)


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Squelch")
    app.setDesktopFileName("squelch")
    app.setQuitOnLastWindowClosed(False)
    app.setStyleSheet(app_style(read_appearance()))

    icon = QIcon.fromTheme("audio-input-microphone")
    if icon.isNull():
        icon = fallback_icon()
    tray = QSystemTrayIcon(icon)
    tray.setToolTip("Squelch")

    menu = QMenu()
    group = QActionGroup(menu)
    group.setExclusive(True)
    actions = {}
    for key, text in ENGINES:
        a = QAction(text, menu, checkable=True)
        a.setData(key)
        a.triggered.connect(lambda _=False, k=key: switch(k))
        group.addAction(a)
        menu.addAction(a)
        actions[key] = a
    menu.addSeparator()
    status_action = QAction("", menu)
    status_action.setEnabled(False)
    menu.addAction(status_action)
    menu.addSeparator()
    settings_action = QAction("Settings", menu)
    settings_action.triggered.connect(lambda: open_settings())
    menu.addAction(settings_action)
    menu.addSeparator()
    quit_action = QAction("Quit tray", menu)
    quit_action.triggered.connect(app.quit)
    menu.addAction(quit_action)

    def switch(key):
        write_engine(key)
        refresh()

    def refresh():
        cur = read_engine()
        for key, a in actions.items():
            a.setChecked(key == cur)
        tray.setToolTip(f"Squelch · {ENGINE_NAMES[cur]}")

    def on_show():
        refresh()
        status_action.setText(engine_status())

    menu.aboutToShow.connect(on_show)
    tray.setContextMenu(menu)

    settings = SettingsWindow(on_engine=switch, on_filters=write_filters)

    def open_settings(tab=0):
        popup.hide()  # single-window policy: settings closes the tap card
        settings.open(tab)

    popup = EnginePopup(on_engine=switch, on_settings=open_settings)

    tap = {"pending": False}
    tap_timer = QTimer()
    tap_timer.setSingleShot(True)
    tap_timer.setInterval(350)

    def on_tap_timeout():
        if not tap["pending"]:
            return
        tap["pending"] = False
        if settings.isVisible():
            settings.close()  # single tap with settings open closes it
        elif popup.isVisible():
            popup.hide()
        else:
            popup.show_at(read_engine(), engine_status())

    tap_timer.timeout.connect(on_tap_timeout)

    def on_menu_tap():
        if settings.hk_capture.active:
            return  # pressing the trigger to pick it again
        if tap["pending"]:
            # double tap: straight to settings, tap card stays closed
            tap["pending"] = False
            tap_timer.stop()
            open_settings()
        else:
            tap["pending"] = True
            tap_timer.start()

    app.watcher = TriggerWatcher(on_menu_tap)  # keep it alive
    refresh()
    tray.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
