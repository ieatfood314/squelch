def list_model_files(kind):
    d = PARAKEET_DIR if kind == "parakeet" else WHISPER_DIR
    out = []
    try:
        for name in sorted(os.listdir(d)):
            if name.endswith(".bin"):
                p = os.path.join(d, name)
                try:
                    out.append((name, os.path.getsize(p) / 1048576, p))
                except OSError:
                    continue
    except OSError:
        pass
    return out


def set_service_enabled(svc, enable, is_self=False):
    """Toggle boot autostart; enabling also starts now (except ourselves)."""
    cmds = [["enable" if enable else "disable", svc]]
    if not is_self:
        cmds.append(["start" if enable else "stop", svc])
    for c in cmds:
        try:
            subprocess.run(["systemctl", "--user", *c], timeout=30,
                           stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)
        except Exception:
            return False
    return True


def setup_models_cmd():
    """squelch-setup-models next to this script (dev checkout) or on PATH."""
    here = os.path.join(os.path.dirname(os.path.realpath(__file__)),
                        "squelch-setup-models")
    if os.access(here, os.X_OK):
        return here
    return shutil.which("squelch-setup-models") or "squelch-setup-models"


_catalog = []


def model_catalog():
    """[(id, engine, label, path, size text)] from squelch-setup-models'
    CATALOG, so the downloadable models are listed in one place."""
    if not _catalog:
        try:
            from importlib.machinery import SourceFileLoader
            import importlib.util as iu
            loader = SourceFileLoader("squelch_setup_models",
                                      setup_models_cmd())
            spec = iu.spec_from_loader("squelch_setup_models", loader)
            m = iu.module_from_spec(spec)
            loader.exec_module(m)
            _catalog.extend((e[0], e[1], e[2], m.model_path(e), m.human(e[4]))
                            for e in m.CATALOG)
        except Exception as e:
            print("model catalog unavailable:", e, file=sys.stderr)
    return _catalog


