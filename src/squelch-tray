def read_engine_models():
    models = dict(DEFAULT_MODELS)
    try:
        with open(ENGINES_ENV) as f:
            for line in f:
                line = line.strip()
                if line.startswith("SQUELCH_PARAKEET_MODEL="):
                    models["parakeet"] = line.split("=", 1)[1].strip()
                elif line.startswith("SQUELCH_WHISPER_MODEL="):
                    models["whisper"] = line.split("=", 1)[1].strip()
    except OSError:
        pass
    return models


