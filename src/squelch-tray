    """Unified low-profile settings: engine/text/dictionary/analytics tabs
    in one centered window (not fullscreen)."""

    COLS = ("Term (correct spelling)", "Also heard as (comma separated)")

    suggested = pyqtSignal(int, object)  # row, [suggestions] (None = failed)
    suggest_failed = pyqtSignal(str)

    def __init__(self, on_engine):
        super().__init__(None, Qt.WindowType.Window)
        self.setWindowTitle("Squelch settings")
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
        self.on_engine = on_engine
        self.suggested.connect(self._apply_suggestions)
        self.suggest_failed.connect(self._suggest_error)
        self.setStyleSheet(
            "SettingsWindow { background: rgba(8, 8, 8, 0.96); }")
        self.resize(700, 540)

        lay = QVBoxLayout(self)
        lay.setContentsMargins(16, 14, 16, 14)
        self.tabs = QTabWidget()
        self.tabs.setStyleSheet(
            "QTabWidget::pane { background: rgba(8,8,8,0.96);"
            " border: 1px solid #3d3d3d; border-radius: 8px; }"
            "QTabBar::tab { background: #1a1a1a; color: #cccccc;"
            " padding: 6px 14px; border-top-left-radius: 6px;"
            " border-top-right-radius: 6px; }"
            "QTabBar::tab:selected { background: #2a2a2a; color: white; }"
            "QWidget { color: white; }")
        lay.addWidget(self.tabs, 1)
        self._build_general()
        self._build_dictionary()
        self._build_analytics()

        self.analytics_timer = QTimer(self)
        self.analytics_timer.setInterval(5000)
        self.analytics_timer.timeout.connect(
            lambda: self.isVisible() and self.refresh_analytics())

    # ---- general tab ----
    def _build_general(self):
        tab = QWidget()
        lay = QVBoxLayout(tab)
        lay.setSpacing(8)

        eng = QLabel("Engine")
        eng.setStyleSheet("color: white; font-weight: bold; font-size: 13px;")
        lay.addWidget(eng)
        self.g_radios = {}
        for key, label in ENGINES:
            rb = QRadioButton(label)
            rb.toggled.connect(
                lambda checked, k=key: checked and self.on_engine(k))
            lay.addWidget(rb)
            self.g_radios[key] = rb
        self.g_status = QLabel()
        self.g_status.setStyleSheet(DIM_LABEL)
        self.g_status.setWordWrap(True)
        lay.addWidget(self.g_status)

        clf = QLabel("Text cleanup")
        clf.setStyleSheet("color: white; font-weight: bold; font-size: 13px;")
        lay.addWidget(clf)
        self.cb_defill = QCheckBox("Remove filler words (um, ah, …)")
        self.cb_numbers = QCheckBox("Write numbers as digits (over ten)")
        self.cb_all = QCheckBox("Write ALL numbers as digits (incl. 0–10)")
        for cb in (self.cb_defill, self.cb_numbers, self.cb_all):
            cb.toggled.connect(lambda _c: self.filters_changed())
            lay.addWidget(cb)

        keyl = QLabel("OpenRouter (powers mishearing suggestions)")
        keyl.setStyleSheet("color: white; font-weight: bold; font-size: 13px;")
        lay.addWidget(keyl)
        keyrow = QHBoxLayout()
        self.key_field = QLineEdit()
        self.key_field.setEchoMode(QLineEdit.EchoMode.Password)
        self.key_field.setPlaceholderText("paste key, then Set")
        self.key_field.setStyleSheet(
            "background: #0a0a0a; color: white; border: 1px solid #3d3d3d;"
            " border-radius: 6px; padding: 4px;")
        set_btn = QPushButton("Set")
        clear_btn = QPushButton("Clear")
        for b in (set_btn, clear_btn):
            b.setStyleSheet(BTN)
        set_btn.clicked.connect(self.key_save)
        clear_btn.clicked.connect(self.key_clear)
        keyrow.addWidget(self.key_field, 1)
        keyrow.addWidget(set_btn)
        keyrow.addWidget(clear_btn)
        lay.addLayout(keyrow)
        self.key_status = QLabel()
        self.key_status.setStyleSheet(DIM_LABEL)
        lay.addWidget(self.key_status)
        lay.addStretch(1)
        self.tabs.addTab(tab, "General")

    def filters_changed(self):
        write_filters({"defiller": self.cb_defill.isChecked(),
                       "numbers": self.cb_numbers.isChecked(),
                       "numbers_all": self.cb_all.isChecked()})

    def key_save(self):
        k = self.key_field.text().strip()
        if not k:
            return
        os.makedirs(os.path.dirname(OPENROUTER_KEY_FILE), exist_ok=True)
        with open(OPENROUTER_KEY_FILE, "w") as f:
            f.write(k + "\n")
        os.chmod(OPENROUTER_KEY_FILE, 0o600)
        self.key_field.clear()
        try:
            os.unlink(OPENROUTER_MODEL_FILE)  # re-probe models for new key
        except OSError:
            pass
        self.refresh_key_status()

    def key_clear(self):
        try:
            os.unlink(OPENROUTER_KEY_FILE)
        except OSError:
            pass
        try:
            os.unlink(OPENROUTER_MODEL_FILE)
        except OSError:
            pass
        self.refresh_key_status()

    def refresh_key_status(self):
        self.key_status.setText(
            "Key configured — suggestions enabled." if openrouter_key()
            else "No key set — suggestions unavailable.")

    # ---- dictionary tab ----
    def _build_dictionary(self):
        tab = QWidget()
        lay = QVBoxLayout(tab)
        lay.setSpacing(8)
        self.or_status = QLabel()
        self.or_status.setStyleSheet(DIM_LABEL)
        lay.addWidget(self.or_status)

        self.dtable = QTableWidget(0, 2)
        self.dtable.setHorizontalHeaderLabels(list(self.COLS))
        hdr = self.dtable.horizontalHeader()
        hdr.setSectionResizeMode(0, QHeaderView.ResizeMode.Stretch)
        hdr.setSectionResizeMode(1, QHeaderView.ResizeMode.Stretch)
        self.dtable.setSelectionBehavior(
            QAbstractItemView.SelectionBehavior.SelectRows)
        self.dtable.setStyleSheet(TABLE_STYLE)
        lay.addWidget(self.dtable, 1)

        row = QHBoxLayout()
        add_btn = QPushButton("Add row")
        del_btn = QPushButton("Remove selected")
        self.suggest_btn = QPushButton("Suggest mishearings")
        for b in (add_btn, del_btn, self.suggest_btn):
            b.setStyleSheet(BTN)
        add_btn.clicked.connect(self.add_row)
        del_btn.clicked.connect(self.del_rows)
        self.suggest_btn.clicked.connect(self.suggest)
        row.addWidget(add_btn)
        row.addWidget(del_btn)
        row.addWidget(self.suggest_btn)
        row.addStretch(1)
        save_btn = QPushButton("Save dictionary")
        save_btn.setStyleSheet(
            "color: white; background: #3563c8;"
            " border: 1px solid #4a7de0; border-radius: 6px; padding: 6px 18px;")
        save_btn.clicked.connect(self.save_dict)
        row.addWidget(save_btn)
        lay.addLayout(row)
        self.tabs.addTab(tab, "Dictionary")

    def load_dict(self):
        try:
            with open(DICT_FILE) as f:
                entries = _json.load(f).get("entries", [])
        except (OSError, ValueError, AttributeError):
            entries = []
        self.dtable.setRowCount(0)
        for e in entries:
            r = self.dtable.rowCount()
            self.dtable.insertRow(r)
            self.dtable.setItem(r, 0, QTableWidgetItem(str(e.get("term", ""))))
            self.dtable.setItem(
                r, 1, QTableWidgetItem(
                    ", ".join(str(x) for x in e.get("also_match", []) or [])))

    def add_row(self):
        r = self.dtable.rowCount()
        self.dtable.insertRow(r)
        self.dtable.setItem(r, 0, QTableWidgetItem(""))
        self.dtable.setItem(r, 1, QTableWidgetItem(""))
        self.dtable.editItem(self.dtable.item(r, 0))

    def del_rows(self):
        for idx in sorted(
                {i.row() for i in self.dtable.selectedIndexes()},
                reverse=True):
            self.dtable.removeRow(idx)

    def suggest(self):
        """Fill Also-heard-as for the selected row via OpenRouter (one call)."""
        rows = sorted({i.row() for i in self.dtable.selectedIndexes()})
        row = rows[0] if rows else self.dtable.currentRow()
        if row < 0 or row >= self.dtable.rowCount():
            self.or_status.setText("Select a row first.")
            return
        item = self.dtable.item(row, 0)
        term = item.text().strip() if item else ""
        if not term:
            self.or_status.setText("Type the term first, then Suggest.")
            return
        self.suggest_btn.setEnabled(False)
        self.or_status.setText(f"Asking OpenRouter what “{term}” sounds like…")
        threading.Thread(target=self._suggest_worker, args=(row, term),
                         daemon=True).start()

    def _suggest_worker(self, row, term):
        try:
            self.suggested.emit(row, fetch_mishearings(term))
        except Exception as e:
            self.suggest_failed.emit(str(e)[:160])

    def _apply_suggestions(self, row, suggs):
        self.suggest_btn.setEnabled(True)
        if suggs is None or row >= self.dtable.rowCount():
            return
        term_item = self.dtable.item(row, 0)
        term = term_item.text().strip().lower() if term_item else ""
        item = self.dtable.item(row, 1)
        have = [h.strip() for h in
                ((item.text() if item else "").split(","))]
        have_l = {h.lower() for h in have if h}
        added = [s for s in suggs
                 if s.lower() not in have_l and s.lower() != term]
        if added:
            have = [h for h in have if h] + added
            self.dtable.setItem(row, 1, QTableWidgetItem(", ".join(have)))
        self.or_status.setText(
            f"Added {len(added)} mishearing(s)."
            if added else "Nothing new suggested.")

    def _suggest_error(self, msg):
        self.suggest_btn.setEnabled(True)
        self.or_status.setText(f"OpenRouter error: {msg}")

    def save_dict(self):
        entries = []
        for r in range(self.dtable.rowCount()):
            term_item = self.dtable.item(r, 0)
            term = term_item.text().strip() if term_item else ""
            if not term:
                continue
            heard_item = self.dtable.item(r, 1)
            heard = [h.strip() for h in
                     ((heard_item.text() if heard_item else "").split(","))]
            entries.append({"term": term,
                            "also_match": [h for h in heard if h]})
        os.makedirs(os.path.dirname(DICT_FILE), exist_ok=True)
        with open(DICT_FILE, "w") as f:
            _json.dump({"_help": DICT_HELP, "entries": entries}, f,
                       indent=2, ensure_ascii=False)
        self.or_status.setText(f"Saved {len(entries)} term(s).")

    # ---- analytics tab ----
    def _build_analytics(self):
        tab = QWidget()
        lay = QVBoxLayout(tab)
        lay.setSpacing(10)
        tiles = QHBoxLayout()
        tiles.setSpacing(12)
        self.tiles = {}
        for key, caption in (("words", "words (all time)"),
                             ("wpm", "avg WPM (all time)"),
                             ("lat", "avg transcription"),
                             ("utts", "utterances")):
            box = QVBoxLayout()
            num = QLabel("—")
            num.setStyleSheet(
                "color: white; font-weight: bold; font-size: 22px;")
            cap = QLabel(caption)
            cap.setStyleSheet("color: #aaaaaa; font-size: 11px;")
            cap.setWordWrap(True)
            box.addWidget(num)
            box.addWidget(cap)
            tiles.addLayout(box, 1)
            self.tiles[key] = num
        lay.addLayout(tiles)
        self.a_recent = QLabel()
        self.a_recent.setStyleSheet("color: white; font-size: 12px;")
        self.a_recent.setWordWrap(True)
        lay.addWidget(self.a_recent)
        self.a_table = QTableWidget(0, 4)
        self.a_table.setHorizontalHeaderLabels(
            ["Day", "Words", "Utterances", "Audio (min)"])
        hdr = self.a_table.horizontalHeader()
        for i in range(4):
            hdr.setSectionResizeMode(i, QHeaderView.ResizeMode.Stretch)
        self.a_table.setSelectionBehavior(
            QAbstractItemView.SelectionBehavior.SelectRows)
        self.a_table.setEditTriggers(
            QAbstractItemView.EditTrigger.NoEditTriggers)
        self.a_table.setStyleSheet(TABLE_STYLE)
        lay.addWidget(self.a_table, 1)
        self.tabs.addTab(tab, "Analytics")

    def refresh_analytics(self):
        s = summarize_stats(load_stats())
        self.tiles["words"].setText(f"{s['words']:,}")
        self.tiles["wpm"].setText(f"{s['wpm']:.0f}")
        self.tiles["lat"].setText(f"{s['avg_lat']:.2f} s")
        self.tiles["utts"].setText(f"{s['utterances']:,}")
        utt_word = "utterance" if s['recent_n'] == 1 else "utterances"
        self.a_recent.setText(
            f"Last hour: {s['recent_wpm']:.0f} WPM · "
            f"{s['recent_words']:,} words ({s['recent_n']} {utt_word}) · "
            f"transcription avg (last 10): {s['recent_lat']:.2f} s")
        self.a_table.setRowCount(0)
        for d, w, u, a in s["days"]:
            r = self.a_table.rowCount()
            self.a_table.insertRow(r)
            self.a_table.setItem(r, 0, QTableWidgetItem(d))
            self.a_table.setItem(r, 1, QTableWidgetItem(f"{w:,}"))
            self.a_table.setItem(r, 2, QTableWidgetItem(f"{u:,}"))
            self.a_table.setItem(r, 3, QTableWidgetItem(f"{a:.1f}"))

    # ---- open / refresh ----
    def refresh_general(self):
        cur = read_engine()
        for key, rb in self.g_radios.items():
            rb.blockSignals(True)
            rb.setChecked(key == cur)
            rb.blockSignals(False)
        self.g_status.setText("services:  " + service_status())
        flt = read_filters()
        for cb, name in ((self.cb_defill, "defiller"),
                         (self.cb_numbers, "numbers"),
                         (self.cb_all, "numbers_all")):
            cb.blockSignals(True)
            cb.setChecked(flt[name])
            cb.blockSignals(False)
        self.key_field.clear()
        self.refresh_key_status()

    def open(self, tab=0):
        self.refresh_general()
        self.load_dict()
        self.or_status.setText(
            "OpenRouter: ready" if openrouter_key()
            else "OpenRouter: no key — suggestions unavailable")
        self.refresh_analytics()
        self.tabs.setCurrentIndex(tab)
        self.show()
        self.raise_()
        self.activateWindow()
        screen = QGuiApplication.screenAt(QCursor.pos())
        if screen is not None:
            geo = screen.availableGeometry()
            self.move(geo.x() + (geo.width() - self.width()) // 2,
                      geo.y() + (geo.height() - self.height()) // 3)
        if not self.analytics_timer.isActive():
            self.analytics_timer.start()

    def keyPressEvent(self, event):
        if event.key() == Qt.Key.Key_Escape:
            self.close()
        else:
            super().keyPressEvent(event)


class MenuKeyWatcher:
    """Passive listener on kanata's output device: a Menu tap (F23) pops the
    STT menu at the cursor. No grabs — dictation daemon reads alongside."""

    def __init__(self, on_tap):
        self.on_tap = on_tap
        self.dev = None
        self.notifier = None
        self.timer = QTimer()
        self.timer.setInterval(2000)
        self.timer.timeout.connect(self.discover)
        self.discover()

    def find_device(self):
        import glob as _glob
        for path in sorted(_glob.glob("/dev/input/event*")):
            try:
                d = evdev.InputDevice(path)
            except OSError:
                continue
            if "kanata" not in d.name.lower():
                continue
            try:
                if F23 in d.capabilities().get(evdev.ecodes.EV_KEY, []):
                    return d
            except OSError:
                continue
        return None

    def discover(self):
        if self.dev is not None:
            return
        d = self.find_device()
        if d is None:
            if not self.timer.isActive():
                self.timer.start()
            return
        self.timer.stop()
        self.dev = d
        self.notifier = QSocketNotifier(
            d.fd, QSocketNotifier.Type.Read)
        self.notifier.activated.connect(self.on_activity)

    def on_activity(self):
        try:
            for ev in self.dev.read():
                if (ev.type == evdev.ecodes.EV_KEY and ev.code == F23
                        and ev.value == 1):
                    self.on_tap()
        except OSError:
            self.teardown()
            self.timer.start()

    def teardown(self):
        if self.notifier is not None:
            self.notifier.setEnabled(False)
            self.notifier = None
        self.dev = None


def fallback_icon():
    pm = QPixmap(64, 64)
    pm.fill(QColor(0, 0, 0, 0))
    p = QPainter(pm)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    p.setBrush(QColor(0x35, 0x84, 0xe4))
    p.setPen(QColor(0, 0, 0, 0))
    p.drawRoundedRect(20, 6, 24, 32, 12, 12)          # mic head
    p.drawRect(30, 38, 4, 12)                          # stem
    p.drawRect(20, 50, 24, 4)                          # base
    p.end()
    return QIcon(pm)


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Squelch")
    app.setDesktopFileName("squelch")
    app.setQuitOnLastWindowClosed(False)

    icon = QIcon.fromTheme("audio-input-microphone")
    if icon.isNull():
        icon = fallback_icon()
    tray = QSystemTrayIcon(icon)
    tray.setToolTip("Squelch")

    menu = QMenu()
    group = QActionGroup(menu)
    group.setExclusive(True)
    actions = {}
    for key, label in ENGINES:
        a = QAction(label, menu, checkable=True)
        a.setData(key)
        a.triggered.connect(lambda _=False, k=key: switch(k))
        group.addAction(a)
        menu.addAction(a)
        actions[key] = a
    menu.addSeparator()
    status_action = QAction("", menu)
    status_action.setEnabled(False)
    menu.addAction(status_action)
    menu.addSeparator()
    settings_action = QAction("Settings…", menu)
    settings_action.triggered.connect(lambda: settings.open())
    menu.addAction(settings_action)
    menu.addSeparator()
    quit_action = QAction("Quit tray (dictation keeps working)", menu)
    quit_action.triggered.connect(app.quit)
    menu.addAction(quit_action)

    def switch(key):
        write_engine(key)
        refresh()

    def refresh():
        cur = read_engine()
        for key, a in actions.items():
            a.setChecked(key == cur)
        label = dict(ENGINES)[cur]
        tray.setToolTip(f"Squelch — {label}")

    def on_show():
        refresh()
        status_action.setText("services:  " + service_status())

    menu.aboutToShow.connect(on_show)
    tray.setContextMenu(menu)

    settings = SettingsWindow(on_engine=lambda key: (switch(key), refresh()))
    popup = EnginePopup(
        on_engine=lambda key: (switch(key), refresh()),
        on_settings=settings.open)

    def on_menu_tap():
        if popup.isVisible():
            popup.hide()
        else:
            popup.show_at(read_engine(), service_status())

    watcher = MenuKeyWatcher(on_menu_tap)
    refresh()
    tray.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
