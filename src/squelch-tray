def duration(seconds):
    return (f"{seconds:.0f} s" if seconds < 120
            else f"{seconds / 60:.1f} min".replace(".0 min", " min"))


def longest_dictation():
    """What squelch-ptt would allow right now, or "" if unknown."""
    if read_engine() != "parakeet":
        return duration(STUCK_KEY_S)
    url = (f"http://127.0.0.1:{ENGINE_PORTS['parakeet']}/limits"
           f"?headroom_mb={read_headroom_gb() * 1024:.0f}")
    try:
        with urllib.request.urlopen(url, timeout=1) as r:
            fit = float(json.loads(r.read())["max_seconds"])
    except Exception:
        return ""
    return duration(min(STUCK_KEY_S, max(MIN_CAP_S, fit)))


def list_mics():
    """[(node name, description)] of PipeWire audio sources."""
    try:
        out = subprocess.run(["pw-dump"], capture_output=True,
                             timeout=10).stdout
        objs = json.loads(out)
    except Exception:
        return []
    mics = []
    for o in objs:
        props = ((o.get("info") or {}).get("props") or {}) \
            if isinstance(o, dict) else {}
        if props.get("media.class") == "Audio/Source":
            name = str(props.get("node.name", ""))
            mics.append((name, str(props.get("node.description") or name)))
    return sorted(mics, key=lambda m: m[1].lower())


# ---------------- dictionary ----------------

def _clean_entries(raw):
    entries = []
    for e in raw if isinstance(raw, list) else []:
        if not isinstance(e, dict):
            continue
        term = str(e.get("term", "")).strip()
        if term:
            entries.append({"term": term, "also_match": [
                str(x) for x in e.get("also_match", []) or []]})
    return entries


def load_dict():
    d = read_json(DICT_FILE, {})
    return _clean_entries(d.get("entries") if isinstance(d, dict) else [])


def update_dict(change):
    """Read the dictionary fresh, apply change(entries) and save, under a
    lock shared with the squelch CLI, so edits from both never clobber
    each other. Returns the saved entries."""
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(DICT_FILE + ".lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        entries = load_dict()
        change(entries)
        atomic_write(DICT_FILE, json.dumps(
            {"_help": DICT_HELP, "entries": entries},
            indent=2, ensure_ascii=False))
    return entries


def find_entry(entries, term):
    return next((e for e in entries if e["term"].lower() == term.lower()),
                None)


DICT_HELP = ("Your words. 'term' is the correct spelling. 'also_match' lists "
             "ways the engine mishears it, fixed automatically.")


def pending_mishearings(entries):
    """[(term, heard)] squelch-ptt spotted but that are real words, so they
    wait for a yes/no. Ones already in the dictionary are dropped."""
    d = read_json(LEARNED_FILE, {})
    out = []
    for p in d.get("pending", []) if isinstance(d, dict) else []:
        if not isinstance(p, dict):
            continue
        e = find_entry(entries, str(p.get("term", "")))
        heard = str(p.get("heard", "")).strip()
        if e and heard and heard.lower() not in {
                h.lower() for h in e["also_match"]}:
            out.append((e["term"], heard))
    return out


def resolve_mishearing(term, heard, accept):
    """Take (term, heard) off the pending list: accept adds it to the
    dictionary, otherwise it's ignored for good."""
    if accept:
        def change(entries):
            e = find_entry(entries, term)
            if e is not None and heard.lower() not in {
                    h.lower() for h in e["also_match"]}:
                e["also_match"].append(heard)
        update_dict(change)
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(LEARNED_FILE + ".lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        d = read_json(LEARNED_FILE, {})
        d = d if isinstance(d, dict) else {}
        key = (term.lower(), heard.lower())
        d["pending"] = [p for p in d.get("pending", [])
                        if isinstance(p, dict) and
                        (str(p.get("term", "")).lower(),
                         str(p.get("heard", "")).lower()) != key]
        if not accept:
            d.setdefault("ignored", []).append(
                {"term": term, "heard": heard})
        atomic_write(LEARNED_FILE, json.dumps(d, indent=2,
                                              ensure_ascii=False))


# ---------------- kanata trigger key ----------------

TRIGGER_RE = re.compile(r"\(\s*tap-hold\s+\d+\s+\d+\s+f23\s+f24\s*\)")


def _kanata_forms(text):
    """Top-level kanata forms as (name, [(item text, start, end)]).
    Items are atoms or whole nested lists; comments are skipped."""
    forms, i, n = [], 0, len(text)
    depth, items, start = 0, None, None
    while i < n:
        c = text[i]
        if text.startswith(";;", i):
            i = text.find("\n", i)
            i = n if i < 0 else i
            continue
        if text.startswith("#|", i):
            j = text.find("|#", i + 2)
            i = n if j < 0 else j + 2
            continue
        if c == "(":
            if depth == 0:
                items = []
            elif depth == 1:
                start = i
            depth += 1
        elif c == ")":
            depth -= 1
            if depth == 1 and start is not None:
                items.append((text[start:i + 1], start, i + 1))
                start = None
            elif depth == 0 and items is not None:
                if items:
                    forms.append((items[0][0], items[1:]))
                items = None
        elif not c.isspace() and depth >= 1:
            j = i
            while j < n and not text[j].isspace() and text[j] not in "()":
                j += 1
            if depth == 1:
                items.append((text[i:j], i, j))
            i = j
            continue
        i += 1
    return forms


def find_trigger(text):
    """(defsrc key the Squelch tap-hold sits on, its (start, end) span in
    the text, all defsrc keys), or None."""
    forms = _kanata_forms(text)
    src = next((items for name, items in forms if name == "defsrc"), None)
    if src is None:
        return None
    aliases = set()
    for name, items in forms:
        if name == "defalias":
            for k in range(0, len(items) - 1, 2):
                if TRIGGER_RE.fullmatch(items[k + 1][0]):
                    aliases.add("@" + items[k][0])
    for name, items in forms:
        if name != "deflayer" or not items:
            continue
        for idx, (item, _s, _e) in enumerate(items[1:]):
            if (TRIGGER_RE.fullmatch(item) or item in aliases) \
                    and idx < len(src):
                key, s, e = src[idx]
                return key, (s, e), [k for k, _a, _b in src]
    return None


def read_hotkey():
    try:
        with open(KANATA_CFG) as f:
            found = find_trigger(f.read())
        if found and found[0] in dict(HOTKEYS):
            return found[0]
    except OSError:
        pass
    try:
        with open(HOTKEY_FILE) as f:
            h = f.read().strip().lower()
        return h if h in dict(HOTKEYS) else "menu"
    except OSError:
        return "menu"


def apply_hotkey(newkey):
    """Move kanata's Squelch tap-hold to another physical key.
    Returns (ok, short message)."""
    try:
        with open(KANATA_CFG) as f:
            text = f.read()
    except OSError:
        return False, "No kanata config"
    found = find_trigger(text)
    if found is None:
        return False, "Trigger not found in kanata config"
    old, (s, e), keys = found
    name = dict(HOTKEYS)[newkey]
    if old == newkey:
        atomic_write(HOTKEY_FILE, newkey + "\n")
        return True, "Already set"
    if newkey in keys:
        return False, f"{name} is already mapped in kanata"
    backup = KANATA_CFG + ".bak-squelch"
    try:
        shutil.copy(KANATA_CFG, backup)
        atomic_write(KANATA_CFG, text[:s] + newkey + text[e:])
    except OSError as ex:
        return False, f"Write failed: {ex}"
    chk = subprocess.run(["kanata", "--check", "--cfg", KANATA_CFG],
                         capture_output=True, text=True, timeout=30)
    if chk.returncode != 0:
        try:
            shutil.copy(backup, KANATA_CFG)
        except OSError:
            pass
        return False, "kanata rejected it, config restored"
    atomic_write(HOTKEY_FILE, newkey + "\n")
    rst = subprocess.run(["sudo", "-n", "systemctl", "restart", "kanata"],
                         capture_output=True, text=True, timeout=30)
    if rst.returncode != 0:
        return True, "Saved. Restart kanata to apply"
    return True, f"Trigger is now {name}"


