class CloseOnClickOff(QObject):
    """Runs `close` once focus leaves Squelch entirely (a click on another
    window or the desktop). Moving between our own windows, like Settings
    and its key dialog, doesn't count. Keyed off the window's own
    deactivation, so a window the compositor never activated isn't closed
    out from under you."""

    def __init__(self, window, close):
        super().__init__(window)
        self.window = window
        self.close = close
        window.installEventFilter(self)

    def eventFilter(self, obj, event):
        if (event.type() == QEvent.Type.ActivationChange
                and not obj.isActiveWindow()):
            # focus can pass through "no window" while moving between ours
            QTimer.singleShot(150, self._close_if_left)
        return False

    def _close_if_left(self):
        if self.window.isVisible() and QApplication.activeWindow() is None:
            self.close()


