class DictionaryEditor(QWidget):
    """Fullscreen dictionary editor: dim overlay + centered card, term table
    with Term / Also-heard-as columns, Add / Remove / Save / Cancel."""

    COLS = ("Term (correct spelling)", "Also heard as (comma separated)")

    suggested = pyqtSignal(int, object)  # row, [suggestions] (None = failed)
    suggest_failed = pyqtSignal(str)

    def __init__(self, on_saved):
        super().__init__(None, Qt.WindowType.Window)
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
        self.on_saved = on_saved
        self.suggested.connect(self._apply_suggestions)
        self.suggest_failed.connect(self._suggest_error)
        self.setStyleSheet(
            "DictionaryEditor { background: rgba(0, 0, 0, 0.72); }")
        outer = QVBoxLayout(self)
        outer.setContentsMargins(0, 0, 0, 0)
        outer.addStretch(1)
        center = QHBoxLayout()
        center.addStretch(1)
        card = QWidget(self)
        card.setObjectName("card")
        card.setFixedSize(780, 580)
        card.setStyleSheet(
            "#card { background: rgba(8, 8, 8, 0.96);"
            " border: 1px solid #3d3d3d; border-radius: 16px; }")
        inner = QVBoxLayout(card)
        inner.setContentsMargins(24, 20, 24, 20)
        inner.setSpacing(10)
        center.addWidget(card)
        center.addStretch(1)
        outer.addLayout(center)
        outer.addStretch(1)

        title = QLabel("Dictionary — your words")
        title.setStyleSheet("color: white; font-weight: bold; font-size: 18px;")
        inner.addWidget(title)
        sub = QLabel("Terms bias Whisper and fix mishearings for both engines."
                     " Changes apply on your next utterance.")
        sub.setStyleSheet("color: #aaaaaa; font-size: 12px;")
        sub.setWordWrap(True)
        inner.addWidget(sub)
        self.or_status = QLabel()
        self.or_status.setStyleSheet("color: #777777; font-size: 11px;")
        inner.addWidget(self.or_status)

        self.table = QTableWidget(0, 2)
        self.table.setHorizontalHeaderLabels(list(self.COLS))
        hdr = self.table.horizontalHeader()
        hdr.setSectionResizeMode(0, QHeaderView.ResizeMode.Stretch)
        hdr.setSectionResizeMode(1, QHeaderView.ResizeMode.Stretch)
        self.table.setSelectionBehavior(
            QAbstractItemView.SelectionBehavior.SelectRows)
        self.table.setStyleSheet(
            "QTableWidget { background: #0a0a0a; color: white;"
            " gridline-color: #333333; border: 1px solid #3d3d3d;"
            " border-radius: 8px; }"
            "QHeaderView::section { background: #1a1a1a; color: white;"
            " border: none; padding: 6px; }")
        inner.addWidget(self.table, 1)

        row = QHBoxLayout()
        add_btn = QPushButton("Add row")
        del_btn = QPushButton("Remove selected")
        self.suggest_btn = QPushButton("Suggest mishearings")
        for b in (add_btn, del_btn, self.suggest_btn):
            b.setStyleSheet(
                "color: white; background: rgba(255,255,255,0.12);"
                " border: 1px solid #555555; border-radius: 6px; padding: 6px;")
        add_btn.clicked.connect(self.add_row)
        del_btn.clicked.connect(self.del_rows)
        self.suggest_btn.clicked.connect(self.suggest)
        row.addWidget(add_btn)
        row.addWidget(del_btn)
        row.addWidget(self.suggest_btn)
        row.addStretch(1)
        cancel_btn = QPushButton("Cancel")
        save_btn = QPushButton("Save")
        save_btn.setStyleSheet(
            "color: white; background: #3563c8;"
            " border: 1px solid #4a7de0; border-radius: 6px; padding: 6px 18px;")
        cancel_btn.setStyleSheet(
            "color: white; background: rgba(255,255,255,0.12);"
            " border: 1px solid #555555; border-radius: 6px; padding: 6px 18px;")
        cancel_btn.clicked.connect(self.close)
        save_btn.clicked.connect(self.save)
        row.addWidget(cancel_btn)
        row.addWidget(save_btn)
        inner.addLayout(row)

    def load(self):
        try:
            with open(DICT_FILE) as f:
                entries = _json.load(f).get("entries", [])
        except (OSError, ValueError, AttributeError):
            entries = []
        self.table.setRowCount(0)
        for e in entries:
            r = self.table.rowCount()
            self.table.insertRow(r)
            self.table.setItem(r, 0, QTableWidgetItem(str(e.get("term", ""))))
            self.table.setItem(
                r, 1, QTableWidgetItem(
                    ", ".join(str(x) for x in e.get("also_match", []) or [])))

    def open_fullscreen(self):
        self.load()
        self.refresh_or_status()
        screen = QGuiApplication.screenAt(QCursor.pos())
        if screen is not None:
            self.move(screen.geometry().topLeft())
        self.showFullScreen()

    def refresh_or_status(self):
        self.or_status.setText(
            "OpenRouter: ready" if openrouter_key()
            else "OpenRouter: no key — suggestions unavailable")

    def add_row(self):
        r = self.table.rowCount()
        self.table.insertRow(r)
        self.table.setItem(r, 0, QTableWidgetItem(""))
        self.table.setItem(r, 1, QTableWidgetItem(""))
        self.table.editItem(self.table.item(r, 0))

    def del_rows(self):
        for idx in sorted(
                {i.row() for i in self.table.selectedIndexes()},
                reverse=True):
            self.table.removeRow(idx)

    def suggest(self):
        """Fill Also-heard-as for the selected row via OpenRouter (one call)."""
        rows = sorted({i.row() for i in self.table.selectedIndexes()})
        row = rows[0] if rows else self.table.currentRow()
        if row < 0 or row >= self.table.rowCount():
            self.or_status.setText("Select a row first.")
            return
        item = self.table.item(row, 0)
        term = item.text().strip() if item else ""
        if not term:
            self.or_status.setText("Type the term first, then Suggest.")
            return
        self.suggest_btn.setEnabled(False)
        self.or_status.setText(f"Asking OpenRouter what “{term}” sounds like…")
        threading.Thread(target=self._suggest_worker, args=(row, term),
                         daemon=True).start()

    def _suggest_worker(self, row, term):
        try:
            self.suggested.emit(row, fetch_mishearings(term))
        except Exception as e:
            self.suggest_failed.emit(str(e)[:160])

    def _apply_suggestions(self, row, suggs):
        self.suggest_btn.setEnabled(True)
        if suggs is None or row >= self.table.rowCount():
            return
        term_item = self.table.item(row, 0)
        term = term_item.text().strip().lower() if term_item else ""
        item = self.table.item(row, 1)
        have = [h.strip() for h in
                ((item.text() if item else "").split(","))]
        have_l = {h.lower() for h in have if h}
        added = [s for s in suggs
                 if s.lower() not in have_l and s.lower() != term]
        if added:
            have = [h for h in have if h] + added
            self.table.setItem(row, 1, QTableWidgetItem(", ".join(have)))
        self.or_status.setText(
            f"Added {len(added)} mishearing(s)."
            if added else "Nothing new suggested.")

    def _suggest_error(self, msg):
        self.suggest_btn.setEnabled(True)
        self.or_status.setText(f"OpenRouter error: {msg}")

    def save(self):
        entries = []
        for r in range(self.table.rowCount()):
            term_item = self.table.item(r, 0)
            term = term_item.text().strip() if term_item else ""
            if not term:
                continue
            heard_item = self.table.item(r, 1)
            heard = [h.strip() for h in
                     ((heard_item.text() if heard_item else "").split(","))]
            entries.append({"term": term,
                            "also_match": [h for h in heard if h]})
        os.makedirs(os.path.dirname(DICT_FILE), exist_ok=True)
        with open(DICT_FILE, "w") as f:
            _json.dump({"_help": DICT_HELP, "entries": entries}, f,
                       indent=2, ensure_ascii=False)
        self.on_saved(len(entries))
        self.close()

    def keyPressEvent(self, event):
        if event.key() == Qt.Key.Key_Escape:
            self.close()
        else:
            super().keyPressEvent(event)


