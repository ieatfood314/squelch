    def model_changed(self, kind):
        path = self.model_combos[kind].currentData()
        if not path:
            return
        models = read_engine_models()
        if models.get(kind) == path:
            return
        if not os.path.exists(path):
            entry = next((c for c in model_catalog() if c[3] == path), None)
            if entry is not None and self._downloading is None:
                self._dl_select = (kind, path)
                self.start_download([entry[0]], entry[2])
            self.refresh_models()  # stay on the current model meanwhile
            return
        models[kind] = path
        write_engine_models(models)
        self.refresh_models()

    def refresh_models(self):
        models = read_engine_models()
        catalog = model_catalog()
        for kind, combo in self.model_combos.items():
            items = []  # (text, path)
            for _id, eng, name, path, size in catalog:
                if eng == kind:
                    items.append((f"{name} · {size}" if os.path.exists(path)
                                  else f"{name} · {size} · download", path))
            listed = {p for _t, p in items}
            for name, mb, path in list_model_files(kind):
                if path not in listed:
                    items.append((f"{name} · {mb:.0f} MB", path))
            cur = models.get(kind, "")
            if cur not in {p for _t, p in items}:
                items.append((os.path.basename(cur), cur))
            combo.blockSignals(True)
            combo.clear()
            for text, path in items:
                combo.addItem(text, path)
            i = combo.findData(cur)
            if i >= 0:
                combo.setCurrentIndex(i)
            combo.blockSignals(False)
            self.model_sizes[kind].setText(
                "" if os.path.exists(cur) else "Missing")
        missing = [k for k in ("parakeet", "whisper")
                   if not os.path.exists(models.get(k, ""))]
        busy = self._downloading is not None
        self.dl_btn.setVisible(bool(missing) and not busy)
        self.dl_status.setVisible(bool(missing) or busy or bool(
            self.dl_status.text()))
        if busy:
            self.dl_status.setText(f"Downloading {self._downloading}…")
        elif missing and not self.dl_status.text().startswith(
                "Download failed"):
            self.dl_status.setText(
                f"Missing: {', '.join(ENGINE_NAMES[k] for k in missing)}")

    def download_models(self):
        """Download button: the selected models that are missing."""
        models = read_engine_models()
        ids = [c[0] for c in model_catalog()
               if c[3] in (models.get("parakeet"), models.get("whisper"))
               and not os.path.exists(c[3])]
        self._dl_select = None
        self.start_download(ids, "models")

    def start_download(self, ids, what):
        self._downloading = what
        self.dl_status.setText("")
        self.refresh_models()
        threading.Thread(target=self._download_worker, args=(ids,),
                         daemon=True).start()

    def _download_worker(self, ids):
        try:
            r = subprocess.run([setup_models_cmd(), *ids],
                               capture_output=True, text=True, timeout=3600)
            if r.returncode == 0:
                self.dl_done.emit("")
            else:
                err = (r.stderr.strip().splitlines() or ["error"])[-1]
                self.dl_done.emit(f"Download failed: {err[:80]}")
        except Exception as e:
            self.dl_done.emit(f"Download failed: {e}")

    def _dl_finished(self, msg):
        self._downloading = None
        self.dl_status.setText(msg)
        if not msg and self._dl_select:
            kind, path = self._dl_select
            if os.path.exists(path):
                models = read_engine_models()
                models[kind] = path
                write_engine_models(models)
        self._dl_select = None
        self.refresh_models()

