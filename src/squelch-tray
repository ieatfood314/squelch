def read_headroom_gb():
    d = read_json(VRAM_FILE, {})
    try:
        return max(0.0, float(d.get("headroom_gb", DEFAULT_HEADROOM_GB)))
    except (AttributeError, TypeError, ValueError):
        return DEFAULT_HEADROOM_GB


