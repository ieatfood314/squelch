            f"#panel {{ background: {POPOVER}; border: 1px solid {BORDER};"
            " border-radius: 12px; }")
        lay = QVBoxLayout(self)
        lay.setContentsMargins(0, 0, 0, 0)
        lay.addWidget(panel)
        inner = QVBoxLayout(panel)
        inner.setContentsMargins(16, 16, 16, 16)
        inner.setSpacing(8)

        inner.addWidget(label("Squelch", "title"))
