    def refresh_analytics(self):
        s = summarize_stats(load_stats())
        self.tiles["words"].setText(f"{s['words']:,}")
        self.tiles["wpm"].setText(f"{s['wpm']:.0f}")
        self.tiles["lat"].setText(f"{s['avg_lat']:.2f} s")
        self.tiles["utts"].setText(f"{s['utterances']:,}")
        self.a_recent.setText(
            f"Last hour: {s['recent_wpm']:.0f} WPM · "
            f"{s['recent_words']:,} words · "
            f"last 10 avg {s['recent_lat']:.2f} s"
            if s["recent_n"] else "Nothing in the last hour")
        self.a_table.setRowCount(0)
        for d, w, u, a in s["days"]:
            r = self.a_table.rowCount()
            self.a_table.insertRow(r)
            for col, val in enumerate((d, f"{w:,}", f"{u:,}", f"{a:.1f}")):
                self.a_table.setItem(r, col, QTableWidgetItem(val))

    # ---- open / refresh ----
    def refresh_general(self):
        cur = read_engine()
        for key, rb in self.g_radios.items():
            rb.blockSignals(True)
            rb.setChecked(key == cur)
            rb.blockSignals(False)
        self.g_status.setText(engine_status())
        flt = read_filters()
        for cb, name in ((self.cb_defill, "defiller"),
                         (self.cb_numbers, "numbers"),
                         (self.cb_all, "numbers_all")):
            cb.blockSignals(True)
            cb.setChecked(flt[name])
            cb.blockSignals(False)

    def open(self, tab=0):
        self.refresh_general()
        self.refresh_hotkey()
        self.refresh_insertion()
        self.load_dict()
        self.refresh_or_status()
        self.refresh_analytics()
        self.refresh_headroom()
        self.refresh_setup()
        self.tabs.setCurrentIndex(tab)
        self.show()
        self.raise_()
        self.activateWindow()
        screen = QGuiApplication.screenAt(QCursor.pos())
        if screen is not None:
            geo = screen.availableGeometry()
            self.move(geo.x() + (geo.width() - self.width()) // 2,
                      geo.y() + (geo.height() - self.height()) // 3)
        if not self.refresh_timer.isActive():
            self.refresh_timer.start()

    def keyPressEvent(self, event):
        if event.key() == Qt.Key.Key_Escape:
            self.close()
        else:
            super().keyPressEvent(event)


class MenuKeyWatcher:
    """Passive listener on kanata's output device: a trigger tap (F23)
    pops the tap card. No grabs — the dictation daemon reads alongside."""

    def __init__(self, on_tap):
        self.on_tap = on_tap
        self.dev = None
        self.notifier = None
        self.timer = QTimer()
        self.timer.setInterval(2000)
        self.timer.timeout.connect(self.discover)
        self.discover()

    def find_device(self):
        for path in sorted(os.listdir("/dev/input")):
            if not path.startswith("event"):
                continue
            try:
                d = evdev.InputDevice(os.path.join("/dev/input", path))
            except OSError:
                continue
            if "kanata" not in d.name.lower():
                continue
            try:
                if F23 in d.capabilities().get(evdev.ecodes.EV_KEY, []):
                    return d
            except OSError:
                continue
        return None

    def discover(self):
        if self.dev is not None:
            return
        d = self.find_device()
        if d is None:
            if not self.timer.isActive():
                self.timer.start()
            return
        self.timer.stop()
        self.dev = d
        self.notifier = QSocketNotifier(
            d.fd, QSocketNotifier.Type.Read)
        self.notifier.activated.connect(self.on_activity)

    def on_activity(self):
        try:
            for ev in self.dev.read():
                if (ev.type == evdev.ecodes.EV_KEY and ev.code == F23
                        and ev.value == 1):
                    self.on_tap()
        except OSError:
            self.teardown()
            self.timer.start()

    def teardown(self):
        if self.notifier is not None:
            self.notifier.setEnabled(False)
            self.notifier = None
        self.dev = None


def fallback_icon():
    pm = QPixmap(64, 64)
    pm.fill(QColor(0, 0, 0, 0))
    p = QPainter(pm)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    p.setBrush(QColor(STEEL_FOCUS))
    p.setPen(QColor(0, 0, 0, 0))
    p.drawRoundedRect(20, 6, 24, 32, 12, 12)          # mic head
    p.drawRect(30, 38, 4, 12)                          # stem
    p.drawRect(20, 50, 24, 4)                          # base
    p.end()
    return QIcon(pm)


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Squelch")
    app.setDesktopFileName("squelch")
    app.setQuitOnLastWindowClosed(False)
    app.setStyleSheet(APP_STYLE)

    icon = QIcon.fromTheme("audio-input-microphone")
    if icon.isNull():
        icon = fallback_icon()
    tray = QSystemTrayIcon(icon)
    tray.setToolTip("Squelch")

    menu = QMenu()
    group = QActionGroup(menu)
    group.setExclusive(True)
    actions = {}
    for key, text in ENGINES:
        a = QAction(text, menu, checkable=True)
        a.setData(key)
        a.triggered.connect(lambda _=False, k=key: switch(k))
        group.addAction(a)
        menu.addAction(a)
        actions[key] = a
    menu.addSeparator()
    status_action = QAction("", menu)
    status_action.setEnabled(False)
    menu.addAction(status_action)
    menu.addSeparator()
    settings_action = QAction("Settings", menu)
    settings_action.triggered.connect(lambda: open_settings())
    menu.addAction(settings_action)
    menu.addSeparator()
    quit_action = QAction("Quit tray", menu)
    quit_action.triggered.connect(app.quit)
    menu.addAction(quit_action)

    def switch(key):
        write_engine(key)
        refresh()

    def refresh():
        cur = read_engine()
        for key, a in actions.items():
            a.setChecked(key == cur)
        tray.setToolTip(f"Squelch · {ENGINE_NAMES[cur]}")

    def on_show():
        refresh()
        status_action.setText(engine_status())

    menu.aboutToShow.connect(on_show)
    tray.setContextMenu(menu)

    settings = SettingsWindow(on_engine=switch, on_filters=write_filters)

    def open_settings(tab=0):
        popup.hide()  # single-window policy: settings closes the tap card
        settings.open(tab)

    popup = EnginePopup(on_engine=switch, on_settings=open_settings)

    tap = {"pending": False}
    tap_timer = QTimer()
    tap_timer.setSingleShot(True)
    tap_timer.setInterval(350)

    def on_tap_timeout():
        if not tap["pending"]:
            return
        tap["pending"] = False
        if settings.isVisible():
            settings.close()  # single tap with settings open closes it
        elif popup.isVisible():
            popup.hide()
        else:
            popup.show_at(read_engine(), engine_status())

    tap_timer.timeout.connect(on_tap_timeout)

    def on_menu_tap():
        if tap["pending"]:
            # double tap: straight to settings, tap card stays closed
            tap["pending"] = False
            tap_timer.stop()
            open_settings()
        else:
            tap["pending"] = True
            tap_timer.start()

    app.watcher = MenuKeyWatcher(on_menu_tap)  # keep it alive
    refresh()
    tray.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
