def model_catalog():
    """[(id, engine, label, path, size text)] from squelch-setup-models'
    CATALOG, so the downloadable models are listed in one place."""
    if not _catalog:
        try:
            from importlib.machinery import SourceFileLoader
            import importlib.util as iu
            loader = SourceFileLoader("squelch_setup_models",
                                      setup_models_cmd())
            spec = iu.spec_from_loader("squelch_setup_models", loader)
            m = iu.module_from_spec(spec)
            loader.exec_module(m)
            _catalog.extend((e[0], e[1], e[2], m.model_path(e), m.human(e[4]))
                            for e in m.CATALOG)
