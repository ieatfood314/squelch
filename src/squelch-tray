def _key_tables():
    keys, codes = {}, {}  # evdev code -> (kanata name, label); name -> code
    for row in _KEY_TABLE.strip().splitlines():
        head, lab, aliases = (c.strip() for c in row.split("|"))
        ev, name = head.split()
        code = evdev.ecodes.ecodes["KEY_" + ev]
        keys[code] = (name, lab)
        for n in (name, *aliases.split()):
            codes[n] = code
    regular = [(c, c, c.upper()) for c in "abcdefghijklmnopqrstuvwxyz"]
    regular += [(d, d, d) for d in "0123456789"]
    regular += [(f"F{n}", f"f{n}", f"F{n}") for n in range(1, 25)]
    regular += [(f"KP{n}", f"kp{n}", f"Numpad {n}") for n in range(10)]
    for ev, name, lab in regular:
        code = evdev.ecodes.ecodes["KEY_" + ev.upper()]
        keys[code] = (name, lab)
        codes[name] = code
    return keys, codes


KEYS, KANATA_CODES = _key_tables()


def key_label(code):
    if code in KEYS:
        return KEYS[code][1]
    name = evdev.ecodes.KEY.get(code, f"KEY_{code}")
    name = name[0] if isinstance(name, list) else name
    return name.removeprefix("KEY_").replace("_", " ").title()


def _kanata_forms(text):
    """Top-level kanata forms as (name, [(item text, start, end)]).
    Items are atoms or whole nested lists; comments are skipped."""
    forms, i, n = [], 0, len(text)
    depth, items, start = 0, None, None
    while i < n:
        c = text[i]
        if text.startswith(";;", i):
            i = text.find("\n", i)
            i = n if i < 0 else i
            continue
        if text.startswith("#|", i):
            j = text.find("|#", i + 2)
            i = n if j < 0 else j + 2
            continue
        if c == "(":
            if depth == 0:
                items = []
            elif depth == 1:
                start = i
            depth += 1
        elif c == ")":
            depth -= 1
            if depth == 1 and start is not None:
                items.append((text[start:i + 1], start, i + 1))
                start = None
            elif depth == 0 and items is not None:
                if items:
                    forms.append((items[0][0], items[1:]))
                items = None
        elif not c.isspace() and depth >= 1:
            j = i
            while j < n and not text[j].isspace() and text[j] not in "()":
                j += 1
            if depth == 1:
                items.append((text[i:j], i, j))
            i = j
            continue
        i += 1
    return forms


TRIGGER_RE = re.compile(r"\(\s*tap-hold\s+\d+\s+\d+\s+f23\s+f24\s*\)")


def find_trigger(text):
    """(defsrc key the Squelch tap-hold sits on, its (start, end) span in
    the text, all defsrc keys), or None."""
    forms = _kanata_forms(text)
    src = next((items for name, items in forms if name == "defsrc"), None)
    if src is None:
        return None
    aliases = set()
    for name, items in forms:
        if name == "defalias":
            for k in range(0, len(items) - 1, 2):
                if TRIGGER_RE.fullmatch(items[k + 1][0]):
                    aliases.add("@" + items[k][0])
    for name, items in forms:
        if name != "deflayer" or not items:
            continue
        for idx, (item, _s, _e) in enumerate(items[1:]):
            if (TRIGGER_RE.fullmatch(item) or item in aliases) \
                    and idx < len(src):
                key, s, e = src[idx]
                return key, (s, e), [k for k, _a, _b in src]
    return None


def kanata_trigger():
    """(find_trigger() result, config text) when kanata is installed and
    its config carries the Squelch tap-hold; else the trigger is read
    straight from the keyboard and the result is None."""
    if shutil.which("kanata") is None:
        return None, None
    try:
        with open(KANATA_CFG) as f:
            text = f.read()
    except OSError:
        return None, None
    return find_trigger(text), text


def read_hotkey_file():
    try:
        with open(HOTKEY_FILE) as f:
            name = f.read().strip()
    except OSError:
        return DEFAULT_HOTKEY
    name = LEGACY_HOTKEYS.get(name, name)
    code = evdev.ecodes.ecodes.get(name)
    if name.startswith("KEY_") and isinstance(code, int):
        return code
    return DEFAULT_HOTKEY


def write_hotkey_file(code):
    name = evdev.ecodes.KEY[code]
    name = name[0] if isinstance(name, list) else name
    atomic_write(HOTKEY_FILE, name + "\n")


def read_hotkey():
    """evdev code of the trigger key. The kanata tap-hold wins when there
    is one, and the hotkey file is brought in line with it so squelch-ptt
    doesn't also listen on a second key."""
    found, _text = kanata_trigger()
    code = KANATA_CODES.get(found[0]) if found else None
    if code is None:
        return read_hotkey_file()
    if read_hotkey_file() != code:
        try:
            write_hotkey_file(code)
        except OSError:
            pass
    return code


def apply_hotkey(code):
    """Make `code` the trigger key. With kanata the Squelch tap-hold moves
    to that key; without it squelch-ptt reads the key itself.
    Returns (ok, short message)."""
    if code in (F23, F24):  # pressed the current kanata trigger
        return True, "Already set"
    name = key_label(code)
    found, text = kanata_trigger()
    if found is None:
        if read_hotkey_file() == code:
            return True, "Already set"
        try:
            write_hotkey_file(code)
        except OSError as ex:
            return False, f"Write failed: {ex}"
        return True, f"Trigger is now {name}"
    old, (s, e), src = found
    if KANATA_CODES.get(old) == code:
        write_hotkey_file(code)
        return True, "Already set"
    if code not in KEYS:
        return False, f"kanata can't use {name}"
    if code in {KANATA_CODES.get(k) for k in src}:
        return False, f"{name} is already mapped in kanata"
    backup = KANATA_CFG + ".bak-squelch"
    try:
        shutil.copy(KANATA_CFG, backup)
        atomic_write(KANATA_CFG, text[:s] + KEYS[code][0] + text[e:])
    except OSError as ex:
        return False, f"Write failed: {ex}"
    chk = subprocess.run(["kanata", "--check", "--cfg", KANATA_CFG],
                         capture_output=True, text=True, timeout=30)
    if chk.returncode != 0:
        try:
            shutil.copy(backup, KANATA_CFG)
        except OSError:
            pass
        return False, "kanata rejected it, config restored"
    write_hotkey_file(code)
    rst = subprocess.run(["sudo", "-n", "systemctl", "restart", "kanata"],
                         capture_output=True, text=True, timeout=30)
    if rst.returncode != 0:
        return True, "Saved. Restart kanata to apply"
    return True, f"Trigger is now {name}"


