def read_engine():
    try:
        with open(ENGINE_FILE) as f:
            e = f.read().strip().lower()
        return "whisper" if e == "whisper" else "parakeet"
    except OSError:
        return "parakeet"


def write_engine(e):
    os.makedirs(os.path.dirname(ENGINE_FILE), exist_ok=True)
    with open(ENGINE_FILE, "w") as f:
        f.write(e + "\n")


def service_status():
    out = []
    for name, url in (("parakeet", "http://127.0.0.1:1894/health"),
                      ("whisper", "http://127.0.0.1:1893/")):
        try:
            r = urllib.request.urlopen(url, timeout=1)
            out.append(f"{name}: ok" if r.status == 200 else f"{name}: {r.status}")
        except Exception:
            out.append(f"{name}: down")
    try:
        with open(STATE_FILE) as f:
            st = __import__("json").load(f)
        if st.get("gaming"):
            out.append("game: FULLSCREEN — models unloaded")
    except (OSError, ValueError):
        pass
    return "   ·   ".join(out)


def read_filters():
    try:
        with open(FILTERS_FILE) as f:
            d = __import__("json").load(f)
        return {"defiller": bool(d.get("defiller", True)),
                "numbers": bool(d.get("numbers", True)),
                "numbers_all": bool(d.get("numbers_all", False))}
    except (OSError, ValueError):
        return {"defiller": True, "numbers": True, "numbers_all": False}


def dict_term_count():
    try:
        with open(DICT_FILE) as f:
            return len(__import__("json").load(f).get("entries", []))
    except (OSError, ValueError, AttributeError):
        return 0


def load_stats():
    rows = []
    try:
        with open(STATS_FILE) as f:
            for line in f:
                try:
                    rows.append(_json.loads(line))
                except ValueError:
                    continue
    except OSError:
        pass
    return rows


def summarize_stats(rows, now=None, recent_min=60):
    """Totals + recent WPM + latency + per-day table for the dashboard."""
    import datetime as _dt
    now = now or __import__("time").time()
    ok = [r for r in rows if r.get("outcome") == "ok"]
    words = sum(int(r.get("words", 0)) for r in ok)
    audio = sum(float(r.get("audio_s", 0)) for r in ok)
    lat = [float(r.get("transcribe_s", 0)) for r in ok]
    rec = [r for r in ok if float(r.get("ts", 0)) >= now - recent_min * 60]
    rec_w = sum(int(r.get("words", 0)) for r in rec)
    rec_a = sum(float(r.get("audio_s", 0)) for r in rec)
    last10 = ok[-10:]
    last10_lat = [float(r.get("transcribe_s", 0)) for r in last10]
    days = {}
    for r in ok:
        d = _dt.datetime.fromtimestamp(float(r.get("ts", 0))).date().isoformat()
        e = days.setdefault(d, [0, 0, 0.0])
        e[0] += int(r.get("words", 0))
        e[1] += 1
        e[2] += float(r.get("audio_s", 0))
    day_rows = sorted(days.items(), reverse=True)[:7]
    return {
        "words": words,
        "utterances": len(ok),
        "audio_min": audio / 60,
        "wpm": words * 60 / audio if audio > 0 else 0.0,
        "avg_lat": sum(lat) / len(lat) if lat else 0.0,
        "recent_wpm": rec_w * 60 / rec_a if rec_a > 0 else 0.0,
        "recent_words": rec_w,
        "recent_n": len(rec),
        "recent_lat": (sum(last10_lat) / len(last10_lat)
                       if last10_lat else 0.0),
        "recent_min": recent_min,
        "days": [(d, w, u, a / 60) for d, (w, u, a) in day_rows],
    }


def openrouter_key():
    try:
        with open(OPENROUTER_KEY_FILE) as f:
            return f.read().strip() or None
    except OSError:
        return None


def _or_request(key, method, path, payload=None, timeout=20):
    import urllib.error as _uerr
    data = _json.dumps(payload).encode() if payload is not None else None
    for attempt in range(4):
        req = urllib.request.Request(
            "https://openrouter.ai/api/v1" + path, data=data,
            headers={"Authorization": "Bearer " + key,
                     "Content-Type": "application/json",
                     "HTTP-Referer": "https://localhost/squelch",
                     "X-Title": "Squelch"},
            method=method)
        try:
            with urllib.request.urlopen(req, timeout=timeout) as r:
                return _json.loads(r.read().decode())
        except _uerr.HTTPError as e:
            if e.code == 429 and attempt < 3:
                wait = 5
                try:
                    wait = max(2, int(e.headers.get("Retry-After", 5)))
                except (TypeError, ValueError):
                    pass
                time.sleep(wait)
                continue
            raise


def free_model_candidates(key):
    """Ordered free chat-model ids: cached winner first, then preferred."""
    try:
        with open(OPENROUTER_MODEL_FILE) as f:
            winner = f.read().strip()
        if winner:
            return [winner]
    except OSError:
        pass
    models = _or_request(key, "GET", "/models", timeout=20).get("data", [])
    ids = []
    for m in models:
        mid = m.get("id", "")
        pricing = m.get("pricing") or {}
        if (pricing.get("prompt") == "0"
                and pricing.get("completion") == "0"
                and ":free" in mid
                and not any(b in mid for b in _NON_CHAT)):
            ids.append(mid)
    ids.sort(key=lambda i: next(
        (n for n, p in enumerate(_MODEL_PREFERENCE) if p in i), 99))
    return ids[:8]


def _parse_suggestions(text, term):
    import re as _re
    cands = []
    m = _re.search(r"\[.*?\]", text, _re.DOTALL)
    if m:
        try:
            got = _json.loads(m.group(0))
            if isinstance(got, list):
                cands = got
        except ValueError:
            pass
    if not cands:
        cands = _re.findall(r'"([^"]+)"', text)
    if not cands:
        lines = []
        for ln in text.splitlines():
            lines.extend(_re.split(r"(?<!\S)\d+[.)]\s+", ln))
        cands = [ln.strip("-*• \t\"'") for ln in lines
                 if ln.strip("-*• \t\"'")]
    out = []
    for c in cands:
        if not isinstance(c, str):
            continue
        c = c.strip().lower()
        if (c and c != term.lower() and c not in _EXAMPLE_PHRASES
                and len(c) <= 30
                and len(c.split()) <= 4
                and _re.fullmatch(r"[a-z'’\- ]+", c)
                and c not in out):
            out.append(c)
    return out[:8]


def fetch_mishearings(term):
    """Ask a free OpenRouter model what `term` sounds like. One small call."""
    key = openrouter_key()
    if not key:
        raise RuntimeError("no OpenRouter key")
    prompt = (
        f'You generate training data for a speech-to-text fixer. The user '
        f'dictates the term "{term}" but the recognizer often mishears it. '
        f'List 3 to 8 short phrases (1-4 words each) it could easily be '
        f'misheard as — things that SOUND similar, including splits. '
        f'Lowercase. Invent fresh phrases for THIS term; do not copy the '
        f'example. Reply with ONLY a JSON array of strings, nothing else. '
        f'Example format: {list(_EXAMPLE_PHRASES)}')
    last = None
    for i, model in enumerate(free_model_candidates(key)[:3]):
        if i:
            time.sleep(2)  # be gentle with free-tier rate limits
        try:
            res = _or_request(
                key, "POST", "/chat/completions",
                {"model": model,
                 "messages": [{"role": "user", "content": prompt}],
                 "max_tokens": 200, "temperature": 0.8}, timeout=30)
            msg = (res.get("choices") or [{}])[0].get("message") or {}
            text = msg.get("content") or msg.get("reasoning") or ""
            out = _parse_suggestions(text, term)
            if out:
                try:
                    with open(OPENROUTER_MODEL_FILE, "w") as f:
                        f.write(model)
                except OSError:
                    pass
                return out
            last = "empty result"
        except Exception as e:
            last = e
    raise RuntimeError(f"free models failed ({last})")


def write_filters(flt):
    os.makedirs(os.path.dirname(FILTERS_FILE), exist_ok=True)
    with open(FILTERS_FILE, "w") as f:
        __import__("json").dump(flt, f)


