        d = {}
    look = dict(DEFAULT_LOOK)
    for key, choices in (("accent", ACCENTS), ("size", TEXT_SIZES),
                         ("font", FONTS)):
        if d.get(key) in [c[0] for c in choices]:
            look[key] = d[key]
    try:
        look["opacity"] = min(100, max(0, int(d.get("opacity", 40))))
    except (TypeError, ValueError):
        pass
    return look


