#!/bin/sh
# Squelch: power-cycle a USB mic's port (root only).
#
#   squelch-mic-reset cycle ID   cut VBUS for a few seconds, then restore
#
# ID is the USB device id from sysfs (e.g. 3-1.2.3). Only devices with an
# audio interface are cut; if the device is gone (a cycle that never came
# back), the port is just powered on again.
#
# A USB webcam's audio block can wedge across suspend: the device
# enumerates, video works, but isoch audio delivers a trickle or nothing
# (ALSA read returns EIO). Port resets, usbreset and re-authorizing don't
# help; only losing power clears it. Writing 1 to a port's sysfs "disable"
# attribute sends ClearPortFeature(PORT_POWER), which really cuts VBUS only
# on hubs that do per-port power switching. Most external hubs (docks) do.
# Many motherboard root ports don't (xHCI PPC=0), so on those this is a
# no-op and the device has to be replugged by hand.

SYS=/sys/bus/usb/devices
OFF_SECONDS=${SQUELCH_MIC_OFF_SECONDS:-3}

say() {
    logger -t squelch-mic-reset "$*"
    [ -t 2 ] && echo "$*" >&2
    return 0
}

usage() {
    echo "usage: $0 cycle USB-ID" >&2
    exit 2
}

[ "$1" = cycle ] || usage
id=$2
echo "$id" | grep -Eqx '[0-9]+-[0-9]+(\.[0-9]+)*' || usage

# The port the device hangs off: hub 3-1.2 port 3 for 3-1.2.3, root hub
# usb1 port 8 for 1-8.
case "$id" in
    *.*) hub=${id%.*}; port=${id##*.}
         p="$SYS/$hub/$hub:1.0/$hub-port$port" ;;
    *)   bus=${id%%-*}; port=${id#*-}
         p="$SYS/usb$bus/$bus-0:1.0/usb$bus-port$port" ;;
esac
[ -e "$p/disable" ] || { say "no switchable port for $id"; exit 1; }

port_power() {
    if echo "$1" > "$p/disable" 2>/dev/null; then
        return 0
    fi
    say "failed to write $1 to $p/disable"
    return 1
}

if [ ! -e "$SYS/$id" ]; then
    port_power 0 || exit 1
    say "$id missing, port $(basename "$p") powered on"
    exit 0
fi
grep -qx 01 "$SYS/$id"/"$id":*/bInterfaceClass 2>/dev/null || {
    say "$id has no audio interface, refusing"
    exit 1
}
port_power 1 || exit 1
sleep "$OFF_SECONDS"
port_power 0 || exit 1
say "port $(basename "$p") power-cycled ($id)"
exit 0
