def fix_wayland_env():
    """Point wl-copy/wl-paste at a Wayland socket that actually exists.

    The packaged unit hardcodes wayland-0, which is wrong by the time the
    daemon starts (the session socket is imported after default.target and
    often renumbered across boots), so fall back to the newest existing
    socket in XDG_RUNTIME_DIR if the configured one is missing.
    """
    display = os.environ.get("WAYLAND_DISPLAY", "")
    runtime = os.environ.get("XDG_RUNTIME_DIR", "/run/user/1000")
    if display and os.path.exists(os.path.join(runtime, display)):
        return
    sockets = [s for s in glob.glob(os.path.join(runtime, "wayland-*"))
               if not s.endswith(".lock")]
    if not sockets:
        return
    newest = max(sockets, key=os.path.getmtime)
    chosen = os.path.basename(newest)
    if chosen != display:
        os.environ["WAYLAND_DISPLAY"] = chosen
        log("wayland display not set/valid, using", chosen)


