# Web editors (Word/Office online, Google Docs) handle paste themselves and
# ignore Shift+Insert, so browsers get Ctrl+V. V sits on the same key in
# QWERTY and Colemak, so the keycode still means "v".
CTRL_V_CLASSES = ("zen", "firefox", "librewolf", "floorp", "chromium",
                  "google-chrome", "brave-browser", "vivaldi-stable", "opera")
CTRL_V_PREFIXES = ("crx_",)  # Chromium/Brave installed web apps
PASTE_SHIFT_INSERT = ["42:1", "110:1", "110:0", "42:0"]  # LEFTSHIFT, INSERT
PASTE_CTRL_V = ["29:1", "47:1", "47:0", "29:0"]          # LEFTCTRL, V


def active_window_class():
    """resourceClass of KWin's focused window, or None.

    KWin has no D-Bus getter for the active window, so run a one-shot KWin
    script that prints it (with a unique tag) and read that back from
    kwin_wayland's journal.
    """
    tag = f"squelch-active-{os.getpid()}-{time.monotonic_ns()}"
    since = time.time() - 1
    fd, script = tempfile.mkstemp(suffix=".js")
    with os.fdopen(fd, "w") as f:
        f.write("var w = workspace.activeWindow;\n"
                f"print('{tag} ' + (w ? w.resourceClass : ''));\n")
    qd = ["qdbus6", "--session", "org.kde.KWin"]
    try:
        sid = subprocess.run(
            qd + ["/Scripting", "org.kde.kwin.Scripting.loadScript",
                  script, tag],
            capture_output=True, text=True, timeout=2).stdout.strip()
        if not sid.lstrip("-").isdigit() or int(sid) < 0:
            return None
        subprocess.run(qd + [f"/Scripting/Script{sid}",
                             "org.kde.kwin.Script.run"],
                       capture_output=True, timeout=2)
        subprocess.run(qd + ["/Scripting",
                             "org.kde.kwin.Scripting.unloadScript", tag],
                       capture_output=True, timeout=2)
        deadline = time.time() + 1.0
        while time.time() < deadline:
            out = subprocess.run(
                ["journalctl", "--user", "_COMM=kwin_wayland",
                 f"--since=@{since:.0f}", "-o", "cat", "--no-pager"],
                capture_output=True, text=True, timeout=2).stdout
            for line in out.splitlines():
                if line.startswith(tag):
                    return line[len(tag):].strip().lower() or None
            time.sleep(0.05)
    except Exception as e:
        log("active window lookup failed:", e)
    finally:
        try:
            os.unlink(script)
        except OSError:
            pass
    return None


def paste_text(text):
    """Layout-proof output: clipboard + Shift+Insert (Ctrl+V in browsers).

    Keycode injectors (ydotool type / wtype) emit physical keycodes, which the
    compositor maps through the active layout — under Colemak that mangles
    text. Shift+Insert uses no letter keys, so it pastes correctly under any
    layout. The previous clipboard content is saved and restored.
    """
    fix_wayland_env()
    wclass = active_window_class()
    LAST_APP["class"] = wclass
    if wclass in CTRL_V_CLASSES or (wclass or "").startswith(CTRL_V_PREFIXES):
        chord, chord_name = PASTE_CTRL_V, "Ctrl+V"
    else:
        chord, chord_name = PASTE_SHIFT_INSERT, "Shift+Insert"
    try:
        cur = subprocess.run(["wl-paste"], capture_output=True, timeout=10)
        prev = cur.stdout if cur.returncode == 0 else None
    except Exception as e:
        log("clipboard read failed:", e)
        prev = None
    try:
        subprocess.run(["wl-copy"], input=text.encode("utf-8"),
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       timeout=10, check=True)
    except Exception as e:
        log("clipboard write failed:", e)
        notify_stt("Paste failed", "Couldn't reach the clipboard.",
                   urgency="normal")
        return False
    time.sleep(0.25)
    try:
        r = subprocess.run(["ydotool", "key", *chord],
                           capture_output=True, text=True, timeout=30)
        if r.returncode != 0:
            log("paste keystroke failed:", (r.stderr or "").strip()[:200])
            notify_stt("Paste failed", "Text is on the clipboard.",
                       urgency="normal")
            return False
    except Exception as e:
        log("paste keystroke error:", e)
        notify_stt("Paste failed", "Text is on the clipboard.",
                   urgency="normal")
        return False
    log(f"pasted via clipboard+{chord_name} ({wclass or 'unknown'}):",
        text[:80])
    time.sleep(0.4)
    if prev is not None:
        try:
            subprocess.run(["wl-copy"], input=prev,
                           stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=10)
        except Exception as e:
            log("clipboard restore failed:", e)
    return True


