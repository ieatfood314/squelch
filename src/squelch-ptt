def playing_players():
    """Names of MPRIS players currently playing (empty if none/playerctl)."""
    try:
        r = subprocess.run(["playerctl", "-l"], capture_output=True,
                           text=True, timeout=5)
    except (FileNotFoundError, OSError):
        return []
    except Exception:
        return []
    out = []
    for name in r.stdout.split():
        try:
            s = subprocess.run(["playerctl", "-p", name, "status"],
                               capture_output=True, text=True, timeout=5)
            if s.stdout.strip() == "Playing":
                out.append(name)
        except Exception:
            continue
    return out


def pause_players(names):
    for n in names:
        try:
            subprocess.run(["playerctl", "-p", n, "pause"], timeout=5,
                           stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)
        except Exception:
            pass
    if names:
        log(f"paused music: {', '.join(names)}")


def resume_players(names):
    for n in names:
        try:
            subprocess.run(["playerctl", "-p", n, "play"], timeout=5,
                           stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)
        except Exception:
            pass


def start_recording(target, path):
    return subprocess.Popen(
        ["pw-record", "--target", target, "--rate", str(SR),
         "--channels", str(MIC_CHANNELS), "--format", "s16", path],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def raw_frames(path):
    try:
        with wave.open(path, "rb") as w:
            return w.getnframes()
    except (wave.Error, EOFError, OSError):
        return 0


# pw-record takes ~0.1-0.2 s to attach; a healthy mic fills the rest. A
# wedged mic delivers a few percent of real time, or nothing at all.
CAPTURE_LATENCY_S = 0.3


def capture_dead(path, seconds):
    expected = (seconds - CAPTURE_LATENCY_S) * SR
    return expected > 0 and raw_frames(path) < 0.5 * expected


def probe_mic(seconds=1.5):
    """Record a throwaway clip; True if the mic delivers real-time audio."""
    target = find_mic_target()
    if target is None:
        return False
    fd, path = tempfile.mkstemp(suffix="-probe.wav")
    os.close(fd)
    try:
        proc = start_recording(target, path)
        time.sleep(seconds)
        try:
            proc.send_signal(signal.SIGTERM)
            proc.wait(timeout=5)
        except Exception:
            proc.kill()
        return not capture_dead(path, seconds)
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass


_mic_reset_lock = threading.Lock()


def mic_resetting():
    return _mic_reset_lock.locked()


def recover_mic(reason):
    """A USB mic's audio can wedge across suspend (video keeps working) and
    only losing power clears it. Have the root helper power-cycle its USB
    port, then re-probe; if that didn't take (port can't switch power),
    tell the user to replug instead of eating dictations as "no speech"."""
    if not _mic_reset_lock.acquire(blocking=False):
        return
    try:
        log(f"mic dead ({reason}), power-cycling its USB port")
        notify_stt("Squelch: mic wedged, resetting",
                   "Power-cycling the webcam. Try again in ~15 seconds.",
                   urgency="normal")
        try:
            r = subprocess.run(
                ["systemctl", "start", "--no-ask-password",
                 "squelch-mic-reset.service"],
                capture_output=True, text=True, timeout=30)
            if r.returncode != 0:
                log("squelch-mic-reset failed:", r.stderr.strip())
        except Exception as e:
            log("squelch-mic-reset failed:", e)
        deadline = time.time() + 15
        while find_mic_target() is None and time.time() < deadline:
            time.sleep(1)
        time.sleep(1)
        if probe_mic():
            log("mic recovered")
            notify_stt("Squelch: mic is back",
                       "The webcam was reset. Dictation works again.",
                       urgency="normal")
        else:
            log("mic still dead after port power-cycle")
            notify_stt("Squelch: replug the webcam",
                       "Its mic is dead and power-cycling the USB port "
                       "didn't fix it. Unplug and replug the camera. To make "
                       "this automatic, plug it into a dock or hub port: "
                       "motherboard ports usually can't cut power.",
                       urgency="critical")
    finally:
        _mic_reset_lock.release()


def recover_mic_async(reason):
    threading.Thread(target=recover_mic, args=(reason,), daemon=True).start()


def suspended_seconds():
    return (time.clock_gettime(time.CLOCK_BOOTTIME)
            - time.clock_gettime(time.CLOCK_MONOTONIC))


def watch_resume():
    """Probe the mic after every suspend, so a wedge gets fixed (or
    reported) before the next dictation instead of during it."""
    last = suspended_seconds()
    while True:
        time.sleep(5)
        if suspended_seconds() - last < 2:
            continue
        time.sleep(10)  # let the sleep hook, USB and PipeWire settle
        last = suspended_seconds()
        if probe_mic():
            log("mic ok after resume")
        else:
            recover_mic("after resume")


