def hotkey_code():
    """evdev code of the trigger key from ~/.config/squelch/hotkey."""
    try:
        with open(HOTKEY_FILE) as f:
            name = f.read().strip()
    except OSError:
        name = ""
    name = LEGACY_HOTKEYS.get(name, name)
    code = evdev.ecodes.ecodes.get(name)
    if name.startswith("KEY_") and isinstance(code, int):
        return code
    return evdev.ecodes.KEY_COMPOSE


class Keyboards:
    """Every input device that can send the trigger key (or kanata's F24),
    read without grabbing. Rescanned for hotplug and hotkey changes."""

    def __init__(self):
        self.devs = {}       # path -> InputDevice
        self.skipped = set()  # paths that can't send our keys
        self.code = None

    def scan(self):
        """Pick up new devices; True if the trigger key changed (every
        device is reopened then)."""
        code = hotkey_code()
        changed = code != self.code
        if changed:
            if self.code is not None:
                log(f"trigger key is now {evdev.ecodes.KEY.get(code, code)}")
            self.close()
            self.code = code
        override = os.environ.get("STT_INPUT_DEVICE")
        paths = [override] if override else glob.glob("/dev/input/event*")
        for path in paths:
            if path in self.devs or path in self.skipped:
                continue
            try:
                d = evdev.InputDevice(path)
                keys = d.capabilities().get(evdev.ecodes.EV_KEY, [])
            except OSError:
                continue
            # ydotoold's virtual keyboard is our own paste
            if not override and ("ydotoold" in d.name.lower() or
                                 (code not in keys and F24 not in keys)):
                d.close()
                self.skipped.add(path)
                continue
            self.devs[path] = d
            log(f"listening on {path} ({d.name})")
        # a path can come back as another device after an unplug
        self.skipped &= set(paths)
        return changed

    def drop(self, path):
        d = self.devs.pop(path, None)
        if d is not None:
            log(f"lost {path}")
            try:
                d.close()
            except OSError:
                pass

    def close(self):
        for d in self.devs.values():
            try:
                d.close()
            except OSError:
                pass
        self.devs.clear()
        self.skipped.clear()


def notify_engine_down():
    if engine_available():
        return False
    notify_stt(f"{BRAND} paused",
               "Models are unloaded while a game is fullscreen."
               if gaming() else "Speech engine isn't running.")
    return True


def gaming():
    try:
        with open(STATE_FILE) as f:
            return bool(json.load(f).get("gaming"))
    except (OSError, ValueError, AttributeError):
        return False


def process_utterance(raw_path, record=True, max_s=None, source=None,
                      info_out=None, cut=False):
    """DSP + transcribe + clean up text. record=False skips stats, the
    archive and vocabulary learning (for --process). Deletes raw_path.
    info_out (a dict) gets the utterance's archive id and engine, and for
    a clip that was cut (it starts mid-speech) how sure Parakeet was of
    the first word."""
    t0 = time.time()
    with tempfile.NamedTemporaryFile(suffix="-clean.wav",
                                     delete=False) as f:
        clean_path = f.name
    stats = log_stats if record else (lambda _entry: None)
    try:
        info = beamform_and_clean(raw_path, clean_path, max_s=max_s,
                                  source=source)
        if info is None:
            log("utterance empty after cleanup, skipping")
            stats({"outcome": "skipped", "engine": current_engine(),
                   "audio_s": 0.0, "words": 0, "transcribe_s": 0.0,
                   "dsp_s": round(time.time() - t0, 3)})
            return ""
        log(f"cleaned {info['seconds']:.2f}s in {time.time()-t0:.2f}s")
        t1 = time.time()
        engine = current_engine(info["seconds"])
        first_p = None
        try:
            if cut and engine == "parakeet":
                text, words = transcribe_parakeet(clean_path, words=True)
                text = clean_text(text)
                if text and words:
                    first_p = round(float(words[0][1]), 3)
            else:
                text = transcribe(clean_path, engine)
        except Exception as e:
            log(f"[{engine}] transcribe failed: {e}")
            if not notify_engine_down():
                notify_stt("Transcription failed", str(e)[:120],
                           urgency="normal")
            stats({"outcome": "failed", "engine": engine,
                   "audio_s": round(info["seconds"], 2), "words": 0,
                   "transcribe_s": 0.0,
                   "dsp_s": round(time.time() - t0, 3)})
            return ""
        transcribe_s = time.time() - t1
        text = tidy(text)
        log(f"[{engine}] transcribed in {transcribe_s:.2f}s: {text[:120]!r}")
        if first_p is not None and info_out is not None:
            info_out["first_p"] = first_p
        if record:
            meta = {"ts": t0, "engine": engine,
                    "audio_s": round(info["seconds"], 2),
                    "words": len(text.split()), "text": text}
            if first_p is not None:
                meta.update(cut=True, first_p=first_p)
            uid = archive_utterance(raw_path, clean_path, meta)
            if info_out is not None:
                info_out.update(id=uid, ts=t0, engine=engine)
            maybe_adapt_vocab(text)
        stats({"outcome": "ok" if text else "empty", "engine": engine,
               "audio_s": round(info["seconds"], 2),
               "words": len(text.split()),
               "transcribe_s": round(transcribe_s, 3),
               "dsp_s": round(time.time() - t0, 3)})
        return text
    finally:
        for p in (raw_path, clean_path):
            try:
                os.unlink(p)
            except OSError:
                pass


def headroom_mb():
    """VRAM to leave free, from ~/.config/squelch/vram.json (GB)."""
    try:
        with open(VRAM_FILE) as f:
            gb = float(json.load(f).get("headroom_gb", DEFAULT_HEADROOM_GB))
        return max(0.0, gb) * 1024
    except (OSError, ValueError, TypeError, AttributeError):
        return DEFAULT_HEADROOM_GB * 1024


def max_hold_s(engine):
    """Longest recording to allow for engine right now."""
    if engine != "parakeet":
        return STUCK_KEY_S
    try:
        url = f"{PARAKEET_LIMITS_URL}?headroom_mb={headroom_mb():.0f}"
        with urllib.request.urlopen(url, timeout=1) as r:
            fit = float(json.loads(r.read())["max_seconds"])
    except Exception as e:
        log("free VRAM unknown, using the fallback cap:", e)
        return FALLBACK_CAP_S
    return min(STUCK_KEY_S, max(MIN_CAP_S, fit))


