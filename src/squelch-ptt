def _json_load_list(f):
    import json as _j
    return [str(x) for x in _j.load(f).get("auto_terms", [])]


def aspell_unknown(words):
    """Words aspell doesn't know (empty set on any failure -> mine nothing)."""
    try:
        p = subprocess.run(["aspell", "-a", "--lang=en_US"],
                           input="\n".join(words) + "\n",
                           capture_output=True, text=True, timeout=30)
    except Exception:
        return set()
    out = set()
    for line in p.stdout.splitlines():
        if line.startswith(("&", "#")):
            parts = line.split()
            if len(parts) >= 2:
                out.add(parts[1].lower())
    return out


def mine_vocab():
    """Learn your vocabulary: frequent non-dictionary words you actually say
    become Whisper prompt terms. Runs in-process, no network, no GPU needed."""
    try:
        with open(TRANSCRIPTS_FILE) as f:
            rows = f.readlines()[-400:]
    except OSError:
        return
    counts = {}
    for line in rows:
        try:
            parsed = json.loads(line)
            text = parsed.get("text", "") if isinstance(parsed, dict) else ""
        except (ValueError, AttributeError):
            continue
        for w in re.findall(r"[a-zA-Z']{4,}", text.lower()):
            w = w.strip("'")
            if len(w) >= 4 and w not in STOPWORDS:
                counts[w] = counts.get(w, 0) + 1
    frequent = sorted([w for w, c in counts.items() if c >= 3])
    if not frequent:
        return
    unknown = aspell_unknown(frequent)
    terms, _subs = load_dictionary()
    known = {t.lower() for t in terms}
    auto = sorted(w for w in unknown if w not in known)[:48]
    try:
        os.makedirs(os.path.dirname(VOCAB_FILE), exist_ok=True)
        with open(VOCAB_FILE, "w") as f:
            json.dump({"auto_terms": auto, "updated": time.time()}, f)
        _vocab_cache.update(mtime=os.path.getmtime(VOCAB_FILE), auto=auto)
    except OSError as e:
        log("vocab write failed:", e)
        return
    if auto:
        log(f"vocab mining: {len(auto)} auto terms (e.g. {', '.join(auto[:5])})")


