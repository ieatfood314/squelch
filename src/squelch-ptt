def start_recording(target, path):
    """pw-record from target (None: the default source)."""
    cmd = ["pw-record", "--rate", str(SR), "--channels", str(MIC_CHANNELS),
           "--format", "s16", path]
    if target:
        cmd[1:1] = ["--target", target]
