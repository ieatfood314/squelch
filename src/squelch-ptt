def nas_available():
    """True if the NAS archive is writable (cached a few minutes either way)."""
    now = time.time()
    if now - _nas_state["checked"] < 300 and _nas_state.get("seen", False):
        return _nas_state["ok"]
    ok = False
    try:
        os.makedirs(os.path.join(NAS_ROOT, "raw"), exist_ok=True)
        os.makedirs(os.path.join(NAS_ROOT, "clean"), exist_ok=True)
        ok = os.access(os.path.join(NAS_ROOT, "raw"), os.W_OK)
    except OSError as e:
        log("nas unavailable:", e)
    _nas_state.update(ok=ok, checked=now, seen=True)
    return ok


def archive_utterance(raw_wav, clean_wav, meta):
    """Spool wavs locally now (fast), upload to NAS in background."""
    if os.environ.get("STT_NO_STATS"):
        return
    global _spool_counter
    try:
        os.makedirs(SPOOL_DIR, exist_ok=True)
        names = sorted(os.listdir(SPOOL_DIR))
        while len(names) > 300:  # keep spool bounded if NAS is away
            try:
                os.unlink(os.path.join(SPOOL_DIR, names.pop(0)))
            except OSError:
                break
        stamp = time.strftime("%Y%m%d-%H%M%S", time.localtime(meta["ts"]))
        _spool_counter += 1
        base = f"{stamp}-{os.getpid()}-{_spool_counter}"
        for src, ext in ((raw_wav, ".raw.wav"), (clean_wav, ".clean.wav")):
            if src and os.path.exists(src):
                shutil.copy(src, os.path.join(SPOOL_DIR, base + ext))
        with open(os.path.join(SPOOL_DIR, base + ".json"), "w") as f:
            json.dump(meta, f)
    except OSError as e:
        log("spool failed:", e)
        return
    threading.Thread(target=upload_spool, daemon=True).start()


def upload_spool():
    if not _spool_lock.acquire(blocking=False):
        return  # another uploader is working
    try:
        if not nas_available():
            return
        try:
            names = sorted(os.listdir(SPOOL_DIR))
        except OSError:
            return
        for name in names:
            if not name.endswith(".json"):
                continue
            base = name[:-5]
            try:
                with open(os.path.join(SPOOL_DIR, name)) as f:
                    meta = json.load(f)
                day = time.strftime("%Y%m%d", time.localtime(meta["ts"]))
                for ext, sub in ((".raw.wav", "raw"), (".clean.wav", "clean")):
                    src = os.path.join(SPOOL_DIR, base + ext)
                    if os.path.exists(src):
                        d = os.path.join(NAS_ROOT, sub, day)
                        os.makedirs(d, exist_ok=True)
                        shutil.copy(src, os.path.join(d, base + ext))
                        os.unlink(src)
                with open(os.path.join(NAS_ROOT, "transcripts.jsonl"),
                          "a") as f:
                    f.write(json.dumps({
                        "ts": meta["ts"], "engine": meta.get("engine"),
                        "words": meta.get("words"),
                        "audio_s": meta.get("audio_s"),
                        "text": meta.get("text", "")}) + "\n")
                os.unlink(os.path.join(SPOOL_DIR, name))
            except (OSError, ValueError) as e:
                log("spool upload issue (will retry):", e)
                return
    finally:
        _spool_lock.release()


