# ---------------- always-open mic ----------------
# A hold used to start its own pw-record, and the start of a sentence
# said as the key went down was lost: kanata (or HOLD_DELAY_S) only calls
# it a hold 0.25 s after the press, and PipeWire suspends an idle mic
# after 5 s, which pw-record then takes ~0.3 s to wake. So one pw-record
# stays open on the mic, the tap keeps its last TAP_KEEP_S in memory, and
# each hold's clip starts PREROLL_S before the key went down. If you were
# already talking then, the clip goes back to the pause before you started
# (speech_onset), as far back as the tap remembers.
PREROLL_S = 0.3      # audio kept from before the press
TAP_KEEP_S = 5.0     # how far back the tap remembers
TAP_STALE_S = 2.0    # no audio for this long: the tap's stream is gone
TAP_FLUSH_S = 0.25   # on release, wait up to this for audio still in flight
FRAME_BYTES = 2 * MIC_CHANNELS
ONSET_HOP = SR // 50  # 20 ms frames for finding where speech began
ONSET_PAUSE = 15      # frames (0.3 s) of quiet before a sentence starts
ONSET_KEEP = 5        # frames (0.1 s) of that quiet kept in the clip


def frame_rms(pcm):
    """RMS of each 20 ms frame of interleaved s16 mic audio, channels
    averaged."""
    a = np.frombuffer(bytes(pcm), dtype=np.int16)
    a = a[:len(a) - len(a) % MIC_CHANNELS].reshape(-1, MIC_CHANNELS)
    a = a.astype(np.float32).mean(axis=1)
    n = len(a) // ONSET_HOP
    frames = a[len(a) - n * ONSET_HOP:].reshape(n, ONSET_HOP)
    return np.sqrt((frames ** 2).mean(axis=1))


def speech_onset(ring, back, limit, noise=None):
    """Where a clip that would start `back` bytes before the end of the
    tap's ring should start instead: if speech is under way there, at the
    pause before it, no further back than `limit` bytes. Returns (bytes
    back, cut): cut is True when the speech goes back further than the
    ring does, so its start is lost. noise: the room's level when quiet,
    for a ring that is all speech."""
    rms = frame_rms(ring)
    n = len(rms)
    if n < 25:
        return back, False
    floor, loud = np.percentile(rms, 10), np.percentile(rms, 95)
    if noise:
        floor = min(floor, noise)
    thr = max(floor * 3.0, floor + (loud - floor) * 0.2, 60.0)
    speech = rms > thr
    fb = ONSET_HOP * FRAME_BYTES
    start = n - back // fb   # the frame the clip starts at now
    stop = max(0, n - limit // fb)  # the earliest frame it may start at
    if start >= n or not speech[max(stop, start - 2):start + 3].any():
        return back, False
    quiet, i = 0, start
    while i > stop:
        i -= 1
        quiet = 0 if speech[i] else quiet + 1
        if quiet >= ONSET_PAUSE:
            onset = min(start, i + quiet - ONSET_KEEP)
            return max(back, (n - onset) * fb), False
    return max(back, limit), stop == 0


def wav_header(data_bytes):
    """pw-record's 44-byte header for a 16-bit clip of data_bytes. 0
    while the clip still grows (read_growing_wav reads to the end)."""
    return struct.pack("<4sI4s4sIHHIIHH4sI", b"RIFF", 36 + data_bytes,
                       b"WAVE", b"fmt ", 16, 1, MIC_CHANNELS, SR,
                       SR * FRAME_BYTES, FRAME_BYTES, 16, b"data",
                       data_bytes)


class MicTap:
    """The always-open pw-record, and the hold it's writing to (if any)."""

    STALE = "stale"  # node of a tap that must reopen

    def __init__(self):
        self.lock = threading.Lock()
        self.proc = None
        self.target = None
        self.node = None         # the mic node's serial when it opened
        self.ring = bytearray()  # the last TAP_KEEP_S of audio
        self.t_end = 0.0         # when the newest of it arrived
        self.sink = None         # file of the hold being recorded
        self.last_stop = 0.0     # when the last hold's clip ended
        self.fresh = threading.Condition(self.lock)  # new audio arrived
        self.noise = None        # the room's level between words

    def ensure(self, target, node=None):
        """Have the tap open on target (None: the default source), whose
        node has serial node. True if it already was, so it remembers the
        moments before the press. A stream left over from before the mic
        was replugged can stay linked to something that feeds it silence
        (2026-11-19: zeros through EasyEffects after the C920's hub
        dropped), and it looks alive, so a new node reopens it too."""
        with self.lock:
            if (self.proc is not None and self.proc.poll() is None
                    and self.target == target
                    and (node is None or self.node == node)
                    and time.time() - self.t_end < TAP_STALE_S):
                return True
            if (self.proc is not None and self.proc.poll() is None
                    and self.target == target and node is not None):
                log("last clip was all zeros, reopening the mic stream"
                    if self.node is MicTap.STALE else
                    f"mic node changed ({self.node} -> {node}), "
                    "reopening the mic stream")
            old = self.proc
            cmd = ["pw-record", "--raw", "--rate", str(SR), "--channels",
                   str(MIC_CHANNELS), "--format", "s16", "--latency", "50ms",
                   "-P", f"{{ application.name = {BRAND}, "
                         f"node.description = \"{BRAND} dictation\""
                         + (", node.dont-reconnect = true" if target else "")
                         + " }", "-"]
            if target:
                cmd[1:1] = ["--target", target]
            self.proc = subprocess.Popen(cmd, stdout=subprocess.PIPE,
                                         stderr=subprocess.DEVNULL,
                                         bufsize=0)
            self.target, self.ring, self.t_end = target, bytearray(), time.time()
            self.node = node
            threading.Thread(target=self.read, args=(self.proc,),
                             daemon=True).start()
        if old is not None:
            threading.Thread(target=self.close, args=(old,),
                             daemon=True).start()
        return False

    def stale(self):
        """The tap delivered a clip of exact zeros: have watch() open a
        fresh stream before the next press, whatever fed it silence."""
        with self.lock:
            self.node = MicTap.STALE

    @staticmethod
    def close(proc):
        stop_recording(proc)
        try:
            proc.stdout.close()
        except OSError:
            pass

    def watch(self):
        """Reopen a stream that died (mic replugged, PipeWire restarted)
        or follow a new mic from Settings before the next press needs it."""
        while True:
            time.sleep(5)
            if not mic_resetting() and self.sink is None:
                mic = find_mic()
                if mic is not None:
                    self.ensure(mic["target"], mic["serial"])

    def read(self, proc):
        rest = b""
        while True:
            try:
                d = proc.stdout.read(65536)
            except (OSError, ValueError):
                d = b""
            if not d:
                return
            d = rest + d
            cut = len(d) - len(d) % FRAME_BYTES
            d, rest = d[:cut], d[cut:]
            try:  # the quietest frame lately, rising slowly
                q = float(frame_rms(d).min())
                self.noise = (q if self.noise is None
                              else min(self.noise * 1.002, max(q, 1.0)))
            except ValueError:
                pass  # less than a frame
            with self.lock:
                if self.proc is not proc:
                    return
                self.ring += d
                keep = int(TAP_KEEP_S * SR) * FRAME_BYTES
                if len(self.ring) > keep:
                    del self.ring[:len(self.ring) - keep]
                self.t_end = time.time()
                self.fresh.notify_all()
                if self.sink is not None:
                    try:
                        self.sink.write(d)
                        self.sink.flush()
                    except (OSError, ValueError):
                        pass

    def begin(self, path, since):
        """Write the tap to a new WAV at path from wall-clock time since,
        as far back as it remembers, but not into the last hold's clip,
        or earlier if speech was already under way then. Returns the
        TapHold."""
        with self.lock:
            limit = int(max(0.0, self.t_end - self.last_stop) * SR) * FRAME_BYTES
            limit = min(limit, len(self.ring))
            since = max(since, self.last_stop)
            back = int(max(0.0, self.t_end - since) * SR) * FRAME_BYTES
            back = min(back, limit)
            cut = False
            if back:
                try:
                    nominal = back
                    back, cut = speech_onset(self.ring, back, limit,
                                             self.noise)
                    if back > nominal:
                        log(f"already talking at the press: clip starts "
                            f"{(back - nominal) / FRAME_BYTES / SR:.1f}s "
                            "earlier" + (", start still cut off" if cut else ""))
                except Exception as e:
                    log("speech onset failed:", e)
            f = open(path, "wb")
            f.write(wav_header(0))
            if back:
                f.write(self.ring[-back:])
            f.flush()
            self.sink = f
            return TapHold(self, f, back / FRAME_BYTES / SR, cut)


class TapHold:
    """One hold's share of the tap; poll() and stop() like the pw-record
    a hold used to have."""

    def __init__(self, tap, f, pre_s, cut=False):
        self.tap, self.f, self.pre_s, self.cut = tap, f, pre_s, cut

    def poll(self):
        tap = self.tap
        live = (tap.sink is self.f and tap.proc is not None
                and tap.proc.poll() is None)
        return None if live else 0

    def stop(self):
        """End the clip with the audio up to now, some of which is still on
        its way through pw-record and the pipe."""
        tap, t = self.tap, time.time()
        with tap.lock:
            deadline = t + TAP_FLUSH_S
            while (tap.sink is self.f and tap.t_end < t
                   and time.time() < deadline):
                tap.fresh.wait(deadline - time.time())
            if tap.sink is self.f:
                tap.sink = None
                tap.last_stop = t
            if self.f.closed:
                return
            try:
                size = self.f.tell() - WAV_HEADER
                self.f.seek(0)
                self.f.write(wav_header(size))
            except (OSError, ValueError):
                pass
            self.f.close()


def raw_frames(path):
    try:
        with wave.open(path, "rb") as w:
            return w.getnframes()
    except (wave.Error, EOFError, OSError):
        return 0


# A healthy mic loses ~0.3 s while pw-record wakes it from suspend, and a
# C920 up to ~1.1 s on its first stream after a long idle or a power-cycle.
# A wedged mic delivers a few percent of real time, or nothing at all. So
# only judge clips of JUDGE_MIN_S or more, and only below a quarter of real
# time; short holds right after idle used to trip a needless reset.
JUDGE_MIN_S = 2.0


def capture_dead(path, seconds):
    return seconds >= JUDGE_MIN_S and raw_frames(path) < 0.25 * seconds * SR


def probe_mic(seconds=2.5):
    """Record a throwaway clip; True if the mic delivers real-time audio."""
    mic = find_mic()
    if mic is None:
        return False
    fd, path = tempfile.mkstemp(suffix="-probe.wav")
    os.close(fd)
    try:
        proc = start_recording(mic["target"], path)
        time.sleep(seconds)
        stop_recording(proc)
        return not capture_dead(path, seconds)
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass


_mic_reset_lock = threading.Lock()


def mic_resetting():
    return _mic_reset_lock.locked()


def recover_mic(reason):
    """A USB mic's audio can wedge across suspend (video keeps working) and
    only losing power clears it. Have the root helper power-cycle its USB
    port, then re-probe; if that didn't take (port can't switch power, or
    the mic isn't USB), tell the user to replug instead of eating
    dictations as "no speech"."""
    if not _mic_reset_lock.acquire(blocking=False):
        return
    try:
        mic = find_mic()
        usb = (mic or {}).get("usb") or _last_mic_usb["id"]
        if usb is None:
            log(f"mic dead ({reason}), not a USB device: can't reset it")
            notify_stt("Mic not responding", "Check the mic in Settings.",
                       urgency="critical")
            return
        log(f"mic dead ({reason}), power-cycling USB device {usb}")
        notify_stt("Resetting mic", "Try again in 15 s.", urgency="normal")
        try:
            r = subprocess.run(
                ["systemctl", "start", "--no-ask-password",
                 f"squelch-mic-reset@{usb}.service"],
                capture_output=True, text=True, timeout=30)
            if r.returncode != 0:
                log("squelch-mic-reset failed:", r.stderr.strip())
        except Exception as e:
            log("squelch-mic-reset failed:", e)
        deadline = time.time() + 15
        while find_mic() is None and time.time() < deadline:
            time.sleep(1)
        time.sleep(2)  # PipeWire needs a moment before the node records
        if probe_mic():
            log("mic recovered")
            notify_stt("Mic is back", "Dictation works again.",
                       urgency="normal")
        else:
            log("mic still dead after port power-cycle")
            notify_stt("Mic still dead", "Unplug it and plug it back in.",
                       urgency="critical")
    finally:
        _mic_reset_lock.release()


def recover_mic_async(reason):
    threading.Thread(target=recover_mic, args=(reason,), daemon=True).start()


def suspended_seconds():
    return (time.clock_gettime(time.CLOCK_BOOTTIME)
            - time.clock_gettime(time.CLOCK_MONOTONIC))


def watch_resume():
    """Probe the mic after every suspend, so a wedge gets fixed (or
    reported) before the next dictation instead of during it."""
    last = suspended_seconds()
    while True:
        time.sleep(5)
        if suspended_seconds() - last < 2:
            continue
        time.sleep(10)  # let the sleep hook, USB and PipeWire settle
        last = suspended_seconds()
        if probe_mic():
            log("mic ok after resume")
        else:
            recover_mic("after resume")


