MIC_CHANNELS = 2
# Idle room after cleanup sits well under these (C920 at its +50 dB
# hardware gain: raw peak ~1800, rms ~350); real speech at the desk is far
# louder. Below both, the clip is silence and whisper would hallucinate.
QUIET_PEAK = 3000.0
QUIET_RMS = 500.0
USB_ID_RE = re.compile(r"^\d+-\d+(\.\d+)*$")
# The last USB device seen behind the mic, so a reset can still find its
# port after the mic has dropped out of PipeWire.
_last_mic_usb = {"id": None}


def configured_mic():
    """Node name (or a name/description substring) from
    ~/.config/squelch/mic, or None for PipeWire's default source."""
    try:
        with open(MIC_FILE) as f:
            return f.read().strip() or None
    except OSError:
        return None


def usb_id_of(props):
    """USB device id (e.g. 3-1.2.3) behind an ALSA source, or None."""
    m = re.search(r":(\d+)$", str(props.get("api.alsa.path", "")))
    card = props.get("alsa.card") or (m.group(1) if m else None)
    if card is None:
        return None
    dev = os.path.realpath(f"/sys/class/sound/card{card}/device")
    name = os.path.basename(dev)
    if ":" in name:  # an interface (3-1.2.3:1.2); its parent is the device
        name = os.path.basename(os.path.dirname(dev))
    return name if USB_ID_RE.match(name) else None


# Virtual sources (EasyEffects, echo-cancel, filter chains) sit between
# the recording and a hardware mic, which is the one a mute would be on.
SOURCE_CLASSES = ("Audio/Source", "Audio/Source/Virtual")


def pw_objects():
    """pw-dump's object list, or None if PipeWire can't be read."""
    try:
        out = subprocess.run(
            ["pw-dump"], capture_output=True, timeout=10).stdout
        objs = json.loads(out)
        return [o for o in objs if isinstance(o, dict)]
    except Exception as e:
        log("pw-dump failed:", e)
        return None


def node_muted(info):
    return any(isinstance(x, dict) and x.get("mute")
               for x in (info.get("params") or {}).get("Props") or [])


def find_mic():
    """{"target": node name or None, "usb": USB id or None, "id": node id
    or None, "serial": its object.serial or None, "muted": bool,
    "virtual": bool, "desc": str} for the mic to record from, or None if
    the configured mic is missing. Target None means PipeWire's default
    source. Virtual: not a hardware device, so the real mic is somewhere
    upstream of it. A replugged mic comes back as a new node with a new
    serial (ids are reused, serials never are)."""
    want = configured_mic()
    objs = pw_objects()
    if objs is None:
        return None if want else {"target": None, "usb": None, "id": None,
                                  "serial": None, "muted": False,
                                  "virtual": False, "desc": ""}
    sources, default = [], None
    for o in objs:
        info = o.get("info") or {}
        if o.get("type", "").endswith(":Metadata"):
            for item in o.get("metadata") or []:
                if item.get("key") == "default.audio.source":
                    v = item.get("value")
                    default = v.get("name") if isinstance(v, dict) else None
        props = info.get("props") or {}
        if props.get("media.class") in SOURCE_CLASSES:
            sources.append(dict(props, **{"squelch.id": o.get("id"),
                                          "squelch.muted": node_muted(info)}))
    pick = None
    if want:
        pick = next((p for p in sources if p.get("node.name") == want), None)
        if pick is None:
            pick = next((p for p in sources
                         if want in str(p.get("node.name", ""))
                         or want in str(p.get("node.description", ""))), None)
        if pick is None:
            return None
    elif default:
        pick = next((p for p in sources if p.get("node.name") == default),
                    None)
    usb = usb_id_of(pick) if pick else None
    if usb:
        _last_mic_usb["id"] = usb
    return {"target": pick.get("node.name") if want else None, "usb": usb,
            "id": pick.get("squelch.id") if pick else None,
            "serial": pick.get("object.serial") if pick else None,
            "muted": bool(pick and pick.get("squelch.muted")),
            "virtual": bool(pick and "device.id" not in pick),
            "desc": (pick.get("node.description") or pick.get("node.name")
                     or "") if pick else ""}


def unmute_node(node_id):
    """Holding the trigger means the user wants the mic, so undo a mute
    (a stray Mic Mute key otherwise turns every dictation into silence)."""
    try:
        r = subprocess.run(["wpctl", "set-mute", str(node_id), "0"],
                           capture_output=True, text=True, timeout=5)
        ok = r.returncode == 0
    except Exception as e:
        ok, r = False, e
    if ok:
        log(f"mic {node_id} was muted, unmuted it")
        notify_stt("Mic was muted", "Unmuted it.", urgency="normal")
    else:
        log("couldn't unmute the mic:", getattr(r, "stderr", r))


def upstream_mics(objs, node_id):
    """Hardware sources feeding node_id, as {node id: muted}. Follows
    links upstream, and hops across a node.link-group: loopbacks, filter
    chains, echo-cancel and EasyEffects pass audio from their capture
    stream to their source in-process, with no link between the two."""
    nodes = {o.get("id"): o.get("info") or {} for o in objs
             if o.get("type", "").endswith(":Node")}
    feeds, groups = {}, {}
    for o in objs:
        if o.get("type", "").endswith(":Link"):
            info = o.get("info") or {}
            feeds.setdefault(info.get("input-node-id"), set()).add(
                info.get("output-node-id"))
    for nid, info in nodes.items():
        group = (info.get("props") or {}).get("node.link-group")
        if group:
            groups.setdefault(group, set()).add(nid)
    found, seen, todo = {}, {node_id}, [node_id]
    while todo:
        nid = todo.pop()
        group = (nodes.get(nid, {}).get("props") or {}).get("node.link-group")
        for up in feeds.get(nid, set()) | groups.get(group, set()):
            if up in seen or up not in nodes:
                continue
            seen.add(up)
            props = nodes[up].get("props") or {}
            if (props.get("media.class") in SOURCE_CLASSES
                    and "device.id" in props):
                found[up] = node_muted(nodes[up])
            else:
                todo.append(up)
    return found


def check_upstream(mic, proc, source):
    """Unmute the hardware mic behind a virtual source. Filters often
    link it only while something records, so look once recording runs.
    Sets source["fed"]: whether any hardware mic feeds the source."""
    for _ in range(4):
        time.sleep(0.4)
        if proc.poll() is not None:
            return
        objs = pw_objects()
        found = upstream_mics(objs, mic["id"]) if objs else {}
        if found:
            source["fed"] = True
            for node_id, muted in found.items():
                if muted:
                    unmute_node(node_id)
            return
    source["fed"] = False


# ---------------- DSP: mic-pair beamform + monitor-diffraction comp ----------------

def fast_len(n):
    """Smallest 2^a 3^b 5^c >= n: FFTs of awkward clip lengths (a large
    prime factor) are many times slower, which live passes feel."""
    best, p2 = 1 << max(0, (n - 1).bit_length()), 1
    while p2 < best:
        p3 = p2
        while p3 < best:
            p5 = p3
            while p5 < n:
                p5 *= 5
            best = min(best, p5)
            p3 *= 3
        p2 *= 2
    return best


def gcc_phat_lag(sig, ref, max_shift=8):
    n = fast_len(len(sig))  # padded to a fast FFT length
    S = np.fft.rfft(sig - sig.mean(), n)
    R = np.fft.rfft(ref - ref.mean(), n)
    cross = S * np.conj(R)
    cross /= (np.abs(cross) + 1e-9)  # phase transform: robust to mic gain mismatch
    corr = np.fft.irfft(cross, n)
    # check lags in [-max_shift, +max_shift] (wraparound indexing)
    best_lag, best_val = 0, float("-inf")
    for lag in range(-max_shift, max_shift + 1):
        v = corr[lag % n]
        if v > best_val:
            best_val, best_lag = v, lag
    return best_lag


def beamform_and_clean(path_in, path_out, sr=SR, max_s=None, source=None,
                       quiet=False):
    """Delay-and-sum the raw capsules, HP filter, HF shelf to compensate
    monitor-edge diffraction loss, gate room noise, normalize, trim.
    Only the first max_s seconds are used when given. source is the
    hold's source info, for explaining a silent recording. quiet skips
    logs and notifications (live partials)."""
    with wave.open(path_in, "rb") as w:
        nch, rate, nframes = (w.getnchannels(), w.getframerate(),
                              w.getnframes())
        raw = w.readframes(nframes)
    if nframes < sr // 4:  # < 250 ms of audio: nothing useful
        return None
    a = np.frombuffer(raw, dtype=np.int16).astype(np.float32)
    if rate != sr:
        raise ValueError(f"unexpected rate {rate}")
    a = a.reshape(-1, nch)
    if max_s:
        a = a[:int(max_s * sr)]
    if not a.any():
        if quiet:
            return None
        # Exact zeros: a live mic always has some noise floor, so this is
        # a mute unmute_node couldn't see or undo (e.g. in hardware), or a
        # virtual source nothing feeds.
        MIC_TAP.stale()
        source = source or {}
        if source.get("virtual") and source.get("fed") is False:
            log(f"recording is all zeros and no mic feeds "
                f"{source.get('desc')!r}, skipping")
            notify_stt("No mic behind " + (source.get("desc") or "the source"),
                       "It isn't getting audio from any mic. Pick your mic "
                       "in Settings.", urgency="normal")
        else:
            log("recording is all zeros (mic muted?), skipping")
            notify_stt("Mic is muted", "Unmute it and try again.",
                       urgency="normal")
        return None
    a -= a.mean(axis=0, keepdims=True)

    if nch > 1:
        ref = a[:, 0]
        aligned = [ref]
        lags = [0]
        for k in range(1, nch):
            lag = gcc_phat_lag(a[:, k], ref)
            lags.append(lag)
            aligned.append(np.roll(a[:, k], -lag))
        m = np.mean(np.stack(aligned), axis=0)
    else:
        lags = [0]
        m = a[:, 0]
    if not quiet:
        log(f"align lags (samples @16k): {lags}")

    n = fast_len(len(m))
    X = np.fft.rfft(m, n)
    freqs = np.fft.rfftfreq(n, 1.0 / sr)
    # 2nd-order Butterworth high-pass @80 Hz: desk/monitor rumble + handling noise
    f0 = 80.0
    hp = 1.0 / np.sqrt(1.0 + (f0 / np.maximum(freqs, 1e-6)) ** 4)
    hp[0] = 0.0
    # High shelf +5 dB from ~2.5 kHz: restores consonants lost to diffraction
    # over the monitor top edge when the mouth sits below the camera plane.
    g = 10 ** (5.0 / 20.0) - 1.0
    t = np.clip(np.log2(np.maximum(freqs, 1.0) / 2500.0), 0, 1)
    t = t * t * (3 - 2 * t)
    shelf = 1.0 + g * t
    y = np.fft.irfft(X * hp * shelf, n)[:len(m)].astype(np.float32)

    # Noise gate, 20 ms frames, 120 ms hangover, 10 ms smoothing
    F = 320
    nf = len(y) // F
    if nf < 2:
        return None
    yf = y[:nf * F].reshape(nf, F)
    e = np.sqrt((yf * yf).mean(axis=1) + 1e-12)
    peak_e = float(e.max())
    thr = max(peak_e * 0.01, 25.0)
    mask = (e > thr).astype(np.float32)
    # each loud frame keeps itself and the 6 after it open
    keep = (np.convolve(mask, np.ones(7))[:nf] > 0).astype(np.float32)
    gain = np.repeat(keep, F)
    k = 160
    gain = np.convolve(gain, np.ones(k) / k, mode="same")
    y = y[:len(gain)] * gain

    peak = float(np.abs(y).max())
    if peak < 1e-6:
        return None
    rms_pre = float(np.sqrt((y * y).mean()))
    if peak < QUIET_PEAK or rms_pre < QUIET_RMS:
        # Gate BEFORE normalization, since the gain below would amplify
        # silence into something whisper hallucinates on.
        if not quiet:
            log(f"utterance too quiet (peak={peak:.0f} rms={rms_pre:.0f}), "
                "skipping")
        try:
            os.unlink(path_out)
        except OSError:
            pass
        return None
    y *= min(12000.0 / peak, 8.0)  # normalize, cap gain so silence isn't blasted

    # Trim leading/trailing gated silence, keep 100 ms margin
    idx = np.where(np.abs(y) > thr)[0]
    if len(idx) == 0:
        return None
    s = max(0, idx[0] - sr // 10)
    t_ = min(len(y), idx[-1] + sr // 10)
    y = y[s:t_]
    if len(y) < sr // 4:
        return None

    with wave.open(path_out, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(sr)
        w.writeframes(np.clip(y, -32768, 32767).astype(np.int16).tobytes())
    rms = float(np.sqrt((y * y).mean()))
    return {"seconds": len(y) / sr, "lags": lags, "rms": rms}


