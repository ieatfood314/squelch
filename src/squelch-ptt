def archive_root():
    """The archive directory from ~/.config/squelch/archive, or None."""
    try:
        with open(ARCHIVE_FILE) as f:
            root = os.path.expanduser(f.read().strip())
        return root or None
    except OSError:
        return None


def archive_available(root):
    """True if the archive is writable (cached a few minutes either way)."""
    now = time.time()
    st = _archive_state
    if st["root"] == root and now - st["checked"] < 300:
        return st["ok"]
    ok = False
    try:
        os.makedirs(os.path.join(root, "raw"), exist_ok=True)
        os.makedirs(os.path.join(root, "clean"), exist_ok=True)
        ok = os.access(os.path.join(root, "raw"), os.W_OK)
    except OSError as e:
        log("archive unavailable:", e)
    st.update(ok=ok, checked=now, root=root)
    return ok


def trim_spool():
    """Keep the newest SPOOL_MAX_UTTERANCES utterances while the archive is
    away, dropping whole utterances (wavs + metadata) oldest first."""
    try:
        names = os.listdir(SPOOL_DIR)
    except OSError:
        return
    bases = sorted({n.split(".", 1)[0] for n in names})
    for base in bases[:max(0, len(bases) - SPOOL_MAX_UTTERANCES)]:
        for n in names:
            if n.split(".", 1)[0] == base:
                try:
                    os.unlink(os.path.join(SPOOL_DIR, n))
                except OSError:
                    pass


def archive_utterance(raw_wav, clean_wav, meta):
    """Spool wavs locally now (fast), upload to the archive in background.
    Returns the utterance's name in the archive, or None."""
    if os.environ.get("STT_NO_STATS") or archive_root() is None:
        return None
    global _spool_counter
    try:
        os.makedirs(SPOOL_DIR, exist_ok=True)
        trim_spool()
        stamp = time.strftime("%Y%m%d-%H%M%S", time.localtime(meta["ts"]))
        _spool_counter += 1
        base = f"{stamp}-{os.getpid()}-{_spool_counter}"
        for src, ext in ((raw_wav, ".raw.wav"), (clean_wav, ".clean.wav")):
            if src and os.path.exists(src):
                shutil.copy(src, os.path.join(SPOOL_DIR, base + ext))
        with open(os.path.join(SPOOL_DIR, base + ".json"), "w") as f:
            json.dump(meta, f)
    except OSError as e:
        log("spool failed:", e)
        return None
    threading.Thread(target=upload_spool, daemon=True).start()
    return base


def upload_spool():
    if not _spool_lock.acquire(blocking=False):
        return  # another uploader is working
    try:
        root = archive_root()
        if root is None or not archive_available(root):
            return
        try:
            names = sorted(os.listdir(SPOOL_DIR))
        except OSError:
            return
        for name in names:
            if name.endswith(".edit.json"):  # what you did to it after
                try:
                    with open(os.path.join(SPOOL_DIR, name)) as f:
                        line = f.read().strip()
                    json.loads(line)
                    with open(os.path.join(root, "corrections.jsonl"),
                              "a") as f:
                        f.write(line + "\n")
                    os.unlink(os.path.join(SPOOL_DIR, name))
                except ValueError:
                    discard(os.path.join(SPOOL_DIR, name))
                except OSError as e:
                    log("spool upload issue (will retry):", e)
                    return
                continue
            if not name.endswith(".json"):
                continue
            base = name[:-5]
            try:
                with open(os.path.join(SPOOL_DIR, name)) as f:
                    meta = json.load(f)
                day = time.strftime("%Y%m%d", time.localtime(meta["ts"]))
                for ext, sub in ((".raw.wav", "raw"), (".clean.wav", "clean")):
                    src = os.path.join(SPOOL_DIR, base + ext)
                    if os.path.exists(src):
                        d = os.path.join(root, sub, day)
                        os.makedirs(d, exist_ok=True)
                        shutil.copy(src, os.path.join(d, base + ext))
                        os.unlink(src)
                with open(os.path.join(root, "transcripts.jsonl"),
                          "a") as f:
                    f.write(json.dumps({
                        "id": base,
                        "ts": meta["ts"], "engine": meta.get("engine"),
                        "words": meta.get("words"),
                        "audio_s": meta.get("audio_s"),
                        "text": meta.get("text", "")}) + "\n")
                os.unlink(os.path.join(SPOOL_DIR, name))
            except (OSError, ValueError) as e:
                log("spool upload issue (will retry):", e)
                return
    finally:
        _spool_lock.release()


