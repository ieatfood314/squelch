# ---------------- Nullspace ----------------
# With the Nullspace desktop app running, the trigger key does what the
# Essential key does on Nullspace for Android: hold to dictate as always,
# press to capture the screen, press then hold for a voice note, double
# press to open Nullspace. A hold while a screenshot's card is showing is a
# note about that screenshot. The tray leaves taps to this loop then.
# Nullspace's package carries this engine (and replaces the squelch package),
# so there the name people see is Nullspace's.
BRAND = "Nullspace" if os.path.exists("/usr/bin/nullspace-desktop") else "Squelch"

NULLSPACE_SOCKET = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp",
                                f"nullspace-{os.getuid()}")
# holds the uid of the screenshot whose card is showing
NULLSPACE_CARD = NULLSPACE_SOCKET + "-card"
GAP_S = 0.38  # a second press this soon after a tap makes it a double


def nullspace_send(line):
    """Tell the Nullspace app something. False if it isn't running."""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(0.3)
            s.connect(NULLSPACE_SOCKET)
            s.sendall(line.encode() + b"\n")
        return True
    except OSError:
        return False


def nullspace_on():
    return os.path.exists(NULLSPACE_SOCKET) and nullspace_send("ping")


def nullspace_card():
    try:
        with open(NULLSPACE_CARD) as f:
            return f.read().strip() or None
    except OSError:
        return None


class Gestures:
    """Taps and holds of the trigger key, told apart the way the phone does.
    A tap waits `wait` for a second press: a second tap opens Nullspace, a
    second press that's held is a voice note, and nothing is a capture."""

    def __init__(self):
        self.tap_at = None   # when the last unanswered tap ended
        self.wait = GAP_S
        self.second = False  # the key is down for the second time

    def down(self, t):
        """The trigger key itself went down (not kanata)."""
        self.second = self.tap_at is not None and t - self.tap_at < self.wait
        if self.second:
            self.tap_at = None

    def tap(self, t, wait=GAP_S):
        """A tap ended: "open" if it was the second, else None for now.
        kanata's taps wait longer, since its hold only shows up as F24 its
        hold timeout after the press."""
        if self.second or (self.tap_at is not None
                           and t - self.tap_at < self.wait):
            self.tap_at, self.second = None, False
            return "open"
        self.tap_at, self.wait = t, wait
        return None

    def hold(self, t):
        """A hold started. True when it's the second press: a voice note."""
        second = self.second or (self.tap_at is not None
                                 and t - self.tap_at < self.wait)
        self.tap_at, self.second = None, False
        return second

    def due(self, t):
        """"capture" once a tap has gone unanswered for `wait`."""
        if self.tap_at is not None and t - self.tap_at >= self.wait:
            self.tap_at = None
            return "capture"
        return None

    def deadline(self):
        return None if self.tap_at is None else self.tap_at + self.wait
LEVEL_EVERY_S = 0.05   # how often the pill gets the mic level
WAV_HEADER = 44        # pw-record's; its sizes are only filled in on exit


class Pill:
    """Drives the tray's pill for one hold: the mic level while recording,
    then "working" until the text is in. Nothing happens if the tray isn't
    running."""

    def __init__(self, path):
        self.path = path
        self.hold = next(_hold_ids)
        self.sock = None
        self.lock = threading.Lock()
        self._stop = threading.Event()
        self.thread = threading.Thread(target=self.meter, daemon=True)
        self.thread.start()

    def send(self, **msg):
        line = b"pill " + json.dumps({"hold": self.hold, **msg}).encode()
        with self.lock:
            for _try in (1, 2):  # the tray may have restarted mid-hold
                try:
                    if self.sock is None:
                        self.sock = socket.socket(socket.AF_UNIX,
                                                  socket.SOCK_STREAM)
                        self.sock.settimeout(0.3)
                        self.sock.connect(TRAY_SOCKET)
                    self.sock.sendall(line + b"\n")
                    return
                except OSError:
                    self.close()

    def close(self):
        if self.sock is not None:
            try:
                self.sock.close()
            except OSError:
                pass
            self.sock = None

    def meter(self):
        pos = WAV_HEADER
        while not self._stop.wait(LEVEL_EVERY_S):
            try:
                with open(self.path, "rb") as f:
                    f.seek(pos)
                    d = f.read()
            except OSError:
                continue
            d = d[:len(d) - len(d) % 2]
            pos += len(d)
            if not d:
                continue
            a = np.frombuffer(d, dtype=np.int16).astype(np.float32)
            self.send(level=round(float(np.sqrt(np.mean(a * a))) / 32768, 5))

    def working(self):
        """Recording is over; the transcript is on its way."""
        self._stop.set()
        self.thread.join()
        self.send(working=True)

    def end(self):
        self._stop.set()
        self.thread.join()
        self.send(end=True)
        with self.lock:
            self.close()


# ---------------- typing as you speak ----------------
# While the trigger is held, the clip so far is transcribed every
# LIVE_EVERY_S. A pass over a clip that's still growing isn't the final
# word: the model re-decides earlier words as more audio arrives, most of
# all the first few. So a word is only typed once the model is sure of it:
# every pass over the last AGREE_S has it, it ended at least SETTLE_S
# before the end of the clip, and its confidence is SURE_P or more. The
# first words of a dictation wait for START_S of agreement and unsure
# words for UNSURE_S. Typed words are never taken back; on release the
# full-clip transcript supplies everything after them.
#
# Only Parakeet says how sure it is of each word and where it ends, so
# with Whisper nothing is typed until release.
#
# The numbers come from replaying 160 of Aidan's dictations (3893 words)
# as if live: 136 came out word for word what the full-clip pass alone
# gives and 11 more differed only in punctuation or capitals. 24 words
# (0.6%) really differed, mostly coin flips like "T3" / "T three", and 44%
# of the words were typed before release. Looser settings type more,
# sooner, and differ more.

LIVE_EVERY_S = 0.5     # how often the clip so far is transcribed while held
LIVE_MIN_NEW_S = 0.25  # unless it grew less than this since the last pass
AGREE_S = 1.0          # passes over this long must all have the word
START_S = 3.5          # ...this long for the first words of a dictation
UNSURE_S = 5.0         # ...and this long for a word under SURE_P
SURE_P = 0.9           # the word's least certain token
SETTLE_S = 1.0         # audio that must follow a word before it counts
ANCHOR_WORDS = 3       # typed words that place where a pass carries on
ANCHOR_SLACK_S = 1.0   # how far a word's time may move between passes


def live_enabled():
    """Settings → General → Type words as you speak. Whoever had the old
    preview strip on gets this in its place. Not for clipboard-only, and
    not for Whisper."""
    try:
        with open(INSERTION_FILE) as f:
            d = json.load(f)
        on = bool(d.get("live", d.get("preview", False)))
    except (OSError, ValueError, AttributeError):
        return False
    return (on and insertion_mode() != "clipboard"
            and current_engine() == "parakeet")


def read_growing_wav(path):
    """(channels, PCM bytes) pw-record has written so far. Its header only
    gets real sizes on exit, so walk the chunks by hand."""
    with open(path, "rb") as f:
        d = f.read()
    if d[:4] != b"RIFF" or d[8:12] != b"WAVE":
        return None
    i, nch = 12, None
    while i + 8 <= len(d):
        cid, size = d[i:i + 4], struct.unpack("<I", d[i + 4:i + 8])[0]
        if cid == b"fmt " and i + 12 <= len(d):
            nch = struct.unpack("<H", d[i + 10:i + 12])[0]
        elif cid == b"data":
            if not nch:
                return None
            pcm = d[i + 8:i + 8 + size] if size else d[i + 8:]
            return nch, pcm[:len(pcm) - len(pcm) % (2 * nch)]
        i += 8 + size + (size & 1)
    return None


def common_prefix(a, b):
    n = 0
    for x, y in zip(a, b):
        if x != y:
            break
        n += 1
    return n


def _bare(word):
    """A word without case or punctuation, for lining passes up."""
    return re.sub(r"[^\w]", "", word.lower())


def live_anchor(sure, words):
    """Index in a pass's words where it carries on from the `sure` ones,
    or None if their last few aren't in it (the model changed its mind
    about them, or dropped the start of the clip this time)."""
    if not sure:
        return 0
    k = min(ANCHOR_WORDS, len(sure))
    tail = [_bare(w[0]) for w in sure[-k:]]
    at = sure[-1][2]
    best = None
    for j in range(k, len(words) + 1):
        if [_bare(w[0]) for w in words[j - k:j]] != tail:
            continue
        off = abs(words[j - 1][2] - at)
        if off <= ANCHOR_SLACK_S and (best is None or off < best[0]):
            best = (off, j)
    return best[1] if best else None


def live_settled(sure, passes, onset):
    """The words to add to `sure` after the newest pass. passes is
    [(clip seconds, words)], oldest first; words are (word, confidence,
    end second). onset is the earliest any pass has heard a first word
    end: a pass sometimes drops the whole first sentence, and its second
    one mustn't be taken for the start."""
    if not passes or not passes[-1][1]:
        return []
    now, words = passes[-1]
    j = live_anchor(sure, words)
    if j is None:
        return []
    cur = words[j:]
    if not sure and cur and cur[0][2] > onset + ANCHOR_SLACK_S:
        return []
    texts = [w[0] for w in cur]

    def agreed(span):
        """How many of cur every pass over the last `span` seconds has."""
        n = len(cur)
        for t, old in reversed(passes[:-1]):
            k = live_anchor(sure, old)
            if k is None:
                return 0
            n = min(n, common_prefix(texts, [w[0] for w in old[k:]]))
            if now - t >= span - 0.01:
                return n
        return 0

    n = agreed(AGREE_S if sure else START_S)
    n_unsure = agreed(UNSURE_S) if n else 0
    out = []
    for i in range(n):
        word, p, end = cur[i]
        if end > now - SETTLE_S or (p < SURE_P and i >= n_unsure):
            break
        out.append(cur[i])
    return out


def words_after(typed, final):
    """The words of the final transcript that come after the typed ones.
    Typed words stay as they are, so where the two differ in the middle
    the typed version wins and only the end is added."""
    if not typed:
        return list(final)
    ops = difflib.SequenceMatcher(None, [_bare(w) for w in typed],
                                  [_bare(w) for w in final],
                                  autojunk=False).get_opcodes()
    tag, i1, i2, j1, j2 = ops[-1]
    if tag == "insert":
        return final[j1:]
    if tag == "replace":  # the typed end reads differently; add what's over
        return final[j1 + (i2 - i1):j2]
    return []


class LiveTyper:
    """Types a dictation word by word while the trigger is held (see the
    rule above), then finish() adds the rest from the full-clip pass."""

    def __init__(self, path, cap_s, source, jobs):
        self.path, self.cap_s, self.source = path, cap_s, source
        self.jobs = jobs
        self.sure = []     # (word, confidence, end) the model is sure of
        self.typed = []    # the words in the text box, after cleanup
        self.out = ""      # everything typed into it, spaces and all
        self.passes = []   # [(clip seconds, words)] of the recent passes
        self.onset = float("inf")  # earliest end of a pass's first word
        self.table = None  # the layout's keys, looked up off the key loop
        self.broken = False
        self.dry = bool(os.environ.get("STT_DRY_RUN"))
        self._stop = threading.Event()
        self.thread = threading.Thread(target=self.run, daemon=True)
        self.thread.start()

    def halt(self):
        """Stop the live passes; returns once the one in flight is done."""
        self._stop.set()
        self.thread.join()

    def cancel(self):
        """The hold came to nothing. Doesn't wait: the key-reading loop
        mustn't sit behind a pass in flight."""
        self._stop.set()

    def partial(self, nch, pcm):
        """(seconds, words) of the clip so far, or None."""
        fd, snap = tempfile.mkstemp(suffix="-live.wav")
        os.close(fd)
        clean = snap[:-4] + "-clean.wav"
        try:
            with wave.open(snap, "wb") as w:
                w.setnchannels(nch)
                w.setsampwidth(2)
                w.setframerate(SR)
                w.writeframes(pcm)
            info = beamform_and_clean(snap, clean, max_s=self.cap_s,
                                      source=self.source, quiet=True)
            if info is None:
                return None
            words = transcribe_words(clean)
            if words is None:
                log("speech server gives no word confidence; restart "
                    "squelch-parakeet to type as you speak")
                self._stop.set()
                return None
            return info["seconds"], words
        except Exception as e:
            log("live pass failed:", e)
            return None
        finally:
            discard(snap)
            discard(clean)

    def run(self):
        self.table = current_keymap()
        seen = 0
        while not self._stop.wait(LIVE_EVERY_S):
            try:
                got = read_growing_wav(self.path)
            except OSError:
                continue
            if not got:
                continue
            nch, pcm = got
            frames = len(pcm) // (2 * nch)
            if frames - seen < LIVE_MIN_NEW_S * SR:
                continue
            seen = frames
            res = self.partial(nch, pcm)
            if res is None or self._stop.is_set():
                continue
            self.passes.append(res)
            if res[1]:
                self.onset = min(self.onset, res[1][0][2])
            while (len(self.passes) > 2
                   and res[0] - self.passes[1][0] > UNSURE_S):
                self.passes.pop(0)
            # an earlier hold may still be going in; its text comes first
            if self.jobs.unfinished_tasks == 0 and not self.broken:
                self.advance()

    def advance(self):
        new = live_settled(self.sure, self.passes, self.onset)
        if not new:
            return
        sure = self.sure + new
        said = " ".join(w[0] for w in sure)
        j = live_anchor(sure, self.passes[-1][1])
        ahead = " ".join(w[0] for w in self.passes[-1][1][j:])
        # Cleanup can join words ("twenty" + "five") and the dictionary can
        # match across them, so only type what reads the same with the
        # words still to come.
        a, b = tidy(said).split(), tidy(f"{said} {ahead}").split()
        target = a[:common_prefix(a, b)]
        self.sure = sure
        n = len(self.typed)
        if len(target) > n and target[:n] == self.typed:
            self.put(target[n:])

    def put(self, words):
        text = " ".join(words) + " "
        if self.dry:
            log(f"DRYRUN live would type: {text!r}")
        elif not type_text(text, self.table):
            self.broken = True  # finish() puts the rest on the clipboard
            return
        else:
            log("typed live:", text[:80])
        self.typed += words
        self.out += text

    def finish(self, text):
        """After release: add what the full-clip transcript has beyond the
        words already typed."""
        if not self.typed:
            return False  # nothing went in live; insert it the usual way
        final = text.split()
        rest = words_after(self.typed, final)
        kept = len(final) - len(rest)
        if [_bare(w) for w in final[:kept]] != [_bare(w) for w in self.typed]:
            log(f"live words the full pass reads differently: "
                f"{' '.join(self.typed)[:200]!r}")
        if not rest:
            return True
        rest = " ".join(rest) + " "
        if self.dry:
            log(f"DRYRUN live would finish with: {rest!r}")
        elif self.broken or not type_text(rest, self.table):
            clipboard_only(rest)
        else:
            log("typed the rest:", rest[:80])
            self.out += rest
        return True


# ---------------- edits made after a dictation (training data) ----------------
# After each dictation Squelch watches what you do to the text it put in,
# and saves the transcript next to the version you left it as, so the
# archive pairs audio with the right words. Through accessibility (AT-SPI)
# when the app shares its text, which catches every edit; otherwise from
# the keys you press, which loses track at a click or a jump elsewhere.

CORRECTIONS_FILE = os.path.expanduser("~/.config/squelch/corrections.jsonl")
EDIT_IDLE_S = 120.0     # untouched this long: done with it
EDIT_MAX_S = 600.0      # watched no longer than this
EDIT_FIELD_MAX = 200000  # characters; bigger fields aren't read
EDIT_CONTEXT = 300      # characters before the dictation kept as context


def edited_region(t0, a, b, t):
    """Where t0[a:b] is in t, by a character diff. Text typed right
    before or after it stays outside; edits that reach into it are in.
    (a, b) in t, or None if the diff is too big to work out."""
    n0, n1 = len(t0), len(t)
    lim = min(n0, n1)
    p = 0
    while p < lim and t0[p] == t[p]:
        p += 1
    s = 0
    while s < lim - p and t0[n0 - 1 - s] == t[n1 - 1 - s]:
        s += 1
    mid0, mid1 = t0[p:n0 - s], t[p:n1 - s]
    if len(mid0) * len(mid1) > 4e7:
        return None
    ops = []
    if p:
        ops.append(("equal", 0, p, 0, p))
    if mid0 or mid1:
        for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(
                None, mid0, mid1, autojunk=False).get_opcodes():
            ops.append((tag, i1 + p, i2 + p, j1 + p, j2 + p))
    if s:
        ops.append(("equal", n0 - s, n0, n1 - s, n1))
    a2 = b2 = None
    for tag, i1, i2, j1, j2 in ops:
        if tag == "equal":
            if a2 is None and i1 <= a < i2:
                a2 = j1 + a - i1
            if i1 < b <= i2:
                b2 = j1 + b - i1
            continue
        inside = (i1 < b and i2 > a) if i1 < i2 else a < i1 < b
        if inside:
            if a2 is None:
                a2 = j1
            b2 = j2
    if a2 is None or b2 is None or b2 < a2:
        return None
    return a2, b2


UNSURE_ENDS = ("moved", "lost")


class EditWatch:
    """One dictation's text, from when it went in to when you're done
    with it. t0 is the text it went into, t0[a:b] the dictation."""

    def __init__(self, utt, how, t0, a, b, obj=None):
        self.utt, self.how, self.t0, self.a, self.b = utt, how, t0, a, b
        self.obj = obj
        self.cur = t0
        self.region = t0[a:b]
        self.started = self.changed = time.time()

    def update(self, t):
        """A new look at the text. Returns why the watch is over, if it
        is: "sent" (the box emptied), "deleted", "lost" (can't follow)."""
        if t == self.cur:
            return None
        r = edited_region(self.t0, self.a, self.b, t)
        if r is None:
            return "lost"
        self.cur, self.changed = t, time.time()
        new = t[r[0]:r[1]]
        if new.strip():
            self.region = new
            return None
        if not t.strip():
            return "sent"  # the whole box went at once: keep the last look
        self.region = ""
        return "deleted"

    def record(self, why):
        heard = self.t0[self.a:self.b].strip()
        edited = self.region.strip()
        u = self.utt
        rec = {"ts": u.get("ts"), "id": u.get("id"), "engine": u.get("engine"),
               "app": u.get("app"), "how": self.how, "end": why,
               "text": heard, "edited": edited,
               "heard": u.get("heard"), "cut": bool(u.get("cut"))}
        rec.update(classify_edit(heard, edited, rec["cut"]))
        if why in UNSURE_ENDS and rec["kind"] != "deleted":
            # it lost track, so edits after that went unseen
            rec.update(train=False, label=None, unsure=True)
        if u.get("guess"):
            rec["guess"] = u["guess"]
        if u.get("tidied"):
            # The tidy pass cut spoken repeats and false starts, so even a
            # kept dictation is no longer a word-for-word training label.
            rec.update(tidied=True, train=False, label=None)
        if u.get("first_p") is not None:
            rec["first_p"] = u["first_p"]
        if self.how == "a11y":
            rec["before"] = self.t0[max(0, self.a - EDIT_CONTEXT):self.a]
        return rec


# Whether an edit can teach a model. A clip's label has to be what was
# said: edits that swap a word for one that sounds like it (world → word,
# Regulath → Regolith) or only touch punctuation and capitals are fixes to
# what was heard. Adding, dropping or rewording words is you changing your
# mind, which the audio doesn't back, so that dictation isn't trained on.
# Neither is a clip whose start was cut off: it begins mid-word.

def _sk(s):
    """Rough sound key: consonants with look-alike spellings merged."""
    s = re.sub(r"[^a-z0-9]", "", s.lower())
    for a, b in (("ph", "f"), ("ck", "k"), ("c", "k"), ("q", "k"),
                 ("z", "s"), ("x", "ks")):
        s = s.replace(a, b)
    s = s[:1] + re.sub(r"[aeiouwyh]", "", s[1:])
    return re.sub(r"(.)\1+", r"\1", s)


def sounds_alike(old, new):
    a = re.sub(r"[^a-z0-9]", "", old.lower())
    b = re.sub(r"[^a-z0-9]", "", new.lower())
    if not a or not b:
        return False
    r = difflib.SequenceMatcher(None, a, b, autojunk=False).ratio()
    s = difflib.SequenceMatcher(None, _sk(old), _sk(new),
                                autojunk=False).ratio()
    return r >= 0.6 or (r >= 0.4 and s >= 0.75)


FILLERS = {"um", "umm", "uh", "uhm", "er", "erm", "ah", "hmm", "mm"}


def stray_words(words, i, j):
    """words[i:j] are fillers or repeat the words next to them."""
    gone, n = words[i:j], j - i
    return n <= 3 and (all(w in FILLERS for w in gone)
                       or words[max(0, i - n):i] == gone
                       or words[j:j + n] == gone)


def classify_edit(text, edited, cut=False):
    """{"kind": kept|format|fix|start|rewrite|deleted, "train": bool,
    "label": the words to train on or None, "fixes": [[old, new]]}."""
    if not edited.strip():
        return {"kind": "deleted", "train": False, "label": None,
                "fixes": []}
    tw, ew = text.split(), edited.split()
    bare = lambda w: re.sub(r"[^\w]", "", w.lower())
    tb, eb = [bare(w) for w in tw], [bare(w) for w in ew]
    fixes, rewrite, changed, start = [], False, 0, False
    if tb != eb:
        for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(
                None, tb, eb, autojunk=False).get_opcodes():
            if tag == "equal":
                continue
            if tag == "insert" and i1 == 0 and cut:
                start = True  # the cut-off words, put back
                continue
            changed += max(i2 - i1, j2 - j1)
            old, new = " ".join(tw[i1:i2]), " ".join(ew[j1:j2])
            if tag == "delete" and stray_words(tb, i1, i2):
                fixes.append([old, ""])  # an um, or a word heard twice
                continue
            if (tag == "replace" and max(i2 - i1, j2 - j1) <= 3
                    and sounds_alike(old, new)):
                fixes.append([old, new])
            else:
                rewrite = True
    if rewrite or changed > max(2, len(tw) // 2):
        kind = "rewrite"
    elif fixes:
        kind = "fix"
    elif start:
        kind = "start"
    else:
        kind = "kept" if text.strip() == edited.strip() else "format"
    train = kind != "rewrite" and not cut
    return {"kind": kind, "train": train,
            "label": edited.strip() if train else None, "fixes": fixes}


def save_edit(rec):
    """corrections.jsonl here, and in the archive next to the audio."""
    if os.environ.get("STT_NO_STATS"):
        return
    line = json.dumps(rec, ensure_ascii=False)
    try:
        with open(CORRECTIONS_FILE, "a") as f:
            f.write(line + "\n")
    except OSError as e:
