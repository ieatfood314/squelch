    "stand stands stood standing read reads reading write writes wrote writing learn learns learned learning "
    "mean means meant meaning call calls called calling move moves moved moving happen happens happened happening "
    "seem seems seemed seeming feel feels felt feeling become becomes became becoming".split())
INCOMPLETE_END = {"am", "are", "be", "been", "being", "can", "could", "should", "would", "will", "do", "does", "did", "have", "has", "had", "is", "was", "were"}
CUE = re.compile(r"^(?:(?:well|actually|sorry|wait|no|i mean)\b[\s,]*)+", re.I)
WORD = re.compile(r"[^\W_]+(?:'[^\W_]+)*", re.UNICODE)


def bare_words(text):
    return [word.lower() for word in WORD.findall(text)]


def repeated(left, right):
    if left and len(left) <= 6 and right[:len(left)] == left:
        return True
    for size in (4, 3, 2):
        if len(left) >= size and left[-size:] == right[:size]:
            return True
    return False


def should_cut(left_text, right_text):
    right_text = CUE.sub("", right_text.strip())
    left, right = bare_words(left_text), bare_words(right_text)
    if not left or not right or any(word in {"no", "not", "never"} for word in left):
        return False
    if re.search(r"\d", left_text):
        return False
    left_content = {word for word in left if word not in FUNCTION}
    right_content = {word for word in right if word not in FUNCTION}
    if not right_content - left_content:
        return False
    incomplete = left[-1] in INCOMPLETE_END or (left[0] in NP_START and not any(word in VERBS for word in left))
    if incomplete and repeated(left, right):
        return True
    if left[0] not in NP_START or any(word in VERBS for word in left):
        return False
    return bool(left_content & right_content)


def tidy_false_starts(text):
    """Cut abandoned comma-delimited fragments with conservative overlap checks."""
    for _ in range(4):
        commas = list(re.finditer(r",", text))
        changed = False
        for match in reversed(commas):
            comma = match.start()
            previous = max(text.rfind(".", 0, comma), text.rfind("!", 0, comma), text.rfind("?", 0, comma), text.rfind(",", 0, comma))
            start = previous + 1
            end_candidates = [p for p in (text.find(".", comma + 1), text.find("!", comma + 1), text.find("?", comma + 1)) if p >= 0]
            end = min(end_candidates) if end_candidates else len(text)
            left = text[start:comma]
            right = text[comma + 1:end]
            if should_cut(left, right):
                cleaned_right = CUE.sub("", right.strip())
                if (previous < 0 or text[previous] in ".!?") and cleaned_right:
                    cleaned_right = cleaned_right[0].upper() + cleaned_right[1:]
                text = (text[:start] + " " + cleaned_right + text[end:]).strip()
                changed = True
                break
        if not changed:
            break
    return re.sub(r"\s{2,}", " ", text).strip()



# Apache-2.0 DisfluencySpeech, trained on its train split and thresholded on
# validation. The local model removes likely false-start tokens; it never calls
# a network service. Keep these features identical to the training harness and
# Android's Disfluency.kt.
_disfluency_model = None
_disfluency_loaded = False
_DISFLUENCY_FUNCTION_WORDS = set(
    "a an and are as at be been but by can could did do does for from had has have he her "
    "hers him his i if in into is it its me my of on or our she should so that the their them "
    "there these they this those to was we were what when which who will with would you your".split())


def _disfluency_bare(word):
    return word.lower().strip(".,!?;:")


def _disfluency_supported(words, index):
    """Only an exact stutter or an earlier content-bearing repeated phrase."""
    low = _disfluency_bare(words[index])
    if index + 1 < len(words):
        following_token = words[index + 1]
        following = _disfluency_bare(following_token)
        exact_surface_repeat = words[index].lower() == following_token.lower()
        bare_prefix_repeat = (words[index].lower() == low and following_token.lower() == following
                              and len(low) >= 3 and len(following) >= 3
                              and (low.startswith(following) or following.startswith(low)))
        if exact_surface_repeat or bare_prefix_repeat:
            return True
    values = [_disfluency_bare(word) for word in words]
    for size in (2, 3, 4):
        for start in range(max(0, index - size + 1), min(index + 1, len(words) - size + 1)):
            phrase = values[start:start + size]
            if all(word in _DISFLUENCY_FUNCTION_WORDS for word in phrase):
                continue
            if any(values[later:later + size] == phrase
                   for later in range(start + size, len(words) - size + 1)):
                return True
    return False


def _disfluency_features(words, index):
    punct = ".,!?;:"
    bare = _disfluency_bare
    token = words[index]
    low = bare(token)
    prev1 = bare(words[index - 1]) if index >= 1 else "<start>"
    prev2 = bare(words[index - 2]) if index >= 2 else "<start2>"
    next1 = bare(words[index + 1]) if index + 1 < len(words) else "<end>"
    next2 = bare(words[index + 2]) if index + 2 < len(words) else "<end2>"
    repeated = prev1 == low
    partial = (len(low) >= 3 and len(prev1) >= 3
               and (low.startswith(prev1) or prev1.startswith(low)))
    return (
        f"token={low}", f"prev={prev1}", f"prev2={prev2}",
        f"next={next1}", f"next2={next2}",
        f"bigram={prev1} {low}", f"bigram={low} {next1}",
        f"trigram={prev1} {low} {next1}",
        f"repeat={repeated}", f"partial={partial}",
        f"prefix={low[:3]}", f"suffix={low[-3:]}",
        f"len={min(len(low), 20)}", f"pos={min(index, 30)}",
        f"last={index + 1 == len(words)}", f"first={index == 0}",
        f"comma_before={token[0] in punct}",
        f"comma_after={token[-1:] in punct}",
        f"upper={token[:1].isupper()}",
        f"digit={any(c.isdigit() for c in token)}",
        f"next_repeat={low == next1}",
    )


def tidy_disfluency_model(text):
    """Delete high-confidence false-start tokens with the bundled local model."""
    global _disfluency_model, _disfluency_loaded
    if not _disfluency_loaded:
        _disfluency_loaded = True
        try:
            with open(DISFLUENCY_FILE) as f:
                model = json.load(f)
            threshold = float(model["threshold"])
            if not 0 < threshold < 1:
                raise ValueError("invalid disfluency threshold")
            _disfluency_model = (float(model["intercept"]),
                                 math.log(threshold / (1 - threshold)),
                                 model["weights"])
        except (OSError, ValueError, TypeError, KeyError) as e:
            log("disfluency filter unavailable:", e)
            _disfluency_model = None
    if _disfluency_model is None:
        return text
    words = text.split()
    if len(words) < TIDY_MIN_WORDS:
        return text
    intercept, cutoff, weights = _disfluency_model
    kept = []
    for index, word in enumerate(words):
        score = intercept + sum(weights.get(key, 0.0)
                                for key in _disfluency_features(words, index))
        delete = score >= cutoff and _disfluency_supported(words, index)
        if delete:
            terminal = word[-1:] in ".!?"
            immediate_repeat = (index + 1 < len(words)
                                and _disfluency_bare(word) == _disfluency_bare(words[index + 1]))
            sentence_start = index == 0 or words[index - 1][-1:] in ".!?"
            if terminal or (sentence_start and not immediate_repeat):
                delete = False
        if not delete:
            kept.append(word)
    return " ".join(kept)


_NUM_ONES = {"zero": 0, "one": 1, "two": 2, "three": 3, "four": 4,
             "five": 5, "six": 6, "seven": 7, "eight": 8, "nine": 9,
             "ten": 10, "eleven": 11, "twelve": 12, "thirteen": 13,
             "fourteen": 14, "fifteen": 15, "sixteen": 16, "seventeen": 17,
             "eighteen": 18, "nineteen": 19}
_NUM_TENS = {"twenty": 20, "thirty": 30, "forty": 40, "fifty": 50,
             "sixty": 60, "seventy": 70, "eighty": 80, "ninety": 90}
_NUM_SCALES = {"hundred": 100, "thousand": 1000, "million": 1000000,
               "billion": 1000000000}
_NUM_WORDS = sorted(set(_NUM_ONES) | set(_NUM_TENS) | set(_NUM_SCALES)
                    | {"and", "a"}, key=len, reverse=True)
_NUM_ALT = "|".join(_NUM_WORDS)
_NUM_RUN_RE = re.compile(r"\b(?:%s)(?:[\s-]+(?:%s))*\b" % (_NUM_ALT, _NUM_ALT),
                         re.IGNORECASE)


def _tok_val(t):
    if t == "a":
        return 1
    if t in _NUM_ONES:
        return _NUM_ONES[t]
    if t in _NUM_TENS:
        return _NUM_TENS[t]
    return None


def _parse_scaled(words):
    """Single value for runs containing hundred/thousand/million/billion."""
    toks = [w.lower() for w in words if w.lower() != "and"]
    if not toks or not any(w in _NUM_SCALES for w in toks):
        return None
    total, current = 0, 0
    for w in toks:
        if w in _NUM_SCALES:
            s = _NUM_SCALES[w]
            if s == 100:
                current = (current or 1) * 100
            else:
                total += (current or 1) * s
                current = 0
        else:
            v = _tok_val(w)
            if v is None:
                return None
            current += v
    return total + current


def _parse_plain(words):
    """Greedy tens+ones chunks for runs without scales. Returns a list of
    (original words, value): 'twenty twenty four' -> 20, 24."""
    chunks, cur_words, cur = [], [], 0
    has_tens, has_ones, started = False, False, False
    for orig in words:
        w = orig.lower()
        v = _tok_val(w)
        if v is None:
            return None
        is_tens = w in _NUM_TENS
        if not started:
            cur, cur_words = v, [orig]
            has_tens, has_ones = is_tens, not is_tens
            started = True
        elif is_tens:
            chunks.append((cur_words, cur))
            cur, cur_words = v, [orig]
            has_tens, has_ones = True, False
        elif has_tens and not has_ones and 1 <= v <= 9:
            cur += v
            has_ones = True
            cur_words.append(orig)
        else:
            chunks.append((cur_words, cur))
            cur, cur_words = v, [orig]
            has_tens, has_ones = False, True
    chunks.append((cur_words, cur))
    return chunks


def _year(chunks):
    """'nineteen ninety nine' / 'twenty twenty six' chunk pairs -> 1999 /
    2026, else None. Only 17xx-20xx, so times like 'twelve thirty' stay."""
    if len(chunks) != 2:
        return None
    (w0, hi), (_w1, lo) = chunks
    if len(w0) == 1 and 17 <= hi <= 20 and 10 <= lo <= 99:
        return hi * 100 + lo
    return None


def numbers_to_digits(text, all_digits=False):
    """'four thousand eight hundred and twenty one' -> '4821'. By default
    only values over ten become digits (zero..ten stay words); with
    all_digits every number does — except a lone 'a', which stays an
    article. 'one hundred fifty million' -> '150 million'; a scale word
    with no number words ('150 million') is left alone."""

    def is_lone_a(words):
        return len(words) == 1 and words[0].lower() == "a"

    def value_of(words):
        if any(w.lower() in _NUM_SCALES for w in words):
            return _parse_scaled(words)
        chunks = _parse_plain([w for w in words if w.lower() != "and"])
        return chunks[0][1] if chunks and len(chunks) == 1 else None

    def repl(m):
        span = m.group(0)
        # peel a bare leading/trailing 'and' (it's a connector, not a number)
        pre, post, core = "", "", span
        lm = re.match(r"(?i)^\s*and\s+", core)
        if lm:
            pre, core = lm.group(0), core[lm.end():]
        tm = re.search(r"(?i)\s+and\s*$", core)
        if tm:
            post, core = tm.group(0), core[:tm.start()]
        if not core.strip():
            return span
        if re.search(r"hundred|thousand|million|billion", core,
                     re.IGNORECASE):
            words = [w for w in re.split(r"[\s-]+", core) if w]
            low = [w.lower() for w in words]
            if not any(_tok_val(w) is not None for w in low):
                return span  # bare scale word, e.g. after digits
            if low[-1] in ("million", "billion") and not any(
                    w in ("million", "billion") for w in low[:-1]):
                head = words[:-1]
                if is_lone_a([w for w in head if w.lower() != "and"]):
                    return span  # "a million"
                mult = value_of(head)
                if mult is None:
                    return span
                return pre + f"{mult} {words[-1]}" + post
            v = _parse_scaled(words)
            if v is None:
                return span
            if v > 10 or (all_digits and not is_lone_a(words)):
                return pre + str(v) + post
            return span
        # no scales: split on 'and' and keep the separators as-is
        parts = re.split(r"(\s+and\s+)", core, flags=re.IGNORECASE)
        out = []
        for i, p in enumerate(parts):
            if i % 2 == 1:
                out.append(p)
                continue
            words = [w for w in re.split(r"[\s-]+", p) if w]
            if not words:
                out.append(p)
                continue
            chunks = _parse_plain(words)
            if chunks is None:
                return span
            year = _year(chunks)
            if year is not None:
                out.append(str(year))
                continue
            out.append(" ".join(
                str(v) if (v > 10 or (all_digits and not is_lone_a(ws)))
                else " ".join(ws)
                for ws, v in chunks))
        return pre + "".join(out) + post

    return _NUM_RUN_RE.sub(repl, text)


_DIGIT_WORDS = {"zero": "0", "one": "1", "two": "2", "three": "3",
                "four": "4", "five": "5", "six": "6", "seven": "7",
                "eight": "8", "nine": "9"}
_PN_DIGIT = r"(?:(?i:%s)|\d+)" % "|".join(_DIGIT_WORDS)
_PN_GROUP = r"%s(?:[\s-]+%s)*" % (_PN_DIGIT, _PN_DIGIT)
_PN_CAPS = r"[A-Z]{2,5}"
# "seven four HCT two seven three", "74 HCT 273", "NE five five five"
_PART_RE = re.compile(
    r"(?<![\w-])(?:(?P<lead>%s)\s+(?P<mid>%s)(?:\s+(?P<trail>%s))?"
    r"|(?P<pre>%s)\s+(?P<num>%s))(?![\w-])"
    % (_PN_GROUP, _PN_CAPS, _PN_GROUP, _PN_CAPS, _PN_GROUP))


def _pn_digits(group):
    """'seven four' / '74' / 'two 73' -> ('74', spoken words?): any said as
    words, or 'all' when every one was."""
    toks = [t for t in re.split(r"[\s-]+", group) if t]
    out = [_DIGIT_WORDS.get(t.lower(), t) for t in toks]
    said = [t.lower() in _DIGIT_WORDS for t in toks]
    return "".join(out), "all" if all(said) else any(said)


def part_numbers(text):
    """Join spoken chip and part numbers: 'seven four HCT two seven three'
    -> '74HCT273', 'NE five five five' -> 'NE555'. Needs capital letters
    (2-5, as the model writes acronyms) and, so ordinary counts stay
    apart ('two USB cables', 'USB 3'), two or more digits before them, or
    three or more after them with at least one said as a word."""

    def repl(m):
        span = m.group(0)
        if m.group("pre"):
            num, spoken = _pn_digits(m.group("num"))
            if len(num) < 3 or not spoken:
                return span
            return m.group("pre") + num
        lead, lead_spoken = _pn_digits(m.group("lead"))
        if len(lead) < 2:
            return span
        trail = m.group("trail")
        if not trail:
            # '74 HCT' alone may just be a count, and 'two 30 PM' a time
            # ('two thirty PM' after numbers_to_digits); 'seven four HCT'
            # is neither
            return lead + m.group("mid") if lead_spoken == "all" else span
        return lead + m.group("mid") + _pn_digits(trail)[0]

    return _PART_RE.sub(repl, text)


def transcribe(wav_path, engine, partial=False):
    if engine == "whisper":
        return clean_text(transcribe_whisper(wav_path, partial))
    return clean_text(transcribe_parakeet(wav_path, partial))


def transcribe_words(wav_path):
    """A live Parakeet pass as [(word, confidence, end second), ...], or
    None if the server is too old to say (one from before 0.9)."""
    text, words = transcribe_parakeet(wav_path, True, words=True)
    if words is None:
        return None
    if not clean_text(text):
        return []
    return [(str(w), float(p), float(end)) for w, p, end in words]


# Parakeet's tokenizer glues a leading apostrophe onto what comes before
# it: right for "don't", wrong for "want,'cause". After , ; : ! ? an
# apostrophe then a letter or digit starts a clipped word ('cause, 'em,
# 'til, '90s), so it gets its space back. After a period only when a
# capital follows, so "U.S.'s" stays as it is.
APOS_GLUE_RE = re.compile(r"(?:(?<=[,;:!?])|(?<=\.)(?=['\u2019][A-Z]))"
                          r"(?=['\u2019][^\W_])")


def space_clipped_words(text):
    """'want,'cause' -> 'want, 'cause'."""
    return APOS_GLUE_RE.sub(" ", text)


def tidy(text):
    """The local cleanup filters from Settings, then your dictionary."""
    text = space_clipped_words(text)
    text = re.sub(r"(?<=[.!?]),(?=\s)", "", text)  # "name.," -> "name."
    text = tidy_disfluency(text)
    text = tidy_false_starts(text)
    do_defill, do_numbers, do_all, _do_llm_tidy = text_filters()
    if do_defill:
        text = defiller(text)
    if do_numbers:
        text = part_numbers(text)
        text = numbers_to_digits(text, all_digits=do_all)
        text = part_numbers(text)  # 'seventy four HCT' is '74 HCT' by now
    return tidy_disfluency_model(apply_dictionary(text))


INSERTION_MODES = ("paste", "type", "clipboard")


def insertion_mode():
    """paste (default), type (keys through the active layout), or
    clipboard (copy only, you paste yourself)."""
    try:
        with open(INSERTION_FILE) as f:
            m = json.load(f).get("mode", "paste")
        return m if m in INSERTION_MODES else "paste"
    except (OSError, ValueError):
        return "paste"


# ---------------- layout-aware typing ----------------
# ydotool only sends physical keycodes, and the compositor maps those
# through the active layout (`ydotool type` assumes QWERTY, so under
# Colemak "hello" comes out "hkuuy"). So build char -> keycode from the
# layout KWin is using right now, via libxkbcommon.

KXKBRC = os.path.expanduser("~/.config/kxkbrc")
KEY_ENTER, KEY_LEFTSHIFT = 28, 42
TYPE_DELAY_MS = 4      # between key events; ydotool's default is 12
_keymaps = {}          # (layout, variant, options) -> {char: (code, shift)}


class _RuleNames(ctypes.Structure):
    _fields_ = [(n, ctypes.c_char_p)
                for n in ("rules", "model", "layout", "variant", "options")]


def active_layout():
    """(layout, variant, options) of the layout typing goes through now:
    Plasma's layout list plus its current index, else XKB_DEFAULT_*."""
    layout = os.environ.get("XKB_DEFAULT_LAYOUT", "us")
    variant = os.environ.get("XKB_DEFAULT_VARIANT", "")
    options = os.environ.get("XKB_DEFAULT_OPTIONS", "")
    cp = configparser.ConfigParser(interpolation=None, strict=False)
    try:
        cp.read(KXKBRC)
        sec = cp["Layout"]
    except (configparser.Error, KeyError):
        return layout, variant, options
    if sec.get("Use", "false").lower() != "true":
        return layout, variant, options
    layouts = sec.get("LayoutList", "").split(",")
    variants = sec.get("VariantList", "").split(",")
    idx = 0
    try:
        out = subprocess.run(
            ["gdbus", "call", "--session", "-d", "org.kde.keyboard",
             "-o", "/Layouts", "-m", "org.kde.KeyboardLayouts.getLayout"],
            capture_output=True, text=True, timeout=2).stdout
        m = re.search(r"uint32 (\d+)", out)  # reply: (uint32 N,)
        idx = int(m.group(1)) if m else 0
    except Exception as e:
        log("layout index unknown, using the first:", e)
    if not layouts[0]:
        return layout, variant, options
    idx = idx if idx < len(layouts) else 0
    return (layouts[idx], variants[idx] if idx < len(variants) else "",
            sec.get("Options", ""))


def keymap_table(layout, variant, options):
    """{char: (evdev keycode, needs shift)} for one XKB layout."""
    key = (layout, variant, options)
    if key in _keymaps:
        return _keymaps[key]
    x = ctypes.CDLL("libxkbcommon.so.0")
    vp, u32 = ctypes.c_void_p, ctypes.c_uint32
    x.xkb_context_new.restype = vp
    x.xkb_context_new.argtypes = [ctypes.c_int]
    x.xkb_keymap_new_from_names.restype = vp
    x.xkb_keymap_new_from_names.argtypes = [
        vp, ctypes.POINTER(_RuleNames), ctypes.c_int]
    for f in ("xkb_keymap_min_keycode", "xkb_keymap_max_keycode"):
        getattr(x, f).restype = u32
        getattr(x, f).argtypes = [vp]
    x.xkb_keymap_num_levels_for_key.restype = u32
    x.xkb_keymap_num_levels_for_key.argtypes = [vp, u32, u32]
    x.xkb_keymap_key_get_syms_by_level.restype = ctypes.c_int
    x.xkb_keymap_key_get_syms_by_level.argtypes = [
        vp, u32, u32, u32, ctypes.POINTER(ctypes.POINTER(u32))]
    x.xkb_keymap_key_get_mods_for_level.restype = ctypes.c_size_t
    x.xkb_keymap_key_get_mods_for_level.argtypes = [
        vp, u32, u32, u32, ctypes.POINTER(u32), ctypes.c_size_t]
    x.xkb_keymap_mod_get_index.restype = u32
    x.xkb_keymap_mod_get_index.argtypes = [vp, ctypes.c_char_p]
    x.xkb_keysym_to_utf32.restype = u32
    x.xkb_keysym_to_utf32.argtypes = [u32]
    x.xkb_keymap_unref.argtypes = [vp]
    x.xkb_context_unref.argtypes = [vp]

    ctx = x.xkb_context_new(0)
    names = _RuleNames(None, None, layout.encode(), variant.encode(),
                       options.encode())
    km = x.xkb_keymap_new_from_names(ctx, ctypes.byref(names), 0)
    if not km:
        x.xkb_context_unref(ctx)
        raise RuntimeError(f"no XKB keymap for {layout}({variant})")
    shift = 1 << x.xkb_keymap_mod_get_index(km, b"Shift")
    table = {}
    masks = (u32 * 8)()
    syms = ctypes.POINTER(u32)()
    for kc in range(x.xkb_keymap_min_keycode(km),
                    x.xkb_keymap_max_keycode(km) + 1):
        for level in range(x.xkb_keymap_num_levels_for_key(km, kc, 0)):
            if x.xkb_keymap_key_get_syms_by_level(
                    km, kc, 0, level, ctypes.byref(syms)) != 1:
                continue
            sym = syms[0]
            if 0xff80 <= sym <= 0xffbd:  # keypad: odd in terminals, vim
                continue
            cp_ = x.xkb_keysym_to_utf32(sym)
            if cp_ < 32 or cp_ == 127:
                continue
            n = x.xkb_keymap_key_get_mods_for_level(km, kc, 0, level,
                                                    masks, 8)
            ms = set(masks[:n])
            if 0 in ms:
                needs = False
            elif shift in ms:
                needs = True
            else:
                continue  # AltGr and friends: paste those instead
            ch = chr(cp_)
            old = table.get(ch)
            if old is None or (old[1] and not needs):
                table[ch] = (kc - 8, needs)  # XKB keycodes are evdev + 8
    x.xkb_keymap_unref(km)
    x.xkb_context_unref(ctx)
    log(f"keymap {layout}({variant or 'default'}): {len(table)} characters")
    _keymaps[key] = table
    return table


def current_keymap():
    try:
        return keymap_table(*active_layout())
    except Exception as e:
        log("keymap failed, assuming US QWERTY:", e)
        try:
            return keymap_table("us", "", "")
        except Exception:
            return {}


def key_events(text, table):
    """Split text into runs: ("keys", [ydotool events]) for what the
    layout can type, ("paste", str) for the rest (é, —, emoji)."""
    runs = []
    for ch in text:
        if ch == "\n":
            ev = [f"{KEY_ENTER}:1", f"{KEY_ENTER}:0"]
        elif ch in table:
            code, sh = table[ch]
            ev = [f"{code}:1", f"{code}:0"]
            if sh:
                ev = [f"{KEY_LEFTSHIFT}:1", *ev, f"{KEY_LEFTSHIFT}:0"]
        else:
            if runs and runs[-1][0] == "paste":
                runs[-1] = ("paste", runs[-1][1] + ch)
            else:
                runs.append(("paste", ch))
            continue
        if runs and runs[-1][0] == "keys":
            runs[-1][1].extend(ev)
        else:
            runs.append(("keys", ev))
    return runs


def ydotool_keys(events):
    if not events:
        return True
    try:
        r = subprocess.run(["ydotool", "key", "-d", str(TYPE_DELAY_MS),
                            *events], capture_output=True, text=True,
                           timeout=30 + len(events) * TYPE_DELAY_MS / 1000)
        if r.returncode == 0:
            return True
        log("ydotool key failed:", (r.stderr or "").strip()[:200])
    except Exception as e:
        log("ydotool key error:", e)
    notify_stt("Typing failed", "Is squelch-ydotoold running?",
               urgency="normal")
    return False


def type_text(text, table=None):
    """Type text through the active layout; characters it has no key for
    are pasted. False if typing failed."""
    table = current_keymap() if table is None else table
    for kind, val in key_events(text, table):
        if kind == "keys":
            if not ydotool_keys(val):
                return False
        else:
            paste_text(val)
    return True


def type_ydotool(text):
    if type_text(text):
        log("typed:", text[:80])
        return True
    return False


def clipboard_only(text):
    fix_wayland_env()
    try:
        subprocess.run(["wl-copy"], input=text.encode("utf-8"),
                       stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=10, check=True)
        log("copied to clipboard:", text[:80])
        notify_stt("Copied", (text[:120] + "…") if len(text) > 120 else text)
    except Exception as e:
        log("clipboard copy failed:", e)
        notify_stt("Copy failed", str(e)[:120], urgency="normal")


def output_text(text):
    """Put text in; True if it went into the focused window."""
    mode = insertion_mode()
    LAST_APP["class"] = None
    if mode == "type":
        return type_ydotool(text)
    if mode == "clipboard":
        clipboard_only(text)
        return False
    return paste_text(text)


LAST_APP = {"class": None}  # the window the last paste went to


def primary_selection():
    """The text selected last (Wayland's primary selection): "" if none,
    None if it can't be read."""
