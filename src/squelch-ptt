TURBO_MIN_SECONDS = 7.0


def current_engine(seconds=None):
    """Auto (Turbo for longer ramblers), or an explicit engine override."""
    try:
        with open(ENGINE_FILE) as f:
            e = f.read().strip().lower()
        if e in ("whisper", "parakeet"):
            return e
    except OSError:
        pass
    return "whisper" if seconds is not None and seconds >= TURBO_MIN_SECONDS else "parakeet"


def text_filters():
    """Which post-processing steps are enabled (toggled in Settings)."""
    try:
        with open(FILTERS_FILE) as f:
            d = json.load(f)
        return (bool(d.get("defiller", True)), bool(d.get("numbers", True)),
                bool(d.get("numbers_all", False)), bool(d.get("tidy", False)))
    except (OSError, ValueError):
        return True, True, False, False


_dict_cache = {"mtime": 0, "terms": [], "subs": []}


def load_dictionary():
    """Your words: returns (terms for whisper prompt, [(regex, term)] fixes).
    Cached by file mtime; missing/invalid file -> empty."""
    try:
        mt = os.path.getmtime(DICT_FILE)
    except OSError:
        return [], []
    if mt == _dict_cache["mtime"]:
        return _dict_cache["terms"], _dict_cache["subs"]
    terms, subs = [], []
    try:
        with open(DICT_FILE) as f:
            entries = json.load(f).get("entries", [])
        for e in entries:
            term = str(e.get("term", "")).strip()
            if not term:
                continue
            terms.append(term)
            for m in e.get("also_match", []) or []:
                m = str(m).strip()
                if not m:
                    continue
                pat = re.escape(m)
                if m[0].isalnum():
                    pat = r"\b" + pat
                if m[-1].isalnum():
                    pat = pat + r"\b"
                subs.append((re.compile(pat, re.IGNORECASE), term))
    except (OSError, ValueError, AttributeError) as ex:
        log("dictionary load failed:", ex)
        return [], []
    _dict_cache.update(mtime=mt, terms=terms, subs=subs)
    return terms, subs


def apply_dictionary(text):
    terms, subs = load_dictionary()
    for rx, term in subs:
        text = rx.sub(term, text)
    return text


def post_wav(url, wav_path, response_format, extra=None, headers=None):
    data = open(wav_path, "rb").read()
    bound = "----sttpttboundary"
    body = (
        f"--{bound}\r\nContent-Disposition: form-data; name=\"file\"; "
        f"filename=\"utt.wav\"\r\nContent-Type: audio/wav\r\n\r\n"
    ).encode() + data + (
        f"\r\n--{bound}\r\nContent-Disposition: form-data; "
        f"name=\"response_format\"\r\n\r\n{response_format}\r\n"
    ).encode()
    for k, v in (extra or {}).items():
        body += (
            f"--{bound}\r\nContent-Disposition: form-data; "
            f"name=\"{k}\"\r\n\r\n{v}\r\n"
        ).encode()
    body += f"--{bound}--\r\n".encode()
    req = urllib.request.Request(
        url, data=body,
        headers={"Content-Type": f"multipart/form-data; boundary={bound}",
                 **(headers or {})})
    with urllib.request.urlopen(req, timeout=120) as r:
        return json.loads(r.read().decode())


def transcribe_parakeet(wav_path, partial=False, words=False):
    # partial: the server neither logs it nor frees VRAM after it (the
    # final pass of the same hold comes soon and needs the same buffers)
    res = post_wav(PARAKEET_URL, wav_path, "json",
                   headers={"X-Squelch-Partial": "1"} if partial else None)
    text = res.get("text", "").strip()
    if words:  # [[word, confidence, end second], ...]
        return text, res.get("words")
    return text


def transcribe_whisper(wav_path, partial=False):
    terms, _subs = load_dictionary()
    seen, combo = set(), []
    for t_ in terms + read_vocab():  # your words + voice-mined vocabulary
        if t_.lower() not in seen:
            seen.add(t_.lower())
            combo.append(t_)
    prompt = ", ".join(combo)[:800]
    extra = {"prompt": prompt} if prompt else None
    res = post_wav(SERVER_URL, wav_path, "verbose_json", extra)
    segs = res.get("segments") or []
    if segs:
        probs = [float(s.get("no_speech_prob", 0.0)) for s in segs]
        nsp = sum(probs) / len(probs)
        text = "".join(s.get("text", "") for s in segs)
        if not partial:
            log(f"no_speech_prob={nsp:.2f}")
        if nsp > 0.6:
            return ""  # silence / room noise hallucination guard
    else:
        text = res.get("text", "")
    return text.strip()


def clean_text(text):
    # drop whisper silence hallucinations
    if not text or text.strip("[]()").strip().upper() in (
            "BLANK_AUDIO", "BLANK AUDIO", "SILENCE", "BLANK"):
        return ""
    if len(text) >= 2 and text[0] in "[(" and text[-1] in "])":
        return ""
    return text


# Whole words only, and not inside hyphenated words ("uh-huh", "mm-hmm").
# Plain "mm" is left alone: it's also millimetres.
FILLER_RE = re.compile(
    r"(?<![\w-])(u+h+|u+m+|e+r+|a+h+|e+h+|h+m+|m{3,})(?![\w-])",
    re.IGNORECASE)


def defiller(text):
    """Drop filler sounds (um, uh, er, ah, eh, hmm, mmm) and tidy up."""
    t = FILLER_RE.sub("", text)
    t = re.sub(r"([,.!?;:])(\s*\1)+", r"\1", t)  # collapse doubled punctuation
    t = re.sub(r"\s+([,.!?;:])", r"\1", t)  # no space before punctuation
    t = re.sub(r"\s{2,}", " ", t)
    return t.strip(" ,;:").strip()


# Exact repeats are usually a stutter, but repetition can also be emphasis or
# deliberate wording. Keep the latter; the reference archive includes intentional
# repetitions such as "crazy crazy" and "never ever".
REPEAT_KEEP = {
    "very", "really", "never", "ever", "crazy", "so", "much", "many",
    "long", "big", "good", "bad", "different", "that", "had", "did",
    "right", "wrong", "same", "just", "only", "always", "sometimes",
    "often", "literally", "basically", "totally", "completely",
    "absolutely", "definitely",
}
REPEAT_RE = re.compile(r"(?<![\w-])([^\W_]+)(\s+)\1(?![\w-])", re.IGNORECASE)
PARTIAL_REPEAT_RE = re.compile(
    r"(?<![\w-])(?P<part>[^\W_]{3,})\s+(?P<whole>(?P=part)[^\W_]+)(?![\w-])",
    re.IGNORECASE)
SELF_CORRECT_RE = re.compile(r"(?<![\w-])[^\W_]+,\s*(?:no|sorry)(?![\w-]),\s*([^\W_]+)",
                             re.IGNORECASE)


def tidy_disfluency(text):
    """Only certain stutters and explicit one-word self-corrections."""
    def dedupe(match):
        word = match.group(1)
        return match.group(0) if word.lower() in REPEAT_KEEP else word
    text = REPEAT_RE.sub(dedupe, text)

    def partial(match):
        part = match.group("part")
        common = STOPWORDS | REPEAT_KEEP | {
            "a", "an", "and", "as", "at", "but", "by", "for", "from",
            "if", "in", "into", "it", "its", "of", "on", "or", "our",
            "that", "the", "their", "then", "there", "these", "this",
            "those", "to", "we", "what", "when", "where", "which", "who",
            "why", "with", "without", "you", "your", "no", "not",
            "can", "may", "might", "must", "shall",
        }
        if part.lower() in common:
            return match.group(0)
        return match.group("whole")
    text = PARTIAL_REPEAT_RE.sub(partial, text)
    # "Tuesday, no, Wednesday" and "copper, sorry, iron" keep the correction.
    return SELF_CORRECT_RE.sub(r"\1", text)


