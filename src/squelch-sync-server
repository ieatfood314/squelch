#!/usr/bin/env python3
"""Squelch sync hub: one copy of the dictionary and everyone's analytics.

Every device (desktop squelch-sync, the Android app) POSTs /v1/sync with
its dictionary, the dictionary as it was at its last sync, and its new
analytics events. The hub merges the dictionary three ways, so a word
added on one device and another word removed on a second both survive,
stores the events, and answers with the merged dictionary and the other
devices' events the caller hasn't got yet.

Phones also send their dictations' audio and what was edited afterwards
(POST /v1/archive, /v1/corrections), which go into the training archive
named in ~/.config/squelch/archive (or --archive), like a desktop's.

No auth: run it where only your own devices can reach it (behind
Tailscale). Usage: squelch-sync-server [--port 4615] [--data DIR]
[--archive DIR]
"""
import argparse
import base64
import difflib
import json
import os
import re
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

lock = threading.Lock()
DATA = ""
ARCHIVE = None           # training archive directory, if any
archive_lock = threading.Lock()
seen_corrections = None  # ids already in corrections.jsonl
dictionary = []          # [{"term", "also_match"}]
devices = {}             # id -> {"name": str, "events": [..], "last": ts}
MAX_BODY = 32 << 20


def atomic_write(path, text):
    tmp = f"{path}.tmp-{os.getpid()}"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def safe_id(s):
    s = re.sub(r"[^A-Za-z0-9._-]", "-", str(s or ""))[:64].strip(".-")
    return s or None


# ---------------- dictionary ----------------

def norm(entries):
    """term.lower() -> [term, [mishearings]], in order, duplicates folded
    (matching is case-insensitive, so case-only twins are one entry)."""
    out = {}
    for e in entries if isinstance(entries, list) else []:
        if not isinstance(e, dict):
            continue
        term = str(e.get("term", "")).strip()
        if not term:
            continue
        ms = out.setdefault(term.lower(), [term, []])[1]
        seen = {m.lower() for m in ms}
        for m in e.get("also_match") or []:
            m = str(m).strip()
            if m and m.lower() not in seen:
                ms.append(m)
                seen.add(m.lower())
    return out


def union(into, extra):
    seen = {m.lower() for m in into}
    for m in extra:
        if m.lower() not in seen:
            into.append(m)
            seen.add(m.lower())


def merge(server, base, mine):
    """Apply what changed between base and mine to server."""
    S, B, M = norm(server), norm(base), norm(mine)
    for k in B.keys() - M.keys():
        S.pop(k, None)
    for k, (term, ms) in M.items():
        b = B.get(k)
        if b is None:                      # new here (or a first sync)
            if k in S:
                union(S[k][1], ms)
            else:
                S[k] = [term, list(ms)]
            continue
        bterm, bms = b
        had = {m.lower() for m in bms}
        now = {m.lower() for m in ms}
        added = [m for m in ms if m.lower() not in had]
        removed = had - now
        if k not in S:
            # removed elsewhere; an edit here since then brings it back
            if added or removed or term != bterm:
                S[k] = [term, list(ms)]
            continue
        s = S[k]
        if term != bterm:
            s[0] = term
        s[1] = [m for m in s[1] if m.lower() not in removed]
        union(s[1], added)
    return [{"term": t, "also_match": ms} for t, ms in S.values()]


# ---------------- storage ----------------

def load():
    global dictionary
    os.makedirs(os.path.join(DATA, "stats"), exist_ok=True)
    try:
        with open(os.path.join(DATA, "dictionary.json")) as f:
            dictionary = json.load(f).get("entries", [])
    except (OSError, ValueError, AttributeError):
        dictionary = []
    try:
        with open(os.path.join(DATA, "devices.json")) as f:
            names = json.load(f)
    except (OSError, ValueError):
        names = {}
    for fn in os.listdir(os.path.join(DATA, "stats")):
        if not fn.endswith(".jsonl"):
            continue
        dev = fn[:-6]
        events = []
        with open(os.path.join(DATA, "stats", fn)) as f:
            for line in f:
                try:
                    events.append(json.loads(line))
                except ValueError:
                    pass
        events.sort(key=lambda e: e.get("ts", 0))
        devices[dev] = {"name": names.get(dev, dev), "events": events,
                        "last": events[-1]["ts"] if events else 0}


def save_names():
    atomic_write(os.path.join(DATA, "devices.json"),
                 json.dumps({d: v["name"] for d, v in devices.items()},
                            indent=2))


def add_events(dev, name, events):
    new = dev not in devices
    d = devices.setdefault(dev, {"name": name or dev, "events": [], "last": 0})
    if new or (name and name != d["name"]):
        d["name"] = name or d["name"]
        save_names()
    fresh = []
    for e in events if isinstance(events, list) else []:
        if isinstance(e, dict) and isinstance(e.get("ts"), (int, float)) \
                and e["ts"] > d["last"]:
            fresh.append(e)
    fresh.sort(key=lambda e: e["ts"])
    if fresh:
        with open(os.path.join(DATA, "stats", dev + ".jsonl"), "a") as f:
            for e in fresh:
                f.write(json.dumps(e) + "\n")
        d["events"].extend(fresh)
        d["last"] = fresh[-1]["ts"]
    return d["last"]


def sync(req):
    global dictionary
    dev = safe_id(req.get("device"))
    if not dev:
        raise ValueError("device missing")
    name = str(req["name"])[:80] if req.get("name") else None
    out = {}
    with lock:
        dic = req.get("dictionary")
        if isinstance(dic, dict) and isinstance(dic.get("mine"), list):
            merged = merge(dictionary, dic.get("base") or [], dic["mine"])
            if merged != dictionary:
                dictionary = merged
                atomic_write(os.path.join(DATA, "dictionary.json"),
                             json.dumps({"entries": dictionary}, indent=2,
                                        ensure_ascii=False))
            out["dictionary"] = dictionary
        st = req.get("stats")
        if isinstance(st, dict):
            pushed = add_events(dev, name, st.get("events") or [])
            have = st.get("have") if isinstance(st.get("have"), dict) else {}
            others = {}
            for d, v in devices.items():
                if d == dev:
                    continue
                after = have.get(d, 0)
                after = after if isinstance(after, (int, float)) else 0
                others[d] = {"name": v["name"],
                             "events": [e for e in v["events"]
                                        if e["ts"] > after]}
            out["stats"] = {"pushed": pushed, "devices": others}
    return out


# ---------------- training archive (phones) ----------------

# Whether an edit can teach a model. A clip's label has to be what was
# said: edits that swap a word for one that sounds like it (world → word,
# Regulath → Regolith) or only touch punctuation and capitals are fixes to
# what was heard. Adding, dropping or rewording words is you changing your
# mind, which the audio doesn't back, so that dictation isn't trained on.
# Neither is a clip whose start was cut off: it begins mid-word.

def _sk(s):
    """Rough sound key: consonants with look-alike spellings merged."""
    s = re.sub(r"[^a-z0-9]", "", s.lower())
    for a, b in (("ph", "f"), ("ck", "k"), ("c", "k"), ("q", "k"),
                 ("z", "s"), ("x", "ks")):
        s = s.replace(a, b)
    s = s[:1] + re.sub(r"[aeiouwyh]", "", s[1:])
    return re.sub(r"(.)\1+", r"\1", s)


def sounds_alike(old, new):
    a = re.sub(r"[^a-z0-9]", "", old.lower())
    b = re.sub(r"[^a-z0-9]", "", new.lower())
    if not a or not b:
        return False
    r = difflib.SequenceMatcher(None, a, b, autojunk=False).ratio()
    s = difflib.SequenceMatcher(None, _sk(old), _sk(new),
                                autojunk=False).ratio()
    return r >= 0.6 or (r >= 0.4 and s >= 0.75)


FILLERS = {"um", "umm", "uh", "uhm", "er", "erm", "ah", "hmm", "mm"}


def stray_words(words, i, j):
    """words[i:j] are fillers or repeat the words next to them."""
    gone, n = words[i:j], j - i
    return n <= 3 and (all(w in FILLERS for w in gone)
                       or words[max(0, i - n):i] == gone
                       or words[j:j + n] == gone)


def classify_edit(text, edited, cut=False):
    """{"kind": kept|format|fix|start|rewrite|deleted, "train": bool,
    "label": the words to train on or None, "fixes": [[old, new]]}."""
    if not edited.strip():
        return {"kind": "deleted", "train": False, "label": None,
                "fixes": []}
    tw, ew = text.split(), edited.split()
    bare = lambda w: re.sub(r"[^\w]", "", w.lower())
    tb, eb = [bare(w) for w in tw], [bare(w) for w in ew]
    fixes, rewrite, changed, start = [], False, 0, False
    if tb != eb:
        for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(
                None, tb, eb, autojunk=False).get_opcodes():
            if tag == "equal":
                continue
            if tag == "insert" and i1 == 0 and cut:
                start = True  # the cut-off words, put back
                continue
            changed += max(i2 - i1, j2 - j1)
            old, new = " ".join(tw[i1:i2]), " ".join(ew[j1:j2])
            if tag == "delete" and stray_words(tb, i1, i2):
                fixes.append([old, ""])  # an um, or a word heard twice
                continue
            if (tag == "replace" and max(i2 - i1, j2 - j1) <= 3
                    and sounds_alike(old, new)):
                fixes.append([old, new])
            else:
                rewrite = True
    if rewrite or changed > max(2, len(tw) // 2):
        kind = "rewrite"
    elif fixes:
        kind = "fix"
    elif start:
        kind = "start"
    else:
        kind = "kept" if text.strip() == edited.strip() else "format"
    train = kind != "rewrite" and not cut
    return {"kind": kind, "train": train,
            "label": edited.strip() if train else None, "fixes": fixes}


def archive_clip(req):
    """One phone dictation: its audio (a 16 kHz mono WAV, base64) and
    transcript, laid out like a desktop's archive."""
    if not ARCHIVE:
        raise LookupError("this hub keeps no archive")
    uid = safe_id(req.get("id"))
    ts = req.get("ts")
    if not uid or not isinstance(ts, (int, float)):
        raise ValueError("id and ts needed")
    wav = base64.b64decode(req.get("wav") or "", validate=True)
    if wav[:4] != b"RIFF":
        raise ValueError("not a WAV")
    day = time.strftime("%Y%m%d", time.localtime(ts))
    d = os.path.join(ARCHIVE, "raw", day)
    path = os.path.join(d, uid + ".raw.wav")
    with archive_lock:
        if os.path.exists(path):
            return {"ok": True, "dup": True}
        os.makedirs(d, exist_ok=True)
        with open(path + ".tmp", "wb") as f:
            f.write(wav)
        os.replace(path + ".tmp", path)
        text = str(req.get("text") or "")
        with open(os.path.join(ARCHIVE, "transcripts.jsonl"), "a") as f:
            f.write(json.dumps({
                "id": uid, "ts": ts, "engine": req.get("engine"),
                "words": len(text.split()), "audio_s": req.get("audio_s"),
                "text": text, "device": safe_id(req.get("device")),
                "cut": bool(req.get("cut"))}, ensure_ascii=False) + "\n")
    return {"ok": True}


def archive_corrections(req):
    """Edits made to phone dictations afterwards, classified like the
    desktop's (fix or rewrite) so only fixes become training labels."""
    global seen_corrections
    if not ARCHIVE:
        raise LookupError("this hub keeps no archive")
    items = req.get("items")
    if not isinstance(items, list):
        raise ValueError("items missing")
    dev = safe_id(req.get("device"))
    path = os.path.join(ARCHIVE, "corrections.jsonl")
    with archive_lock:
        if seen_corrections is None:
            seen_corrections = set()
            try:
                with open(path) as f:
                    for line in f:
                        try:
                            seen_corrections.add(json.loads(line).get("id"))
                        except (ValueError, AttributeError):
                            pass
            except OSError:
                pass
        lines = []
        for it in items:
            if not isinstance(it, dict) or not safe_id(it.get("id")):
                continue
            uid = safe_id(it["id"])
            if uid in seen_corrections:
                continue
            text = str(it.get("text") or "")
            edited = str(it.get("edited") or "")
            rec = {"ts": it.get("ts"), "id": uid, "device": dev,
                   "engine": it.get("engine"), "app": it.get("app"),
                   "how": it.get("how") or "a11y", "end": it.get("end"),
                   "text": text, "edited": edited,
                   "heard": it.get("heard"), "cut": bool(it.get("cut"))}
            if it.get("guess"):
                rec["guess"] = str(it["guess"])
            if it.get("before"):
                rec["before"] = str(it["before"])[-300:]
            rec.update(classify_edit(text, edited, rec["cut"]))
            if it.get("tidied"):
                # Nullspace's tidy pass cut repeats and false starts that are
                # still in the audio, so the text isn't what was said: keep
                # the record and its word fixes, but not as a label.
                rec.update(tidied=True, train=False, label=None)
            if rec["end"] in ("moved", "lost") and rec["kind"] != "deleted":
                # it lost track, so edits after that went unseen
                rec.update(train=False, label=None, unsure=True)
            lines.append(json.dumps(rec, ensure_ascii=False))
            seen_corrections.add(uid)
        if lines:
            os.makedirs(ARCHIVE, exist_ok=True)
            with open(path, "a") as f:
                f.write("\n".join(lines) + "\n")
    return {"ok": True, "saved": len(lines)}


class Handler(BaseHTTPRequestHandler):
    def _send(self, code, obj):
        body = json.dumps(obj, ensure_ascii=False).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path in ("/", "/v1/status"):
            with lock:
                self._send(200, {
                    "squelch-sync": 1,
                    "words": len(dictionary),
                    "devices": {d: {"name": v["name"],
                                    "events": len(v["events"]),
                                    "last": v["last"]}
                                for d, v in devices.items()}})
        else:
            self._send(404, {"error": "not found"})

    def do_POST(self):
        route = {"/v1/sync": sync, "/v1/archive": archive_clip,
                 "/v1/corrections": archive_corrections}.get(self.path)
        if route is None:
            return self._send(404, {"error": "not found"})
        try:
            n = int(self.headers.get("Content-Length") or 0)
            if n > MAX_BODY:
                return self._send(413, {"error": "too big"})
            req = json.loads(self.rfile.read(n) or b"{}")
            if not isinstance(req, dict):
                raise ValueError("expected an object")
            self._send(200, route(req))
        except LookupError as e:
            self._send(404, {"error": str(e)})
        except (ValueError, TypeError) as e:
            self._send(400, {"error": str(e)})
        except OSError as e:
            self._send(503, {"error": str(e)})

    def log_message(self, fmt, *args):
        if os.environ.get("SQUELCH_SYNC_VERBOSE"):
            sys.stderr.write("%s %s\n" % (self.address_string(), fmt % args))


def main():
    global DATA
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--host", default="127.0.0.1")
    ap.add_argument("--port", type=int, default=4615)
    ap.add_argument("--data", default=os.path.expanduser(
        "~/.local/share/squelch-sync"))
    ap.add_argument("--archive", help="training archive directory "
                    "(default: the one named in ~/.config/squelch/archive)")
    a = ap.parse_args()
    DATA = a.data
    global ARCHIVE
    ARCHIVE = a.archive
    if not ARCHIVE:
        try:
            with open(os.path.expanduser("~/.config/squelch/archive")) as f:
                ARCHIVE = os.path.expanduser(f.read().strip()) or None
        except OSError:
            pass
    load()
    srv = ThreadingHTTPServer((a.host, a.port), Handler)
    print(f"squelch-sync on {a.host}:{a.port}, data in {DATA}"
          + (f", archive in {ARCHIVE}" if ARCHIVE else ""), flush=True)
    srv.serve_forever()


if __name__ == "__main__":
    main()
