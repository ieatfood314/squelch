#!/bin/sh
# squelch-setup-models — download the on-device speech models.
# Whisper large-v3-turbo (q5_0, multilingual/French fallback) and
# Parakeet TDT 0.6B v3 (q8_0, English default). ~1.2 GB total. Resumable.
set -e
WDIR="$HOME/.local/share/whisper.cpp/models"
PDIR="$HOME/.local/share/parakeet"
mkdir -p "$WDIR" "$PDIR"
echo "-> whisper large-v3-turbo-q5_0 (~550 MB)"
curl -sL -C - -o "$WDIR/ggml-large-v3-turbo-q5_0.bin" \
  "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo-q5_0.bin"
echo "-> parakeet-tdt-0.6b-v3-q8_0 (~670 MB)"
curl -sL -C - -o "$PDIR/ggml-parakeet-tdt-0.6b-v3-q8_0.bin" \
  "https://huggingface.co/ggml-org/parakeet-GGUF/resolve/main/ggml-parakeet-tdt-0.6b-v3-q8_0.bin"
echo "done. Enable with: systemctl --user enable --now squelch-ptt squelch-tray squelch-vram"
