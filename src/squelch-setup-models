#!/usr/bin/env python3
"""squelch-setup-models — download the on-device speech models.

  squelch-setup-models           the two defaults (~1.2 GB): Parakeet
                                 Multilingual (English and 24 other European
                                 languages) and Whisper Turbo (any language)
  squelch-setup-models ID ...    specific models from the list below
  squelch-setup-models --list    show every model, * = downloaded

Resumable: each file downloads to NAME.part and is renamed only once
complete, so a failed or partial download never looks like a model.
The tray's Settings → Setup uses the same CATALOG.
"""
import hashlib
import os
import subprocess
import sys

PARAKEET_DIR = os.path.expanduser("~/.local/share/parakeet")
WHISPER_DIR = os.path.expanduser("~/.local/share/whisper.cpp/models")
_PARAKEET_URL = "https://huggingface.co/ggml-org/parakeet-GGUF/resolve/main/"
# ggml-org only converts v3. This is a community conversion of NVIDIA's v2
# for the same whisper.cpp engine, so its files are pinned in SHA256.
_PARAKEET_V2_URL = ("https://huggingface.co/JoaoZaokk/"
                    "parakeet-tdt-0.6b-v2-ggml/resolve/main/")
_WHISPER_URL = "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/"

# (id, engine, label, url, bytes, default). Parakeet v3 (Multilingual)
# knows English and 24 other European languages; v2 (English) knows only
# English but is a little more accurate at it. Smaller models are for GPUs
# with little VRAM; Whisper Large is the most accurate for other languages
# but several times slower than Turbo.
CATALOG = [
    ("parakeet", "parakeet", "Multilingual",
     _PARAKEET_URL + "ggml-parakeet-tdt-0.6b-v3-q8_0.bin", 668757119, True),
    ("parakeet-small", "parakeet", "Multilingual small",
     _PARAKEET_URL + "ggml-parakeet-tdt-0.6b-v3-q4_k.bin", 415611879, False),
    ("parakeet-en", "parakeet", "English",
     _PARAKEET_V2_URL + "ggml-parakeet-tdt-0.6b-v2-q8_0.bin", 658909748,
     False),
    ("parakeet-en-small", "parakeet", "English small",
     _PARAKEET_V2_URL + "ggml-parakeet-tdt-0.6b-v2-q5_0.bin", 427494308,
     False),
    ("whisper", "whisper", "Turbo",
     _WHISPER_URL + "ggml-large-v3-turbo-q5_0.bin", 574041195, True),
    ("whisper-small", "whisper", "Small",
     _WHISPER_URL + "ggml-small-q5_1.bin", 190085487, False),
    ("whisper-large", "whisper", "Large",
     _WHISPER_URL + "ggml-large-v3-q5_0.bin", 1081140203, False),
]
SHA256 = {
    "parakeet-en":
        "668e1daca59c7a7b0c5072624e5c4abf99b84b60cee29cf2d0c82f1c9b97baa2",
    "parakeet-en-small":
        "f2d2b6eabaf77c8c67109e365db72fc4e20d69b52d1af184f3211ec7c530ae04",
}


def model_path(entry):
    _id, engine, _label, url, _size, _default = entry
    return os.path.join(PARAKEET_DIR if engine == "parakeet"
                         else WHISPER_DIR, os.path.basename(url))


def model_url(entry):
    return entry[3]


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            h.update(block)
    return h.hexdigest()


def find(model_id):
    return next((e for e in CATALOG if e[0] == model_id), None)


def human(nbytes):
    mb = nbytes / 1048576
    return f"{mb / 1024:.1f} GB" if mb >= 1000 else f"{mb:.0f} MB"


def fetch(entry):
    dest, size = model_path(entry), entry[4]
    print(f"-> {entry[2]} {entry[1]} ({human(size)})", flush=True)
    if os.path.exists(dest) and os.path.getsize(dest) > 0:
        print("   already there", flush=True)
        return
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    subprocess.run(["curl", "-fL", "--retry", "3", "-C", "-",
                    "-o", dest + ".part", model_url(entry)], check=True)
    got = os.path.getsize(dest + ".part")
    if got < size * 0.95:  # a little slack in case the file is re-uploaded
        sys.exit(f"   only {got} bytes, expected about {size}; try again")
    want = SHA256.get(entry[0])
    if want and sha256(dest + ".part") != want:
        os.remove(dest + ".part")
        sys.exit("   checksum mismatch, file not saved")
    os.replace(dest + ".part", dest)


def main(argv):
    if argv[1:] == ["--list"]:
        for e in CATALOG:
            mark = "*" if os.path.exists(model_path(e)) else " "
            print(f"{mark} {e[0]:18} {e[1]:9} {e[2]:19} {human(e[4]):>7}")
        return 0
    if any(a.startswith("-") for a in argv[1:]):
        print(__doc__.strip())
        return 2
    wanted = argv[1:] or [e[0] for e in CATALOG if e[5]]
    entries = [find(i) for i in wanted]
    if None in entries:
        bad = [i for i, e in zip(wanted, entries) if e is None]
        print(f"unknown model: {', '.join(bad)} (see --list)",
              file=sys.stderr)
        return 2
    try:
        for e in entries:
            fetch(e)
    except subprocess.CalledProcessError as ex:
        print(f"download failed (curl exit {ex.returncode}); run again to "
              "resume", file=sys.stderr)
        return 1
    if not argv[1:]:
        print("done. Enable with: systemctl --user enable --now squelch-ptt "
              "squelch-tray squelch-vram squelch-ydotoold")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
