#!/usr/bin/env python3
"""STT VRAM supervisor: exactly one speech engine loaded at a time, and none
while a fullscreen game is on screen.

- Loads a small KWin script that prints the classes of fullscreen game
  windows (with a tag) to KWin's journal whenever that set changes, and
  follows the journal for it. Screenshot overlays (Spectacle), the lock
  screen, browsers and video players don't count as games.
- want = None while a game has been fullscreen for GAME_SETTLE_S, else the
  engine in ~/.config/squelch/engine.
- Starts/stops the parakeet-server / whisper-server user units to match.
- Writes ~/.config/squelch/state.json for the tray + daemon.
- Notifies on game start/end. Fail-safe: if KWin can't be asked, assume no
  game (models stay loaded, dictation keeps working).
"""
import json
import os
import subprocess
import threading
import time

ENGINE_FILE = os.path.expanduser("~/.config/squelch/engine")
STATE_FILE = os.path.expanduser("~/.config/squelch/state.json")
ENGINES_ENV = os.path.expanduser("~/.config/squelch/engines.env")
SERVICES = {"parakeet": "squelch-parakeet.service",
            "whisper": "squelch-whisper.service"}
ENGINE_NAMES = {"parakeet": "Parakeet", "whisper": "Whisper"}
DEFAULT_MODELS = {
    "parakeet": os.path.expanduser(
        "~/.local/share/parakeet/ggml-parakeet-tdt-0.6b-v3-q8_0.bin"),
    "whisper": os.path.expanduser(
        "~/.local/share/whisper.cpp/models/ggml-large-v3-turbo-q5_0.bin"),
}
POLL_S = 5
# A game must stay fullscreen (or stay gone) this long before models move,
# so brief fullscreen moments don't bounce gigabytes in and out of VRAM.
GAME_SETTLE_S = 10
QDBUS = ["/usr/bin/qdbus6", "--session", "org.kde.KWin"]
SCRIPT_NAME = "squelch-fullscreen"
TAG = f"squelch-fullscreen-{os.getpid()}"
# Fullscreen windows that aren't games (lowercase resourceClass substrings).
NOT_GAMES = ["spectacle", "kscreenlocker", "ksmserver", "krunner",
             "plasmashell", "ksplash", "zen", "firefox", "librewolf",
             "floorp", "chromium", "chrome", "brave", "vivaldi", "opera",
             "crx_", "mpv", "vlc", "celluloid", "haruna", "smplayer",
             "totem", "showtime"]
KWIN_SCRIPT = """\
var TAG = %(tag)s;
var NOT_GAMES = %(not_games)s;
var last = null;
function isGame(w, gone) {
    if (w === gone || !w.fullScreen || w.minimized || !w.normalWindow)
        return false;
    var c = String(w.resourceClass).toLowerCase();
    for (var i = 0; i < NOT_GAMES.length; i++)
        if (c.indexOf(NOT_GAMES[i]) >= 0)
            return false;
    return true;
}
function report(gone) {
    var apps = [];
    var ws = workspace.windowList();
    for (var i = 0; i < ws.length; i++)
        if (isGame(ws[i], gone))
            apps.push(String(ws[i].resourceClass) || "unknown");
    var s = apps.sort().join(" ");
    if (s !== last) {
        last = s;
        print(TAG + " [" + s + "]");
    }
}
function watch(w) {
    w.fullScreenChanged.connect(function () { report(); });
    w.minimizedChanged.connect(function () { report(); });
}
workspace.windowList().forEach(watch);
workspace.windowAdded.connect(function (w) { watch(w); report(); });
workspace.windowRemoved.connect(function (w) { report(w); });
report();
"""


def log(*a):
    print("[squelch-vram]", *a, flush=True)


def notify(summary, body=""):
    try:
        subprocess.run(["notify-send", "-a", "Squelch", "-u", "low",
                        summary, body],
                       timeout=5, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL)
    except Exception:
        pass


def current_engine():
    try:
        with open(ENGINE_FILE) as f:
            e = f.read().strip().lower()
        return "whisper" if e == "whisper" else "parakeet"
    except OSError:
        return "parakeet"


# ---------------- fullscreen game detection ----------------

class GameWatch:
    """Fullscreen game windows, as reported by our KWin script."""

    def __init__(self):
        self.lock = threading.Lock()
        self.apps = []
        self.changed = time.monotonic()  # when "any game" last flipped
        self.reported = False  # heard from the script since it was loaded
        self.loaded_at = 0.0
        runtime = os.environ.get("XDG_RUNTIME_DIR",
                                 f"/run/user/{os.getuid()}")
        self.script_path = os.path.join(runtime, SCRIPT_NAME + ".js")
        self.following = threading.Event()
        threading.Thread(target=self._follow, daemon=True).start()
        self.following.wait(5)

    def _follow(self):
        while True:
            try:
                p = subprocess.Popen(
                    ["journalctl", "--user", "-f", "-n", "0",
                     "_COMM=kwin_wayland", "-o", "cat"],
                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                    text=True)
                time.sleep(0.5)  # let journalctl reach the journal's end
                self.following.set()
                for line in p.stdout:
                    if line.startswith(TAG + " "):
                        rest = line[len(TAG):].strip().strip("[]")
                        self._update(rest.split())
                log("journal follower exited, restarting")
            except Exception as e:
                log("journal follower failed:", e)
            time.sleep(5)

    def _update(self, apps):
        with self.lock:
            if bool(apps) != bool(self.apps):
                self.changed = time.monotonic()
            self.apps = apps
            self.reported = True

    def _qdbus(self, *args):
        r = subprocess.run(QDBUS + list(args), capture_output=True,
                           text=True, timeout=5)
        return r.stdout.strip() if r.returncode == 0 else None

    def ensure_script(self):
        """(Re)load the KWin script if KWin restarted or it never spoke."""
        try:
            loaded = self._qdbus("/Scripting",
                                 "org.kde.kwin.Scripting.isScriptLoaded",
                                 SCRIPT_NAME) == "true"
            if loaded and (self.reported
                           or time.monotonic() - self.loaded_at < 15):
                return
            with open(self.script_path, "w") as f:
                f.write(KWIN_SCRIPT % {"tag": json.dumps(TAG),
                                       "not_games": json.dumps(NOT_GAMES)})
            self._qdbus("/Scripting", "org.kde.kwin.Scripting.unloadScript",
                        SCRIPT_NAME)
            # Reset before running: the script reports straight away, and
            # resetting after could wipe that first (and only) report.
            self._update([])
            with self.lock:
                self.reported = False
            self.loaded_at = time.monotonic()
            sid = self._qdbus("/Scripting",
                              "org.kde.kwin.Scripting.loadScript",
                              self.script_path, SCRIPT_NAME)
            if not sid or not sid.lstrip("-").isdigit() or int(sid) < 0:
                raise RuntimeError(f"loadScript returned {sid!r}")
            self._qdbus(f"/Scripting/Script{sid}", "org.kde.kwin.Script.run")
            log("fullscreen watcher loaded into KWin")
        except Exception as e:
            log("can't load the KWin script (assuming no game):", e)
            with self.lock:
                self.apps = []

    def snapshot(self):
        with self.lock:
            return list(self.apps), time.monotonic() - self.changed


# ---------------- engines ----------------

def is_active(svc):
    try:
        r = subprocess.run(["systemctl", "--user", "is-active", svc],
                           capture_output=True, text=True, timeout=10)
        return r.stdout.strip() == "active"
    except Exception:
        return False


def set_service(svc, want_active):
    action = "start" if want_active else "stop"
    try:
        r = subprocess.run(["systemctl", "--user", action, svc],
                           timeout=30, capture_output=True, text=True)
        if r.returncode == 0:
            return True
        log(f"failed to {action} {svc}:", r.stderr.strip()[:200])
    except Exception as e:
        log(f"failed to {action} {svc}:", e)
    return False


def engine_models():
    """Model paths from engines.env (created with defaults if missing)."""
    models = dict(DEFAULT_MODELS)
    try:
        with open(ENGINES_ENV) as f:
            for line in f:
                line = line.strip()
                if line.startswith("SQUELCH_PARAKEET_MODEL="):
                    models["parakeet"] = line.split("=", 1)[1].strip()
                elif line.startswith("SQUELCH_WHISPER_MODEL="):
                    models["whisper"] = line.split("=", 1)[1].strip()
        return models
    except OSError:
        pass
    try:
        os.makedirs(os.path.dirname(ENGINES_ENV), exist_ok=True)
        with open(ENGINES_ENV, "w") as f:
            f.write(f"SQUELCH_PARAKEET_MODEL={models['parakeet']}\n"
                    f"SQUELCH_WHISPER_MODEL={models['whisper']}\n")
    except OSError as e:
        log("engines.env write failed:", e)
    return models


def write_state(gaming, want, model_ok=True, model="", games=()):
    try:
        os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
        tmp = STATE_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump({"gaming": gaming, "games": list(games), "want": want,
                       "model_ok": model_ok, "model": model,
                       "updated": time.time()}, f)
        os.replace(tmp, STATE_FILE)
    except OSError as e:
        log("state write failed:", e)


def main():
    log("supervisor starting")
    watch = GameWatch()
    # Trust the first report as is: the settle time is for changes, and
    # waiting it out at startup would load a model into a running game.
    watch.ensure_script()
    deadline = time.monotonic() + 3
    while not watch.reported and time.monotonic() < deadline:
        time.sleep(0.1)
    gaming = bool(watch.snapshot()[0])
    if gaming:
        log("game fullscreen at startup:", ", ".join(watch.snapshot()[0]))
    known_models = engine_models()  # don't restart a running engine at boot
    while True:
        try:
            watch.ensure_script()
            apps, stable_for = watch.snapshot()
            if bool(apps) != gaming and stable_for >= GAME_SETTLE_S:
                gaming = bool(apps)
                if gaming:
                    log("game fullscreen:", ", ".join(apps))
                    notify("Squelch paused",
                           f"Models unloaded for {apps[0]}.")
                else:
                    log("game gone")
                    notify("Squelch resumed",
                           f"{ENGINE_NAMES[current_engine()]} is loading.")

            want = None if gaming else current_engine()
            models = engine_models()
            model = models.get(want, "") if want else ""
            model_ok = (not want) or bool(model) and os.path.exists(model)
            if want and not model_ok:
                want = None  # model file missing: stay unloaded, UI shows it
            for eng, svc in SERVICES.items():
                should = eng == want
                active = is_active(svc)
                if active and should and known_models.get(eng) != models[eng]:
                    log(f"{eng} model changed, restarting {svc}")
                    set_service(svc, False)
                    active = False
                if active != should and set_service(svc, should):
                    log(f"{svc} -> {'started' if should else 'stopped'}"
                        f" (gaming={gaming}, want={want})")
            known_models = models
            write_state(gaming, want, model_ok, model,
                        apps if gaming else ())
        except Exception as e:
            log("loop error:", e)
        time.sleep(POLL_S)


if __name__ == "__main__":
    main()
