#!/usr/bin/env python3
"""Resident Parakeet TDT server (Vulkan GPU) for the STT push-to-talk daemon.

Keeps ggml-parakeet-tdt-0.6b-v3 in VRAM and exposes a whisper-server-like
HTTP API on 127.0.0.1:1894:
  POST /inference  multipart (file=<wav>, response_format=json) -> {"text": ...}
  GET  /health     -> 200 ok
  GET  /limits?headroom_mb=N -> {"free_mb", "total_mb", "max_seconds"}:
                   the longest clip whose working memory fits in free VRAM
                   while leaving N MB free

Only stdlib + numpy + the already-built libparakeet/libggml shared libs.
"""
import ctypes
import json
import math
import os
import threading
import time
import wave
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

import numpy as np

BINDIR = os.environ.get("SQUELCH_WSP_BIN", "/usr/bin")
MODEL = os.environ.get("SQUELCH_PARAKEET_MODEL") or os.path.expanduser(
    "~/.local/share/parakeet/ggml-parakeet-tdt-0.6b-v3-q8_0.bin")
HOST, PORT = "127.0.0.1", 1894
N_THREADS = 6
# Working VRAM on top of the loaded model grows with the square of clip
# length (attention): measured on an RX 5700 at +71 MB for 1 min, +0.46 GB
# for 2 min, +1.6 GB for 4 min, +4.6 GB for 6 min, i.e. at most about
# 0.035 MB per second squared. Past free VRAM it spills to system RAM and
# runs about half as fast.
MB_PER_S2 = 0.036
# ggml keeps a clip's buffers until a bigger one needs more, so a long
# dictation would sit on gigabytes while idle. Reload the context after
# any clip that grew it past this, to hand the memory back.
RELEASE_MB = 256


def log(*a):
    print("[parakeet-server]", *a, flush=True)


class CtxParams(ctypes.Structure):
    _fields_ = [("use_gpu", ctypes.c_bool),
                ("gpu_device", ctypes.c_int)]


class FullParams(ctypes.Structure):
    _fields_ = [
        ("strategy", ctypes.c_int),
        ("n_threads", ctypes.c_int),
        ("offset_ms", ctypes.c_int),
        ("duration_ms", ctypes.c_int),
        ("no_context", ctypes.c_bool),
        ("audio_ctx", ctypes.c_int),
        ("new_segment_callback", ctypes.c_void_p),
        ("new_segment_callback_user_data", ctypes.c_void_p),
        ("new_token_callback", ctypes.c_void_p),
        ("new_token_callback_user_data", ctypes.c_void_p),
        ("progress_callback", ctypes.c_void_p),
        ("progress_callback_user_data", ctypes.c_void_p),
        ("encoder_begin_callback", ctypes.c_void_p),
        ("encoder_begin_callback_user_data", ctypes.c_void_p),
        ("abort_callback", ctypes.c_void_p),
        ("abort_callback_user_data", ctypes.c_void_p),
    ]


def _load(name):
    try:
        return ctypes.CDLL(name, mode=os.RTLD_GLOBAL)
    except OSError:
        return ctypes.CDLL(os.path.join(BINDIR, name), mode=os.RTLD_GLOBAL)


ggml = _load("libggml.so.0")
ggml.ggml_backend_load_all.restype = None
ggml.ggml_backend_load_all.argtypes = []
ggml.ggml_backend_load_all()
ggml.ggml_backend_dev_count.restype = ctypes.c_size_t
ggml.ggml_backend_dev_count.argtypes = []
ggml.ggml_backend_dev_get.restype = ctypes.c_void_p
ggml.ggml_backend_dev_get.argtypes = [ctypes.c_size_t]
ggml.ggml_backend_dev_type.restype = ctypes.c_int
ggml.ggml_backend_dev_type.argtypes = [ctypes.c_void_p]
ggml.ggml_backend_dev_memory.restype = None
ggml.ggml_backend_dev_memory.argtypes = [
    ctypes.c_void_p, ctypes.POINTER(ctypes.c_size_t),
    ctypes.POINTER(ctypes.c_size_t)]
GGML_BACKEND_DEVICE_TYPE_GPU = 1

lib = _load("libparakeet.so.1")
lib.parakeet_context_default_params.restype = CtxParams
lib.parakeet_context_default_params.argtypes = []
lib.parakeet_init_from_file_with_params.restype = ctypes.c_void_p
lib.parakeet_init_from_file_with_params.argtypes = [ctypes.c_char_p, CtxParams]
lib.parakeet_full_default_params.restype = FullParams
lib.parakeet_full_default_params.argtypes = [ctypes.c_int]
lib.parakeet_full.restype = ctypes.c_int
lib.parakeet_full.argtypes = [ctypes.c_void_p, FullParams,
                              ctypes.POINTER(ctypes.c_float), ctypes.c_int]
lib.parakeet_full_n_segments.restype = ctypes.c_int
lib.parakeet_full_n_segments.argtypes = [ctypes.c_void_p]
lib.parakeet_full_get_segment_text.restype = ctypes.c_char_p
lib.parakeet_full_get_segment_text.argtypes = [ctypes.c_void_p, ctypes.c_int]
lib.parakeet_free.restype = None
lib.parakeet_free.argtypes = [ctypes.c_void_p]

GPU_DEVICE = 0


def load_context():
    t0 = time.time()
    cp = lib.parakeet_context_default_params()
    cp.use_gpu = True
    cp.gpu_device = GPU_DEVICE
    ctx = lib.parakeet_init_from_file_with_params(MODEL.encode(), cp)
    if not ctx:
        raise SystemExit("failed to load parakeet model")
    log(f"model ready in {time.time()-t0:.1f}s")
    return ctx


def gpu_memory_mb():
    """(free, total) MB of the GPU we run on, as Vulkan reports it (memory
    budget: other processes' use counts), or None without a GPU."""
    gpus = 0
    for i in range(ggml.ggml_backend_dev_count()):
        dev = ggml.ggml_backend_dev_get(i)
        if ggml.ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_GPU:
            continue
        if gpus == GPU_DEVICE:
            free, total = ctypes.c_size_t(), ctypes.c_size_t()
            ggml.ggml_backend_dev_memory(dev, ctypes.byref(free),
                                         ctypes.byref(total))
            return free.value / 2**20, total.value / 2**20
        gpus += 1
    return None


def working_mb(seconds):
    return MB_PER_S2 * seconds * seconds


log("loading model:", MODEL)
CTX = load_context()
LOCK = threading.Lock()


def release_buffers():
    """Reload the context so the oversized compute buffers go away.
    Requests wait on LOCK meanwhile instead of failing."""
    global CTX
    with LOCK:
        lib.parakeet_free(CTX)
        CTX = None
        CTX = load_context()


def wav_to_float_mono(wav_bytes):
    with wave.open(__import__("io").BytesIO(wav_bytes), "rb") as w:
        nch, rate, n = w.getnchannels(), w.getframerate(), w.getnframes()
        raw = w.readframes(n)
    if rate != 16000:
        raise ValueError(f"expected 16 kHz, got {rate}")
    a = np.frombuffer(raw, dtype=np.int16).astype(np.float32) / 32768.0
    if nch > 1:
        a = a.reshape(-1, nch).mean(axis=1)
    return np.ascontiguousarray(a, dtype=np.float32)


def transcribe(pcm):
    fp = lib.parakeet_full_default_params(0)  # PARAKEET_SAMPLING_GREEDY
    fp.n_threads = N_THREADS
    arr = pcm.ctypes.data_as(ctypes.POINTER(ctypes.c_float))  # no copy
    t0 = time.time()
    with LOCK:  # not thread safe for same context
        rc = lib.parakeet_full(CTX, fp, arr, len(pcm))
        if rc != 0:
            raise RuntimeError(f"parakeet_full failed: {rc}")
        n = lib.parakeet_full_n_segments(CTX)
        texts = []
        for i in range(n):
            s = lib.parakeet_full_get_segment_text(CTX, i)
            if s:
                texts.append(s.decode("utf-8", "replace"))
    dt = time.time() - t0
    return "".join(texts), dt


class Handler(BaseHTTPRequestHandler):
    server_version = "parakeet-server/1"

    def log_message(self, *a):
        pass

    def send_json(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        url = urlparse(self.path)
        if url.path == "/health":
            body = b"ok"
            self.send_response(200)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        elif url.path == "/limits":
            mem = gpu_memory_mb()
            if mem is None:
                self.send_json(503, {"error": "no GPU"})
                return
            free, total = mem
            try:
                headroom = float(parse_qs(url.query).get(
                    "headroom_mb", ["1024"])[0])
            except ValueError:
                headroom = 1024.0
            budget = max(0.0, free - headroom)
            self.send_json(200, {
                "free_mb": round(free), "total_mb": round(total),
                "max_seconds": round(math.sqrt(budget / MB_PER_S2), 1)})
        else:
            self.send_response(404)
            self.end_headers()

    def do_POST(self):
        if self.path != "/inference":
            self.send_response(404)
            self.end_headers()
            return
        try:
            ctype = self.headers.get("Content-Type", "")
            bound = ctype.split("boundary=")[1].encode()
            length = int(self.headers.get("Content-Length", 0))
            data = self.rfile.read(length)
            # minimal multipart parse: find the wav payload (RIFF....WAVE)
            start = data.find(b"RIFF")
            end = data.rfind(b"--" + bound + b"--")
            wav = data[start:end].split(b"\r\n--" + bound)[0] if start >= 0 else None
            if not wav:
                raise ValueError("no wav payload found")
            pcm = wav_to_float_mono(wav)
            text, dt = transcribe(pcm)
            log(f"transcribed {len(pcm)/16000:.2f}s audio in {dt:.2f}s: {text[:100]!r}")
            self.send_json(200, {"text": text})
            if working_mb(len(pcm) / 16000) > RELEASE_MB:
                log("long clip, reloading to free its VRAM")
                threading.Thread(target=release_buffers, daemon=True).start()
        except Exception as e:
            log("inference error:", e)
            self.send_json(500, {"error": str(e)})


if __name__ == "__main__":
    srv = ThreadingHTTPServer((HOST, PORT), Handler)
    log(f"serving on {HOST}:{PORT}")
    srv.serve_forever()
