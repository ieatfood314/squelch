[Unit]
Description=STT engine tray applet (switch Parakeet/Whisper)
After=graphical-session.target
PartOf=graphical-session.target
# Give up after 5 crashes in a minute instead of looping (and dumping core)
# every few seconds when there's no display to connect to.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
ExecStart=/usr/bin/squelch-tray
Restart=always
RestartSec=3
# WAYLAND_DISPLAY/XDG_RUNTIME_DIR come from the imported session env
# (After=graphical-session.target); hardcoding the socket name breaks when
# the compositor creates a renumbered socket.
Environment=QT_QPA_PLATFORM=wayland

[Install]
# Not default.target: with linger the user manager starts at boot, long
# before Plasma provides a Wayland display.
WantedBy=graphical-session.target
