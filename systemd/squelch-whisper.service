[Unit]
Description=whisper.cpp server (Vulkan GPU, large-v3-turbo-q5_0, auto language)
After=pipewire.service
Wants=pipewire.service

[Service]
EnvironmentFile=%h/.config/squelch/engines.env
ExecStart=/usr/bin/whisper-server -m ${SQUELCH_WHISPER_MODEL} --host 127.0.0.1 --port 1893 --convert
Restart=always
RestartSec=3
Nice=-5

[Install]
WantedBy=default.target
