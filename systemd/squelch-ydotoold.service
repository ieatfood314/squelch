[Unit]
Description=ydotoold (uinput typing daemon for ydotool/Wayland)
# Same socket ($XDG_RUNTIME_DIR/.ydotool_socket) as ydotool's own unit.
Conflicts=ydotool.service

[Service]
# ydotoold removes a stale socket left by a crash itself.
ExecStart=/usr/bin/ydotoold
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
