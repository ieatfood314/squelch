[Unit]
Description=STT push-to-talk (trigger hold -> mic array -> GPU -> paste)
After=squelch-whisper.service pipewire.service kanata.service
Wants=squelch-whisper.service

[Service]
ExecStart=/usr/bin/squelch-ptt
Restart=always
RestartSec=2
Nice=-5
# WAYLAND_DISPLAY comes from the imported session env; squelch-ptt also
# discovers the live socket itself so paste works even when started early.
Environment=YDOTOOLD_SOCKET=/run/user/1000/.ydotool_socket

[Install]
WantedBy=default.target
