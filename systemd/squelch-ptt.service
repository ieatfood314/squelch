[Unit]
Description=STT push-to-talk (Menu hold -> PS Eye beamform -> whisper GPU -> type)
After=squelch-whisper.service pipewire.service kanata.service
Wants=squelch-whisper.service

[Service]
ExecStart=/usr/bin/squelch-ptt
Restart=always
RestartSec=2
Nice=-5
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=YDOTOOLD_SOCKET=/run/user/1000/.ydotool_socket

[Install]
WantedBy=default.target
