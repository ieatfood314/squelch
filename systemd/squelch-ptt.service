[Unit]
Description=STT push-to-talk (trigger hold -> mic -> GPU -> paste)
After=pipewire.service

[Service]
ExecStart=/usr/bin/squelch-ptt
Restart=always
RestartSec=2
Nice=-5
# WAYLAND_DISPLAY comes from the imported session env; squelch-ptt also
# discovers the live socket itself so paste works even when started early.
# The engines are started by squelch-vram, not here.

[Install]
WantedBy=default.target
